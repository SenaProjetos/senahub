// ─────────────────────────────────────────────────────────────
// Avisos gerais (comunicados com confirmação de leitura)
// ─────────────────────────────────────────────────────────────

enum AvisoAlvoTipo {
  todos
  categoria
  usuarios
}

/// Comunicado direcionado que surge como modal bloqueante para o destinatário.
/// Registro de envio; a leitura é confirmada por destinatário em AvisoDestinatario.
/// Pode ser imediato (`agendadoPara` null) ou agendado — nesse caso o alvo fica
/// guardado aqui e só vira AvisoDestinatario no disparo (quem entrou na empresa
/// nesse meio-tempo também recebe).
model Aviso {
  id               String              @id @default(cuid())
  titulo           String
  corpo            String?
  imagemPath       String? // caminho relativo no storage (avisos/<id>.<ext>); imagem opcional do comunicado
  criadoPorId      String
  criadoPor        User                @relation("AvisosCriados", fields: [criadoPorId], references: [id])
  alvoTipo         AvisoAlvoTipo
  alvoRoles        String[] // preenchido quando alvoTipo=categoria
  alvoUserIds      String[] // preenchido quando alvoTipo=usuarios
  incluirClientes  Boolean             @default(false) // vale para alvoTipo=todos
  exigeConfirmacao Boolean             @default(true)
  emailSolicitado  Boolean             @default(false) // intenção do autor (enviouEmail = resultado)
  enviouEmail      Boolean             @default(false)
  agendadoPara     DateTime? // null = envio imediato
  enviadoEm        DateTime? // momento do disparo efetivo (imediato ≈ criadoEm)
  canceladoEm      DateTime? // agendamento cancelado antes do disparo
  criadoEm         DateTime            @default(now())
  destinatarios    AvisoDestinatario[]

  @@index([criadoEm])
  @@index([agendadoPara, enviadoEm])
  @@map("aviso")
}

/// Um destinatário de um aviso: registro de entrega (modal exibido) e de
/// confirmação de leitura (lidoEm). @@unique garante 1 linha por (aviso, user).
model AvisoDestinatario {
  id         String    @id @default(cuid())
  avisoId    String
  aviso      Aviso     @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("AvisosRecebidos", fields: [userId], references: [id])
  entregueEm DateTime? // quando o modal foi exibido ao usuário
  lidoEm     DateTime? // confirmação de leitura (o registro pedido)
  criadoEm   DateTime  @default(now())

  @@unique([avisoId, userId])
  @@index([userId, lidoEm])
  @@map("aviso_destinatario")
}

// ─────────────────────────────────────────────────────────────
// Templates de e-mail (override editável pelo admin; default no código)
// ─────────────────────────────────────────────────────────────

/// Modelo (variante) de um tipo de e-mail. Vários por `slug` (categoria).
/// No envio, sorteia-se entre os `ativo:true`; 1 ativo = fixo; nenhum ativo =
/// usa o padrão do catálogo (src/lib/email-templates-meta.ts).
/// `corpoHtml` guarda o texto em **Markdown** (convertido em HTML no envio).
model EmailTemplateVariante {
  id          String   @id @default(cuid())
  slug        String
  nome        String
  assunto     String
  corpoHtml   String
  ativo       Boolean  @default(true)
  updatedById String?
  updatedAt   DateTime @updatedAt
  criadoEm    DateTime @default(now())

  @@index([slug])
  @@map("email_template_variante")
}

// ─────────────────────────────────────────────────────────────
// Configuração geral do sistema (chave/valor)
// ─────────────────────────────────────────────────────────────

model ConfigSistema {
  chave     String   @id
  valor     Json
  updatedAt DateTime @updatedAt

  @@map("config_sistema")
}

// ─────────────────────────────────────────────────────────────
// Clientes (Onda 1)
// ─────────────────────────────────────────────────────────────

enum TipoPessoa {
  PF
  PJ
}

model Cliente {
  id           String     @id @default(cuid())
  tipo         TipoPessoa @default(PJ)
  nome         String // nome (PF) ou razão social (PJ)
  nomeFantasia String?
  documento    String? // CPF ou CNPJ
  email        String?
  telefone     String?

  // Endereço
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  uf          String?

  observacoes String?
  /// Classificação livre do cliente (ex.: porte/segmento), p/ filtro e relatório.
  /// DEPRECADA pelo par `segmentoId`/`porte` (CRM F1.8) — mantida com o texto histórico,
  /// nada é reescrito. Registros novos usam os campos estruturados.
  categoria   String?
  ativo       Boolean @default(true)

  // ── CRM (F1.8) ──────────────────────────────────────────────
  /// Status comercial DERIVADO de ter proposta aceita (ADR-08). Materializado para
  /// permitir filtro/ordenação com índice — calcular em toda leitura não escala.
  /// A regra vive em `modules/comercial/status.ts` (`calcularStatusComercial`).
  status         StatusComercialCliente  @default(PROSPECT)
  /// Quando preenchido, VENCE o cálculo. É o único caminho para EX_CLIENTE e PARCEIRO,
  /// que nunca são inferidos — não há sinal no sistema que os justifique.
  statusOverride StatusComercialCliente?

  /// Sales Navigator (Fase 4). Sem scraping — só o link, colado à mão.
  linkedinUrl       String?
  salesNavigatorUrl String?

  segmentoId String?
  segmento   Segmento? @relation(fields: [segmentoId], references: [id])
  /// Porte da empresa. Texto por ora — vira catálogo se ganhar regra de negócio.
  porte      String?

  // Login externo opcional do cliente (criado sob demanda).
  usuarioId String? @unique

  // ── Fusão de duplicata (CRM F1.14) ──────────────────────────
  /// Quando preenchido, este cliente foi ABSORVIDO pelo apontado. Nada é apagado: o registro
  /// continua existindo, arquivado (`ativo: false`), com a referência ao sobrevivente — é o
  /// que permite auditar depois "para onde foi este cadastro".
  fundidoEmId  String?
  sobrevivente Cliente?  @relation("ClienteFusao", fields: [fundidoEmId], references: [id])
  absorvidos   Cliente[] @relation("ClienteFusao")
  /// Data da fusão. Nome separado de `fundidoEmId` de propósito — "fundido em" seria ambíguo
  /// entre "em qual cliente" e "em que data".
  fusaoEm      DateTime?

  /// Soft delete (ADR-11). Leituras top-level são auto-filtradas pela extensão em
  /// `lib/prisma.ts`. NÃO esconde o cliente onde ele é alcançado por relação (`include`) nem
  /// por `findUnique` — de propósito: um projeto antigo continua mostrando de quem era.
  excluidoEm DateTime?

  contatos        ContatoCliente[]
  projetos        Projeto[]
  lancamentos     Lancamento[]
  leads           Lead[]
  propostas       Proposta[]
  usuarios        User[]              @relation("ClienteUsuarios")
  docsJuridicos   DocumentoJuridico[]
  documentos      Documento[]
  orcamentosCusto CustoOrcamento[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([ativo])
  @@index([nome])
  @@index([status])
  /// Busca por CNPJ digitado. O índice ÚNICO PARCIAL (único quando preenchido, ADR-03)
  /// é tarefa própria (F1.15) e depende de resolver as 3 duplicatas de nome antes.
  @@index([documento])
  /// O Prisma não cria índice sozinho no lado da FK.
  @@index([segmentoId])
  @@index([fundidoEmId])
  @@index([excluidoEm])
  /// F2.4: negociações desta empresa.
  negociacoes Negociacao[]
  @@map("cliente")
}

model ContatoCliente {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome      String
  cargo     String?
  email     String?
  telefone  String?
  principal Boolean @default(false)

  // ── LGPD (CRM F1.9, decisão transversal T1) ─────────────────
  /// Descadastro. Contato com optOut NUNCA entra em lista de abordagem nem em exportação
  /// de prospecção. A checagem é centralizada em `modules/comercial/lgpd.ts` (F1.10) —
  /// não repetir esta condição solta em query.
  optOut     Boolean   @default(false)
  optOutAt   DateTime?
  /// Base legal da coleta. Prospecção B2B fria = legítimo interesse. É campo, e não
  /// constante, para não travar o dia em que houver outra base.
  baseLegal  BaseLegalLgpd @default(LEGITIMO_INTERESSE)
  /// De onde veio o dado (Sales Navigator, indicação, site…) e quando foi coletado.
  dataCollectionSource String?
  dataCollectedAt      DateTime?

  /// Sales Navigator (Fase 4) — só o link colado, sem scraping.
  linkedinUrl       String?
  salesNavigatorUrl String?

  /// Papel na decisão de compra (decisor, influenciador, técnico…). Texto por ora.
  papelDecisao         String?
  statusRelacionamento StatusRelacionamentoContato @default(ATIVO)

  /// Faltava no model. Necessário para `dataCollectedAt` ter de onde puxar (Q5).
  createdAt DateTime @default(now())

  /// Soft delete (ADR-11). A leitura principal e ANINHADA (`obterCliente` inclui contatos),
  /// que nao passa pela extensao -- o filtro la e explicito.
  excluidoEm DateTime?

  /// F2.3: prospecções em que este contato aparece.
  leads LeadContato[]

  @@index([clienteId])
  /// Filtro das listas de abordagem: "quem posso contatar".
  @@index([optOut])
  @@index([excluidoEm])
  /// F2.4: negociações em que este contato aparece.
  negociacoes NegociacaoContato[]
  @@map("contato_cliente")
}

// ─────────────────────────────────────────────────────────────
// Projetos & Disciplinas (Onda 1)
// ─────────────────────────────────────────────────────────────

enum TipoProjeto {
  particular
  licitacao
  /// Item 16 (beta): projeto de aprovação (só protocolo/aprovação em órgão, sem execução).
  aprovacao
  /// Laudo técnico: estrutura de pastas própria por disciplina, sem pacote de modelo.
  laudo
}

enum SituacaoProjeto {
  em_andamento
  concluido
  arquivado
  cancelado
}

enum StatusDisciplina {
  aguardando
  em_andamento
  em_revisao
  entregue
  aprovado
}

/// Catálogo configurável de disciplinas (Estrutural, Hidráulica…).
model DisciplinaCatalogo {
  id        String  @id @default(cuid())
  nome      String  @unique
  /// Sigla usada na nomenclatura de arquivos (ex.: ELE, ARQ). Opcional/única.
  codigo    String? @unique
  /// Número-base da disciplina para a nomenclatura de arquivos (ex.: Estrutural = 4000 →
  /// folhas 4001, 4002…). null = sem bloco; a numeração da folha começa em 1.
  numeracao Int?
  /// Grupo de exibição no catálogo (CIVIL, ELÉTRICA…). null = "Outras".
  categoria String?
  /// Chave da galeria de ícones (lucide, ex.: "Zap"). null = derivar do nome.
  icone     String?
  /// SVG custom já sanitizado (upload). Precede `icone` na resolução do ícone.
  iconeSvg  String?
  ativo     Boolean @default(true)
  ordem     Int     @default(0)

  padroes       PadraoTecnico[]
  /// Itens de proposta que já apontam para este catálogo (CRM F1.19).
  propostaItens PropostaItem[]
  /// Itens de tabela de preço que já apontam para este catálogo (CRM F1.20).
  itensTabelaPreco ItemTabelaPreco[]
  /// Disciplinas de projeto que já apontam para este catálogo (CRM F1.19c).
  disciplinas   Disciplina[]
  /// Negociações que já apontam para este catálogo (CRM F2.4).
  negociacoes NegociacaoDisciplina[]

  @@map("disciplina_catalogo")
}

/// Biblioteca de padrões técnicos por disciplina (pranchas, carimbos, detalhes, notas).
/// Reaproveita o storage de arquivos (arquivoPath relativo ao STORAGE_BASE_PATH).
model PadraoTecnico {
  id           String              @id @default(cuid())
  titulo       String
  descricao    String?
  /// Tipo do padrão: prancha | carimbo | detalhe | nota | outro (texto livre).
  tipo         String?
  disciplinaId String?
  disciplina   DisciplinaCatalogo? @relation(fields: [disciplinaId], references: [id])
  arquivoPath  String
  arquivoNome  String
  mime         String?
  tamanho      Int
  hashSha256   String?
  autorId      String
  ativo        Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([disciplinaId])
  @@map("padrao_tecnico")
}

/// Catálogo de normas técnicas (upload de PDF + número/título/ano da versão).
model NormaTecnica {
  id          String   @id @default(cuid())
  /// Número da norma (ex.: "NBR 6118").
  numero      String
  titulo      String
  /// Ano da versão vigente enviada.
  ano         Int
  arquivoPath String
  arquivoNome String
  mime        String?
  tamanho     Int
  hashSha256  String?
  autorId     String
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([numero])
  @@map("norma_tecnica")
}

/// Biblioteca de referências técnicas soltas (artigo/livro/nota técnica/outro).
/// Anexo e link externo são ambos opcionais, mas ao menos um é exigido na validação (Zod).
model ReferenciaTecnica {
  id          String   @id @default(cuid())
  titulo      String
  /// artigo | livro | nota_tecnica | outro (texto livre, ver TIPOS_REFERENCIA).
  tipo        String
  /// Autor da obra referenciada — distinto de autorId (quem cadastrou).
  autorObra   String?
  ano         Int?
  tags        String[] @default([])
  descricao   String?
  linkExterno String?
  arquivoPath String?
  arquivoNome String?
  mime        String?
  tamanho     Int?
  hashSha256  String?
  autorId     String
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tipo])
  @@map("referencia_tecnica")
}

/// Sequência atômica do número AAXXXX por ano.
model ProjetoSequencia {
  ano    Int @id
  ultimo Int @default(0)

  @@map("projeto_sequencia")
}

model Projeto {
  id            String          @id @default(cuid())
  ano           Int
  sequencial    Int
  /// Código de exibição AAXXXX (ex.: 260142).
  codigo        String          @unique
  tipo          TipoProjeto     @default(particular)
  situacao      SituacaoProjeto @default(em_andamento)
  nome          String
  descricao     String?
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  areaM2        Decimal?        @db.Decimal(12, 2)
  endereco      String?
  prazoFinal    DateTime?
  /// Valor de contrato (referência de receita). Base para gerar parcelas/recebíveis.
  valorContrato Decimal?        @db.Decimal(14, 2)
  /// Personalização da navegação por abas deste projeto: `[{ suffix, oculta }]` na ordem
  /// desejada. Abas ausentes da lista (novas, ou nunca configuradas) usam a ordem padrão
  /// e ficam visíveis. Editado em EditarProjetoDialog; aplicado em ProjetoTabNav.
  abasConfig    Json?

  disciplinas             Disciplina[]
  membros                 ProjetoMembro[]
  inputs                  InputProjeto[]
  briefing                BriefingProjeto?
  linkInput               LinkPublicoInput?
  linkArquivos            LinkPublicoArquivos?
  lancamentos             Lancamento[]
  canais                  Canal[]
  proposta                Proposta?
  tarefas                 Tarefa[]
  docsJuridicos           DocumentoJuridico[]
  documentos              Documento[]
  licitacao               Licitacao?
  sessoes                 SessaoTrabalho[]
  eapTarefas              EapTarefa[]
  alocacoes               Alocacao[]
  servicos                ServicoTerceirizado[]
  rateios                 RateioHora[]
  composicaoPreco         ProjetoComposicaoPreco?
  lmConfig                LmConfig?
  pranchaCatalogos        PranchaCatalogo[]
  nomenclaturaConfig      NomenclaturaConfig?
  linhasBase              LinhaBase[]
  planejamentos           PlanejamentoPagamento[]
  checklist               ChecklistItemProjeto[]
  riscos                  RiscoProjeto[]
  calculosFerramenta      CalculoFerramenta[]
  diarioEntradas          DiarioEntrada[]
  arts                    Art[]
  apontamentosCoordenacao ApontamentoCoordenacao[]
  orcamentosCusto         CustoOrcamento[]

  // ── F2.4 (ADR-06): de onde veio este projeto, do lado comercial ────────────────────────
  /// Nullable: todo projeto anterior à reforma (e todo projeto criado fora do funil, que hoje é
  /// como o trabalho entra) fica sem negociação — é o estado normal, não uma pendência.
  /// ⚠️ Passa a existir um SEGUNDO caminho para "de onde veio esse projeto", ao lado de
  /// `Proposta.projetoId`, que continua existindo e inalterado. O risco de divergência entre os
  /// dois é reconhecido em `02-schema.md` §8.5, e a mitigação é da F5.9: a transação de aceite
  /// grava os dois SEMPRE juntos, nunca um sem o outro, com teste dedicado provando isso.
  negociacaoId String?
  negociacao   Negociacao? @relation(fields: [negociacaoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([clienteId])
  @@index([situacao])
  @@index([negociacaoId])
  @@map("projeto")
}

/// N-34: item de checklist livre por projeto.
model ChecklistItemProjeto {
  id          String    @id @default(cuid())
  projetoId   String
  descricao   String
  concluido   Boolean   @default(false)
  concluidoEm DateTime?
  ordem       Int       @default(0)
  createdAt   DateTime  @default(now())

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("checklist_item_projeto")
}

/// N-39: risco identificado para um projeto.
model RiscoProjeto {
  id            String   @id @default(cuid())
  projetoId     String
  descricao     String
  probabilidade Int      @default(1) // 1=baixa 2=média 3=alta
  impacto       Int      @default(1) // 1=baixo 2=médio 3=alto
  mitigacao     String?
  status        String   @default("aberto") // aberto | mitigado | aceito
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projeto Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("risco_projeto")
}

/// Campo de input do projeto (pergunta + resposta do cliente).
/// Pergunta padrão de input por disciplina (template), aplicada automaticamente aos projetos (#3).
model InputTemplate {
  id         String   @id @default(cuid())
  disciplina String? // null = geral; senão nome da disciplina (DisciplinaCatalogo)
  pergunta   String
  ordem      Int      @default(0)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([disciplina])
  @@map("input_template")
}

model InputProjeto {
  id         String   @id @default(cuid())
  projetoId  String
  projeto    Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  disciplina String? // null = geral; senão nome da disciplina
  pergunta   String
  resposta   String?
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([projetoId])
  @@map("input_projeto")
}

/// Briefing de Start (Mód 3): respostas do formulário multi-etapas (schema em
/// modules/inputs/briefing-schema.ts). 1:1 com o projeto; respostas como JSON.
model BriefingProjeto {
  id            String    @id @default(cuid())
  projetoId     String    @unique
  projeto       Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  respostasJson Json      @default("{}")
  /// nao_iniciado | em_preenchimento | completo (derivado, persistido p/ listagem rápida).
  status        String    @default("nao_iniciado")
  preenchidoPor String?
  preenchidoEm  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("briefing_projeto")
}

/// Link público (por token) para o cliente preencher os inputs sem login.
/// Mesma convenção de LinkPublicoArquivos: `ativo=false` revoga na hora e `expiraEm`
/// no passado desliga o link (regra única em `lib/link-publico.ts`).
model LinkPublicoInput {
  id        String   @id @default(cuid())
  projetoId String   @unique
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  token     String   @unique
  ativo     Boolean  @default(true)
  /// Data/hora de expiração (opcional). Nulo = não expira.
  expiraEm  DateTime?
  /// Última vez que a equipe foi avisada de preenchimento por este link. Serve de
  /// trava de janela: o formulário salva sozinho a cada campo, e sem isso cada
  /// tecla viraria notificação.
  notificadoEm DateTime?
  createdAt DateTime @default(now())

  @@map("link_publico_input")
}

/// Link público (sem login) para o cliente ver e BAIXAR os arquivos do projeto.
/// Somente leitura: expõe apenas uploads validados (validado=true) das disciplinas
/// listadas em `disciplinaIds` (whitelist editável — alterar a seleção reflete no
/// MESMO token). `ativo=false` revoga na hora; `expiraEm` desliga após a data.
model LinkPublicoArquivos {
  id            String    @id @default(cuid())
  projetoId     String    @unique
  projeto       Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  token         String    @unique
  ativo         Boolean   @default(true)
  /// Data/hora de expiração (opcional). Nulo = não expira.
  expiraEm      DateTime?
  /// IDs das disciplinas liberadas no link. Vazio = nenhuma disciplina exposta.
  disciplinaIds String[]  @default([])
  criadoPorId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("link_publico_arquivos")
}

// ─────────────────────────────────────────────────────────────
// Financeiro — Cadastros base (Onda 2a)
// ─────────────────────────────────────────────────────────────

enum TipoCategoria {
  receita
  despesa
}

/// Plano de contas hierárquico (código ex.: "2.01").
model CategoriaFinanceira {
  id       String                @id @default(cuid())
  codigo   String                @unique
  nome     String
  tipo     TipoCategoria
  paiId    String?
  pai      CategoriaFinanceira?  @relation("CategoriaFilhas", fields: [paiId], references: [id])
  filhas   CategoriaFinanceira[] @relation("CategoriaFilhas")
  ordem    Int                   @default(0)
  ativo    Boolean               @default(true)
  /// Atividade no DFC: "operacional" | "investimento" | "financiamento" (default operacional).
  grupoDfc String?

  lancamentos Lancamento[]
  regras      RegraCategorizacao[]
  orcamentos  OrcamentoItem[]

  @@index([tipo, ativo])
  @@map("categoria_financeira")
}

/// Valor orçado (planejado) de uma categoria para um ano — base do orçamento editável.
model OrcamentoItem {
  id             String              @id @default(cuid())
  ano            Int
  categoriaId    String
  categoria      CategoriaFinanceira @relation(fields: [categoriaId], references: [id], onDelete: Cascade)
  valorPlanejado Decimal             @db.Decimal(14, 2)
  updatedAt      DateTime            @updatedAt

  @@unique([ano, categoriaId])
  @@index([ano])
  @@map("orcamento_item")
}

model CentroCusto {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)

  lancamentos   Lancamento[]
  planejamentos PlanejamentoPagamento[]

  @@map("centro_custo")
}

enum TipoContaBancaria {
  corrente
  poupanca
  caixa
  investimento
}

model ContaBancaria {
  id           String            @id @default(cuid())
  nome         String
  tipo         TipoContaBancaria @default(corrente)
  banco        String?
  agencia      String?
  numero       String?
  saldoInicial Decimal           @default(0) @db.Decimal(14, 2)
  padrao       Boolean           @default(false)
  ativo        Boolean           @default(true)
  ordem        Int               @default(0)

  lancamentos   Lancamento[]
  extratos      ExtratoBancario[]
  transacoes    TransacaoBancaria[]
  planejamentos PlanejamentoPagamento[]

  @@map("conta_bancaria")
}

model FormaPagamento {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)

  lancamentos Lancamento[]

  @@map("forma_pagamento")
}

model Fornecedor {
  id          String     @id @default(cuid())
  tipo        TipoPessoa @default(PJ)
  nome        String
  documento   String?
  email       String?
  telefone    String?
  /// Tipo de serviço (topografia, sondagem, ensaios…)
  servico     String?
  observacoes String?
  ativo       Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  lancamentos     Lancamento[]
  servicos        ServicoTerceirizado[]
  catalogo        FornecedorServico[]
  subcontratacoes SubcontratacaoLicitacao[]
  sancoes         SancaoConcorrente[]

  @@index([ativo])
  @@map("fornecedor")
}

/// Fornecedor de material/insumo de obra — cadastro dedicado a Cotações (Onda C4), independente do
/// `Fornecedor` do financeiro (serviços/subcontratados/despesas): populações diferentes de verdade, não
/// a mesma entidade duplicada (ver design §11).
model CustoFornecedor {
  id          String     @id @default(cuid())
  tipo        TipoPessoa @default(PJ)
  nome        String
  documento   String?
  email       String?
  telefone    String?
  observacoes String?
  ativo       Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  /// UFs atendidas.
  regioesAtendidas      String[]          @default([])
  /// Categorias de insumo que este fornecedor costuma cotar — filtro de sugestão ao convidar pra RFQ.
  categoriasFornecidas  CategoriaInsumo[] @default([])
  prazoMedioDiasEntrega Int?
  condicoesComerciais   String?
  /// Nota subjetiva 0.00–5.00, editada manualmente por quem gerencia o cadastro.
  avaliacaoNota         Decimal?          @db.Decimal(3, 2)

  representantes CustoFornecedorRepresentante[]
  rfqConvites    CustoRfqConvite[]
  propostas      CustoProposta[]
  precoHistorico CustoPrecoHistorico[]

  @@index([ativo])
  @@map("custo_fornecedor")
}

/// Serviço que um fornecedor presta (catálogo) — com valor de referência (A7).
model FornecedorServico {
  id              String     @id @default(cuid())
  fornecedorId    String
  fornecedor      Fornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  descricao       String
  valorReferencia Decimal?   @db.Decimal(14, 2)
  ativo           Boolean    @default(true)
  createdAt       DateTime   @default(now())

  @@index([fornecedorId])
  @@map("fornecedor_servico")
}

model Socio {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id])
  percentual Decimal  @db.Decimal(5, 2)
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())

  retiradas RetiradaSocio[]

  @@map("socio")
}

/// Item 6: Pessoa Jurídica (CNPJ) que agrupa N perfis de projetista/colaborador PJ.
/// Aditivo e não-destrutivo: nenhuma relação existente (faturamento via NotaFiscalPJ,
/// pagamentos, membros de projeto) muda — todas continuam ancoradas no User.
model PessoaJuridica {
  id           String   @id @default(cuid())
  cnpj         String   @unique
  razaoSocial  String
  nomeFantasia String?
  email        String?
  telefone     String?
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membros  User[]
  vinculos Vinculo[]

  @@map("pessoa_juridica")
}

enum TipoRetiradaSocio {
  pro_labore
  distribuicao
  adiantamento
}

/// Retirada de sócio (pró-labore, distribuição de lucro, adiantamento).
model RetiradaSocio {
  id         String            @id @default(cuid())
  socioId    String
  socio      Socio             @relation(fields: [socioId], references: [id], onDelete: Cascade)
  data       DateTime          @db.Date
  valor      Decimal           @db.Decimal(14, 2)
  tipo       TipoRetiradaSocio @default(pro_labore)
  observacao String?
  createdAt  DateTime          @default(now())

  @@index([socioId])
  @@map("retirada_socio")
}

// ─────────────────────────────────────────────────────────────
// Financeiro — Lançamentos (ledger) + contas a pagar/receber (Onda 2b)
// ─────────────────────────────────────────────────────────────

enum TipoLancamento {
  receita
  despesa
}

enum StatusLancamento {
  previsto // conta a pagar/receber em aberto
  aguardando_aprovacao // despesa acima da alçada, trava até aprovação
  confirmado // pago/recebido (entra no caixa e na DRE)
  cancelado
}

/// Lançamento financeiro. previsto = conta a pagar/receber; confirmado = realizado.
model Lancamento {
  id           String           @id @default(cuid())
  tipo         TipoLancamento
  descricao    String
  valor        Decimal          @db.Decimal(14, 2)
  /// Valor efetivamente pago/recebido (parcial). Se null, considera `valor`.
  valorEfetivo Decimal?         @db.Decimal(14, 2)
  status       StatusLancamento @default(previsto)

  /// Competência/realização. `vencimento` para previstos; `dataConfirmacao` ao realizar.
  data            DateTime  @db.Date
  vencimento      DateTime? @db.Date
  dataConfirmacao DateTime? @db.Date
  /// Data de competência (regime de competência). Se null, usa `data`.
  dataCompetencia DateTime? @db.Date

  categoriaId  String
  categoria    CategoriaFinanceira @relation(fields: [categoriaId], references: [id])
  centroId     String?
  centro       CentroCusto?        @relation(fields: [centroId], references: [id])
  contaId      String?
  conta        ContaBancaria?      @relation(fields: [contaId], references: [id])
  formaId      String?
  forma        FormaPagamento?     @relation(fields: [formaId], references: [id])
  projetoId    String?
  projeto      Projeto?            @relation(fields: [projetoId], references: [id])
  fornecedorId String?
  fornecedor   Fornecedor?         @relation(fields: [fornecedorId], references: [id])
  clienteId    String?
  cliente      Cliente?            @relation(fields: [clienteId], references: [id])

  observacao            String?
  recorrenciaGrupo      String?
  /// Etiquetas livres (A6).
  tags                  String[]                    @default([])
  /// Documento-fonte (NF/contrato/proposta/medição) — rastreabilidade de origem (Fase 2).
  documentoFinanceiroId String?
  documentoFinanceiro   DocumentoFinanceiro?        @relation(fields: [documentoFinanceiroId], references: [id], onDelete: SetNull)
  anexos                LancamentoAnexo[]
  statusHistorico       LancamentoStatusHistorico[]
  planejamentoLinhas    PlanejamentoLinha[]
  /// Aprovação por alçada (Fase 4): quem aprovou, quando, e motivo se rejeitado.
  aprovadoPorId         String?
  aprovadoEm            DateTime?
  motivoRejeicao        String?
  /// Vínculo com a folha de projetistas (Onda 2c).
  pagamentoProjetistaId String?                     @unique

  autorId String
  autor   User   @relation("LancamentoAutor", fields: [autorId], references: [id])

  transacao TransacaoBancaria?

  /// Migração de dados externos (ex.: "Meu Dinheiro"). `importLoteId` agrupa o lote (undo);
  /// `importHash` (sha256 de tipo|data|valor|descrição|categoria) evita reimportar a mesma linha.
  importLoteId String?
  importLote   ImportacaoFinanceira? @relation(fields: [importLoteId], references: [id], onDelete: SetNull)
  importHash   String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  /// Soft delete: quando preenchido, o lançamento foi excluído e some de listagens/relatórios.
  excluidoEm DateTime?

  @@index([tipo, status])
  @@index([vencimento])
  @@index([data])
  @@index([projetoId])
  @@index([excluidoEm])
  @@index([documentoFinanceiroId])
  @@index([importLoteId])
  @@index([importHash])
  @@map("lancamento")
}

/// Lote de importação financeira (migração de ERP externo). Guarda contagens por tipo,
/// o mapeamento aplicado (snapshot p/ auditoria) e permite desfazer (deleteMany por lote).
model ImportacaoFinanceira {
  id                  String       @id @default(cuid())
  nomeArquivo         String
  origem              String       @default("meu_dinheiro")
  totalLinhas         Int
  lancamentosCriados  Int          @default(0)
  categoriasCriadas   Int          @default(0)
  contasCriadas       Int          @default(0)
  formasCriadas       Int          @default(0)
  centrosCriados      Int          @default(0)
  fornecedoresCriados Int          @default(0)
  clientesCriados     Int          @default(0)
  mapeamento          Json
  autorId             String
  autor               User         @relation("ImportacaoFinanceiraAutor", fields: [autorId], references: [id])
  desfeitoEm          DateTime?
  createdAt           DateTime     @default(now())
  lancamentos         Lancamento[]

  @@index([autorId])
  @@map("importacao_financeira")
}

enum TipoDocumentoFinanceiro {
  nf_entrada
  nf_servico
  contrato
  proposta
  medicao
}

/// Documento-fonte de movimentações financeiras (rastreabilidade + parcelamento). Fase 2.
/// Híbrido: modelo próprio p/ NF/contrato; `referenciaId` reaproveita Proposta/Medição existentes.
model DocumentoFinanceiro {
  id             String                  @id @default(cuid())
  tipo           TipoDocumentoFinanceiro
  numero         String?
  dataEmissao    DateTime?               @db.Date
  valorDocumento Decimal?                @db.Decimal(14, 2)
  /// FKs escalares (sem relação, resolvidos por lookup) p/ não inflar Fornecedor/Cliente.
  fornecedorId   String?
  clienteId      String?
  /// Quando tipo = proposta|medicao: id da Proposta/MedicaoLicitacao reaproveitada (ref. soft).
  referenciaId   String?
  arquivoPath    String?
  arquivoNome    String?
  arquivoMime    String?
  observacao     String?
  autorId        String
  createdAt      DateTime                @default(now())

  lancamentos Lancamento[]

  @@index([tipo])
  @@map("documento_financeiro")
}

// ─────────────────────────────────────────────────────────────
// Financeiro — Conciliação bancária (OFX) (Onda 2d)
// ─────────────────────────────────────────────────────────────

model ExtratoBancario {
  id          String              @id @default(cuid())
  contaId     String
  conta       ContaBancaria       @relation(fields: [contaId], references: [id])
  nomeArquivo String?
  importadoEm DateTime            @default(now())
  transacoes  TransacaoBancaria[]

  @@index([contaId])
  @@map("extrato_bancario")
}

model TransacaoBancaria {
  id           String          @id @default(cuid())
  extratoId    String
  extrato      ExtratoBancario @relation(fields: [extratoId], references: [id], onDelete: Cascade)
  contaId      String
  conta        ContaBancaria   @relation(fields: [contaId], references: [id])
  /// Identificador único da transação no OFX (dedup).
  fitid        String
  data         DateTime        @db.Date
  /// Positivo = entrada, negativo = saída.
  valor        Decimal         @db.Decimal(14, 2)
  descricao    String
  conciliado   Boolean         @default(false)
  /// Lançamento ao qual esta transação foi conciliada.
  lancamentoId String?         @unique
  lancamento   Lancamento?     @relation(fields: [lancamentoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([contaId, fitid])
  @@index([contaId, conciliado])
  @@map("transacao_bancaria")
}

/// Regra de auto-categorização: descrição que casa → categoria sugerida.
model RegraCategorizacao {
  id          String              @id @default(cuid())
  termo       String
  categoriaId String
  categoria   CategoriaFinanceira @relation(fields: [categoriaId], references: [id])
  ativo       Boolean             @default(true)

  @@map("regra_categorizacao")
}

// ─────────────────────────────────────────────────────────────
// Chat interno (Onda 3a)
// ─────────────────────────────────────────────────────────────

enum TipoCanal {
  geral
  projeto
  disciplina
  dm
  grupo
  socios
}

enum ChatStatus {
  disponivel
  ocupado
  reuniao
}

model Canal {
  id           String      @id @default(cuid())
  tipo         TipoCanal
  nome         String?
  icone        String? // emoji da galeria (capa quando não há imagem)
  imagemCapa   String? // caminho relativo da imagem de capa (storage)
  criadoPorId  String?
  criadoPor    User?       @relation("CanaisCriados", fields: [criadoPorId], references: [id], onDelete: SetNull)
  projetoId    String?
  projeto      Projeto?    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  disciplinaId String?
  disciplina   Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)

  membros   CanalMembro[]
  mensagens Mensagem[]
  createdAt DateTime      @default(now())

  @@index([tipo])
  @@index([projetoId])
  @@index([disciplinaId])
  @@index([criadoPorId])
  @@map("canal")
}

model CanalMembro {
  id         String    @id @default(cuid())
  canalId    String
  canal      Canal     @relation(fields: [canalId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  silenciado Boolean   @default(false)

  @@unique([canalId, userId])
  @@index([userId])
  @@map("canal_membro")
}

model Mensagem {
  id          String            @id @default(cuid())
  canalId     String
  canal       Canal             @relation(fields: [canalId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User              @relation(fields: [autorId], references: [id])
  conteudo    String
  fixada      Boolean           @default(false)
  encaminhada Boolean           @default(false)
  anexoPath   String?
  anexoNome   String?
  anexoMime   String?
  createdAt   DateTime          @default(now())
  editedAt    DateTime?
  excluidaEm  DateTime?
  respostaAId String?
  respostaA   Mensagem?         @relation("MensagemResposta", fields: [respostaAId], references: [id], onDelete: SetNull)
  respostas   Mensagem[]        @relation("MensagemResposta")
  leituras    MensagemLeitura[]
  entregas    MensagemEntrega[]
  audicoes    MensagemAudicao[]
  reacoes     MensagemReacao[]
  anexos      MensagemAnexo[]

  @@index([canalId, createdAt])
  @@index([respostaAId])
  @@map("mensagem")
}

/// Anexo de mensagem de chat — permite múltiplos arquivos por mensagem (colar/anexar vários).
/// As colunas legadas anexoPath/Nome/Mime em Mensagem seguem para mensagens antigas (fallback).
model MensagemAnexo {
  id         String   @id @default(cuid())
  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  path       String
  nome       String
  mime       String
  ordem      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([mensagemId])
  @@map("mensagem_anexo")
}

/// Confirmação de leitura de uma mensagem por um usuário (E6).
model MensagemLeitura {
  id         String   @id @default(cuid())
  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lidaEm     DateTime @default(now())

  @@unique([mensagemId, userId])
  @@index([mensagemId])
  @@map("mensagem_leitura")
}

/// Confirmação de ENTREGA (recebimento no dispositivo) de uma mensagem a um usuário.
/// Análogo a MensagemLeitura, mas registrado quando a mensagem chega ao cliente
/// (via socket/abertura do canal), antes da leitura efetiva — habilita ✓✓ "entregue".
model MensagemEntrega {
  id         String   @id @default(cuid())
  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entregueEm DateTime @default(now())

  @@unique([mensagemId, userId])
  @@index([mensagemId])
  @@map("mensagem_entrega")
}

/// Registro de que um usuário OUVIU (reproduziu) um anexo de áudio de uma mensagem.
model MensagemAudicao {
  id         String   @id @default(cuid())
  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ouvidaEm   DateTime @default(now())

  @@unique([mensagemId, userId])
  @@index([mensagemId])
  @@map("mensagem_audicao")
}

model MensagemReacao {
  id         String   @id @default(cuid())
  mensagemId String
  mensagem   Mensagem @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji      String
  createdAt  DateTime @default(now())

  @@unique([mensagemId, userId])
  @@index([mensagemId])
  @@map("mensagem_reacao")
}

/// Biblioteca de modelos de contrato (texto base) (E2).
model ModeloContrato {
  id        String   @id @default(cuid())
  nome      String
  categoria String?
  conteudo  String   @default("")
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("modelo_contrato")
}

enum StatusSolicCadastro {
  pendente
  aprovada
  recusada
}

/// Pedido público de cadastro (auto-cadastro → admin aprova) (E7).
model SolicitacaoCadastro {
  id        String              @id @default(cuid())
  nome      String
  email     String
  telefone  String?
  mensagem  String?
  /// Cargo/vínculo pretendido informado pela pessoa (palpite — o admin decide na criação).
  role      Role                @default(cliente)
  status    StatusSolicCadastro @default(pendente)
  createdAt DateTime            @default(now())

  @@index([status])
  @@map("solicitacao_cadastro")
}

/// Preferências do usuário (store dedicado, key-value em JSON) (E8).
model UserPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dados     Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("user_preference")
}

// ─────────────────────────────────────────────────────────────
// RH — Ponto, banco de horas, rateio (Onda 3b)
// ─────────────────────────────────────────────────────────────

/// Uma sessão de trabalho (cronômetro). fim=null = em andamento.
/// Troca de projeto fecha a sessão atual e abre outra → tempo por projeto.
model SessaoTrabalho {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projetoId String?
  projeto   Projeto?  @relation(fields: [projetoId], references: [id])
  inicio    DateTime
  fim       DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, inicio])
  @@index([projetoId])
  @@map("sessao_trabalho")
}

// EscalaTrabalho removido em F7 — substituído por EscalaRole + EscalaUsuario (Ponto v2)

/// Rateio mensal do custo de horas trabalhadas por projeto (Fluxo C: ponto → custo → margem).
/// Snapshot fechado por mês: congela o custo/hora vigente no momento do fechamento.
model RateioHora {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projetoId String
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  ano       Int
  mes       Int
  minutos   Int
  /// Custo/hora usado no fechamento (snapshot de Recurso.custoHora ou derivado do salário base).
  custoHora Decimal  @db.Decimal(10, 2)
  /// Custo total rateado = minutos / 60 × custoHora.
  custo     Decimal  @db.Decimal(12, 2)
  fechadoEm DateTime @default(now())

  @@unique([userId, projetoId, ano, mes])
  @@index([projetoId, ano, mes])
  @@map("rateio_hora")
}

/// Fechamento mensal do banco de horas: congela saldo do mês e o acumulado (carry-forward).
model BancoHorasMensal {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ano              Int
  mes              Int
  /// Saldo do mês (trabalhado − esperado), em minutos.
  saldoMinutos     Int
  /// Saldo acumulado até este mês (carry-forward), em minutos.
  acumuladoMinutos Int
  fechadoEm        DateTime @default(now())

  @@unique([userId, ano, mes])
  @@index([userId])
  @@map("banco_horas_mensal")
}

// ─────────────────────────────────────────────────────────────
// Ponto v2 — jornada por batidas, escalas, espelho, ajustes e alertas
// (jul/2026). Aditivo: SessaoTrabalho segue existindo (rateio por projeto +
// fallback histórico); Batida passa a ser a fonte de verdade da JORNADA;
// EscalaTrabalho removida (substituída por EscalaRole/EscalaUsuario em F7).
// Ver docs/superpowers/plans/... (plano "Ponto v2").
// ─────────────────────────────────────────────────────────────

enum TipoBatidaPonto {
  entrada
  inicio_descanso
  fim_descanso
  saida
}

enum OrigemBatida {
  app
  offline
  ajuste_proprio
  ajuste_admin
  migracao
}

/// Batida de ponto: fonte de verdade da jornada do dia (entrada → N descansos
/// → saída). Acoplada 1:1 à SessaoTrabalho no mesmo instante (ver service.ts) —
/// a batida não substitui a sessão, que continua alimentando o rateio por projeto.
model Batida {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Dia LOCAL (America/Sao_Paulo) da jornada — o dia da ENTRADA; jornada
  /// noturna que cruza a meia-noite permanece no dia em que começou.
  dia     DateTime        @db.Date
  tipo    TipoBatidaPonto
  /// Instante real da batida.
  horario DateTime

  /// Projeto ativo no momento da batida — informativo, sem relação (mesmo
  /// padrão de DocumentoFinanceiro.fornecedorId/clienteId: FK escalar por lookup,
  /// para não inflar o model Projeto).
  projetoId String?

  origem          OrigemBatida @default(app)
  editada         Boolean      @default(false)
  /// Snapshot do horário original — preenchido na 1ª edição (auditoria).
  horarioOriginal DateTime?
  /// Quem efetivamente registrou a batida, quando ≠ userId (ajuste do admin).
  criadoPorId     String?
  criadoPor       User?        @relation("BatidaCriador", fields: [criadoPorId], references: [id])
  /// Geolocalização opcional capturada no momento da batida (S6) — auditoria, não bloqueia.
  geo             Json?

  createdAt DateTime @default(now())

  @@index([userId, dia])
  @@index([userId, horario])
  @@map("batida")
}

/// Escala de trabalho padrão por role — uma linha por dia da semana (0=domingo
/// .. 6=sábado). Resolução: EscalaUsuario ativa (override) → EscalaRole do
/// role → fallback seg-sex 8h sem horários.
model EscalaRole {
  id        String @id @default(cuid())
  role      Role
  diaSemana Int

  /// Horário previsto "HH:MM" — null = day off / sem horário fixo.
  entrada       String?
  saida         String?
  /// Descansos previstos: `[{inicio,fim}]` em "HH:MM" — múltiplos permitidos.
  descansos     Json    @default("[]")
  horasDia      Decimal @default(8) @db.Decimal(4, 2)
  ativo         Boolean @default(true)
  /// Tolerância de atraso em minutos (CLT art. 58 §1º) — informativo (S3), não altera falta/ok.
  toleranciaMin Int     @default(10)

  @@unique([role, diaSemana])
  @@map("escala_role")
}

/// Escala PADRÃO por contratação — sucessora de `EscalaRole` (Onda E, §6.4 do plano de Setor ×
/// Contratação × Perfil). A chave passa a ser COMO a pessoa é contratada, não o papel que ela
/// tem no app: jornada é matéria trabalhista, e `role` misturava quatro eixos.
///
/// `pj`, `autonomo_rpa` e `pro_labore` NÃO têm linha aqui, de propósito: quem não tem jornada
/// controlada continua caindo no default de `completarSemana` (8h úteis), exatamente como cai
/// hoje. Tratar "sem jornada" como 0h zeraria o custo/hora de PJ sem `Recurso.custoHora` em
/// `custoHoraPorUsuario` (salarioBase ÷ horas) e quebraria a margem de projeto em silêncio.
model EscalaContratacao {
  id          String      @id @default(cuid())
  contratacao Contratacao
  diaSemana   Int

  /// Horário previsto "HH:MM" — null = day off / sem horário fixo.
  entrada       String?
  saida         String?
  /// Descansos previstos: `[{inicio,fim}]` em "HH:MM" — múltiplos permitidos.
  descansos     Json    @default("[]")
  horasDia      Decimal @default(8) @db.Decimal(4, 2)
  ativo         Boolean @default(true)
  /// Tolerância de atraso em minutos (CLT art. 58 §1º) — informativo, não altera falta/ok.
  toleranciaMin Int     @default(10)

  @@unique([contratacao, diaSemana])
  @@map("escala_contratacao")
}

/// Override de escala por usuário — mesma grade da EscalaRole. Se o usuário
/// tem qualquer linha ativa, a grade dele substitui a do role POR INTEIRO
/// (não mescla dia a dia).
model EscalaUsuario {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  diaSemana Int

  entrada       String?
  saida         String?
  descansos     Json    @default("[]")
  horasDia      Decimal @default(8) @db.Decimal(4, 2)
  ativo         Boolean @default(true)
  toleranciaMin Int     @default(10)

  @@unique([userId, diaSemana])
  @@map("escala_usuario")
}

/// "Assinatura" mensal do espelho de ponto pelo colaborador (S2) — mesmo
/// padrão do AceiteTermo: hash SHA-256 do conteúdo aceito prova o não-repúdio.
model EspelhoAceite {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ano      Int
  mes      Int
  hash     String
  aceitoEm DateTime @default(now())

  @@unique([userId, ano, mes])
  @@map("espelho_aceite")
}

enum StatusAjustePonto {
  pendente_ciencia
  ciente
  contestado
}

/// Evento de edição de um DIA de ponto: snapshot antes/depois + workflow de
/// ciência. Edição própria (`proprio=true`) dispensa ciência; edição do admin
/// exige que o usuário afetado confirme ou conteste.
model AjustePonto {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation("AjustePontoUsuario", fields: [userId], references: [id], onDelete: Cascade)
  editorId String
  editor   User     @relation("AjustePontoEditor", fields: [editorId], references: [id])
  dia      DateTime @db.Date

  /// Motivo obrigatório (mín. 5 caracteres — validado no schema Zod).
  justificativa  String
  /// Snapshot das batidas do dia ANTES da edição.
  snapshotAntes  Json
  /// Snapshot das batidas do dia DEPOIS da edição.
  snapshotDepois Json
  /// true = o próprio usuário editou (sem workflow de ciência).
  proprio        Boolean @default(false)

  status            StatusAjustePonto?
  cienciaEm         DateTime?
  contestacaoMotivo String?

  createdAt DateTime @default(now())

  @@index([userId, dia])
  @@index([status])
  @@map("ajuste_ponto")
}

/// Dedup de alertas de jornada já enviados — evita reenviar o mesmo alerta em
/// ticks sucessivos do job (roda a cada 5 minutos).
model AlertaPontoEnviado {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dia       DateTime @db.Date
  /// Chave do alerta: "entrada:prox", "saida:agora", "jornada_cumprida"…
  chave     String
  enviadoEm DateTime @default(now())

  @@unique([userId, dia, chave])
  @@map("alerta_ponto_enviado")
}

// ─────────────────────────────────────────────────────────────
// RH — Abono, férias, clima (Onda 3c)
// ─────────────────────────────────────────────────────────────

enum StatusSolicitacao {
  pendente
  aprovado
  rejeitado
}

/// Abono de faltas via atestado. Supervisor/RH valida.
model AbonoFalta {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("AbonoUser", fields: [userId], references: [id], onDelete: Cascade)
  dataInicio    DateTime          @db.Date
  dataFim       DateTime          @db.Date
  motivo        String?
  atestadoPath  String?
  atestadoNome  String?
  status        StatusSolicitacao @default(pendente)
  validadoPorId String?
  validadoPor   User?             @relation("AbonoValidador", fields: [validadoPorId], references: [id])
  validadoEm    DateTime?
  createdAt     DateTime          @default(now())

  @@index([userId])
  @@index([status])
  @@map("abono_falta")
}

/// Solicitação de férias — ou lançamento direto pelo RH (ver `lancadoPorId`).
model Ferias {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation("FeriasUser", fields: [userId], references: [id], onDelete: Cascade)
  inicio        DateTime          @db.Date
  fim           DateTime          @db.Date
  observacao    String?
  status        StatusSolicitacao @default(pendente)
  validadoPorId String?
  validadoPor   User?             @relation("FeriasValidador", fields: [validadoPorId], references: [id])
  /// RH/admin que lançou as férias direto, sem solicitação do colaborador.
  /// Não-nulo ⟺ lançamento por RH. Denormalizado, sem FK (mesmo padrão de `altPorId`).
  lancadoPorId  String?
  // Proposta de alteração de datas em férias JÁ APROVADAS — dupla aprovação
  // (admin/RH + funcionário). Aplica-se quando altOkAdmin && altOkFunc; ao aplicar,
  // move alt* → inicio/fim e zera os campos. Enquanto pendente, altPorId marca quem propôs.
  altInicio     DateTime?         @db.Date
  altFim        DateTime?         @db.Date
  altPorId      String? // quem propôs a alteração (denormalizado, sem FK)
  altOkAdmin    Boolean           @default(false)
  altOkFunc     Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([userId])
  @@index([status])
  @@map("ferias")
}

/// Registro de clima emocional. Anônimo na exibição (admin vê só agregado).
model RegistroEmocao {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  humor      Int // 1 (péssimo) a 5 (ótimo)
  comentario String?
  dia        DateTime @db.Date
  createdAt  DateTime @default(now())

  @@unique([userId, dia])
  @@index([dia])
  @@map("registro_emocao")
}

/// Feedback livre à empresa (Mód 1/9) enviado pelo herocard. Pode ser ANÔNIMO
/// (userId nulo → a RH não vê o autor). A action grava com `audit: false` p/ não
/// criar trilha que vincule o autor ao conteúdo quando anônimo.
model FeedbackHumor {
  id        String   @id @default(cuid())
  conteudo  String
  anonimo   Boolean  @default(false)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("feedback_humor")
}

model ProjetoMembro {
  id        String  @id @default(cuid())
  projetoId String
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  papel     String? // ex.: coordenador, projetista

  @@unique([projetoId, userId])
  @@index([userId])
  @@map("projeto_membro")
}

model Disciplina {
  id           String           @id @default(cuid())
  projetoId    String
  projeto      Projeto          @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  // ── Disciplina: texto livre → catálogo (CRM F1.19c, mesmo padrão da F1.19/F1.20) ──
  /// Texto original digitado antes da migração. `@map` mantém a COLUNA FÍSICA com o nome
  /// antigo (`nome`): o banco não sofre rename, só o código passa a chamá-la assim — os
  /// pontos de leitura que ainda usam `.nome` falham em COMPILAÇÃO, não em runtime.
  /// Fica como fallback enquanto houver disciplina sem FK — a consolidação das 6 grafias
  /// pendentes é a F1.21. Deprecado para escrita nova; ainda lido.
  disciplinaTextoLegado String              @map("nome")
  /// NULLABLE de propósito: em produção há 18 grafias distintas, 12 batendo exato com o
  /// catálogo e 6 precisando de tratamento manual (3 colapsam, 3 são string composta —
  /// ver `docs/crm/03-migracao.md` §5). Item que não resolve fica sem FK — é estado
  /// esperado, não falha. Relação chamada `catalogo`, não `disciplina`, porque o próprio
  /// model já se chama `Disciplina` — `disciplina.disciplina` seria ambíguo de ler.
  disciplinaId          String?
  catalogo              DisciplinaCatalogo? @relation(fields: [disciplinaId], references: [id])

  status       StatusDisciplina @default(aguardando)
  prazo        DateTime?
  /// Quando a disciplina foi entregue/aprovada (p/ SLA de entregas).
  entregueEm   DateTime?
  /// Valor a pagar ao(s) projetista(s) por esta entrega.
  valor        Decimal?         @db.Decimal(12, 2)
  ordem        Int              @default(0)
  /// P-13: configura quais pacotes são obrigatórios para validação desta disciplina.
  exigePacoteA Boolean          @default(true)
  exigePacoteB Boolean          @default(true)

  /// Fluxo de conclusão em 2 passos (projetos aprovação/laudo): responsável marca
  /// "projeto aprovado" (seta estes campos + status entregue); superior confirma
  /// (status aprovado) ou recusa (limpa). Substitui a validação por-arquivo nesses tipos.
  aprovacaoSolicitadaEm    DateTime?
  aprovacaoSolicitadaPorId String?

  responsaveis            DisciplinaResponsavel[]
  revisoes                RevisaoDisciplina[]
  uploads                 Upload[]
  pastas                  PastaProjeto[]
  pagamentos              PagamentoProjetista[]
  canais                  Canal[]
  eapTarefas              EapTarefa[]
  pranchas                Prancha[]
  solicitacoesRevisao     SolicitacaoRevisao[]
  calculosFerramenta      CalculoFerramenta[]
  tarefas                 Tarefa[]
  diarioEntradas          DiarioEntrada[]
  arts                    Art[]
  apontamentosCoordenacao ApontamentoCoordenacao[]
  documentos              DocumentoDisciplina[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projetoId])
  @@index([status])
  @@index([disciplinaId])
  @@map("disciplina")
  apontamentosPadrao  ApontamentoPadrao[]
}

/// Diário de projeto por disciplina: projetistas registram a evolução diária dos
/// trabalhos. Escrita = responsável da disciplina (ou admin/supervisor); leitura =
/// equipe interna do projeto (cliente nunca vê). Autor edita/exclui a própria entrada.
model DiarioEntrada {
  id           String     @id @default(cuid())
  projetoId    String
  projeto      Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  autorId      String
  autor        User       @relation("DiarioAutor", fields: [autorId], references: [id])
  /// Dia a que a entrada se refere (o autor pode registrar um dia anterior).
  data         DateTime   @db.Date
  texto        String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([disciplinaId, data])
  @@index([projetoId, data])
  @@map("diario_entrada")
}

enum StatusSolicRevisao {
  pendente
  aceita
  recusada
}

/// Pedido formal de revisão de uma disciplina (workflow), com anexo opcional (B2).
model SolicitacaoRevisao {
  id             String             @id @default(cuid())
  disciplinaId   String
  disciplina     Disciplina         @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  solicitanteId  String
  motivo         String
  status         StatusSolicRevisao @default(pendente)
  respostaMotivo String?
  anexoPath      String?
  anexoNome      String?
  createdAt      DateTime           @default(now())
  respondidoEm   DateTime?

  @@index([disciplinaId])
  @@map("solicitacao_revisao")
}

/// Composição de preço detalhada do projeto (memória de cálculo) (B3).
model ProjetoComposicaoPreco {
  id         String                @id @default(cuid())
  projetoId  String                @unique
  projeto    Projeto               @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  observacao String?
  updatedAt  DateTime              @updatedAt
  itens      ItemComposicaoPreco[]

  @@map("projeto_composicao_preco")
}

model ItemComposicaoPreco {
  id            String                 @id @default(cuid())
  composicaoId  String
  composicao    ProjetoComposicaoPreco @relation(fields: [composicaoId], references: [id], onDelete: Cascade)
  descricao     String
  quantidade    Decimal                @default(1) @db.Decimal(12, 2)
  valorUnitario Decimal                @default(0) @db.Decimal(14, 2)
  ordem         Int                    @default(0)

  @@index([composicaoId])
  @@map("item_composicao_preco")
}

/// Configuração de Lista de Materiais (BIM) do projeto — texto livre (B4).
model LmConfig {
  id        String   @id @default(cuid())
  projetoId String   @unique
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  conteudo  String   @default("")
  updatedAt DateTime @updatedAt

  @@map("lm_config")
}

/// Linha de base do cronograma: snapshot nomeado das datas da EAP (B5).
model LinhaBase {
  id        String   @id @default(cuid())
  projetoId String
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  nome      String
  /// Snapshot [{ id, nome, inicio, fim }] das tarefas da EAP no momento.
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([projetoId])
  @@map("linha_base")
}

enum StatusOportunidade {
  aberta
  ganha
  perdida
}

/// Oportunidade comercial (estágio entre Lead e Proposta) com atividades próprias (C1).
model Oportunidade {
  id            String                  @id @default(cuid())
  titulo        String
  /// FK escalar (resolvido por lookup) p/ não inflar Cliente.
  clienteId     String?
  valorEstimado Decimal?                @db.Decimal(14, 2)
  etapa         String                  @default("qualificacao")
  status        StatusOportunidade      @default(aberta)
  responsavelId String?
  observacao    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  atividades    AtividadeOportunidade[]

  @@index([status])
  @@map("oportunidade")
}

model AtividadeOportunidade {
  id             String       @id @default(cuid())
  oportunidadeId String
  oportunidade   Oportunidade @relation(fields: [oportunidadeId], references: [id], onDelete: Cascade)
  tipo           String       @default("nota")
  descricao      String
  autorId        String
  createdAt      DateTime     @default(now())

  @@index([oportunidadeId])
  @@map("atividade_oportunidade")
}

// PropostaAnexo (C2) foi absorvido por `Documento` (docs do cliente, §Documentos do cliente).
// Os anexos existentes são migrados na migration `documentos_cliente`.

model DisciplinaResponsavel {
  id           String     @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  @@unique([disciplinaId, userId])
  @@index([userId])
  @@map("disciplina_responsavel")
}

/// Log imutável de revisões (RV00, RV01…) por disciplina.
model RevisaoDisciplina {
  id           String     @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  numero       Int // 0 = RV00
  motivo       String?
  autorId      String
  autor        User       @relation(fields: [autorId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([disciplinaId, numero])
  @@index([disciplinaId])
  @@map("revisao_disciplina")
}

// ─────────────────────────────────────────────────────────────
// Uploads & Validação → Pagamento (Onda 1)
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// Tarefas (Onda 5a)
// ─────────────────────────────────────────────────────────────

model TarefaStatus {
  id        String  @id @default(cuid())
  nome      String  @unique
  ordem     Int     @default(0)
  cor       String?
  /// Coluna final: tarefas aqui contam como concluídas (libera dependentes).
  concluido Boolean @default(false)
  ativo     Boolean @default(true)

  tarefas Tarefa[]

  @@map("tarefa_status")
}

model Tarefa {
  id           String       @id @default(cuid())
  titulo       String
  descricao    String?
  statusId     String
  status       TarefaStatus @relation(fields: [statusId], references: [id])
  prazo        DateTime?    @db.Date
  /// Prioridade (baixa|media|alta|urgente). String livre p/ não exigir enum (igual a TicketSuporte).
  prioridade   String?
  projetoId    String?
  projeto      Projeto?     @relation(fields: [projetoId], references: [id])
  /// Disciplina do projeto à qual a tarefa pertence (aparece dentro dela na ficha do projeto).
  disciplinaId String?
  disciplina   Disciplina?  @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  criadorId    String
  criador      User         @relation("TarefaCriador", fields: [criadorId], references: [id])
  arquivada    Boolean      @default(false)
  /// Item 7: data em que a tarefa entrou num status final (concluída). Métrica de produtividade.
  concluidaEm  DateTime?
  /// Origem na EAP (P-32): evita gerar a mesma Tarefa operacional duas vezes.
  eapTarefaId  String?      @unique

  responsaveis TarefaResponsavel[]
  itens        TarefaItem[]
  dependeDe    TarefaDependencia[] @relation("Dependente")
  dependentes  TarefaDependencia[] @relation("DependeDe")
  comentarios  TarefaComentario[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statusId, arquivada])
  @@index([projetoId])
  @@index([disciplinaId])
  @@map("tarefa")
}

model TarefaResponsavel {
  id       String @id @default(cuid())
  tarefaId String
  tarefa   Tarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id])

  @@unique([tarefaId, userId])
  @@map("tarefa_responsavel")
}

model TarefaItem {
  id        String  @id @default(cuid())
  tarefaId  String
  tarefa    Tarefa  @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  descricao String
  concluido Boolean @default(false)
  ordem     Int     @default(0)

  @@index([tarefaId])
  @@map("tarefa_item")
}

model TarefaDependencia {
  id          String @id @default(cuid())
  tarefaId    String
  tarefa      Tarefa @relation("Dependente", fields: [tarefaId], references: [id], onDelete: Cascade)
  dependeDeId String
  dependeDe   Tarefa @relation("DependeDe", fields: [dependeDeId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, dependeDeId])
  @@map("tarefa_dependencia")
}

// ─────────────────────────────────────────────────────────────
// Jurídico (Onda 5b)
// ─────────────────────────────────────────────────────────────

model DocumentoJuridico {
  id         String         @id @default(cuid())
  titulo     String
  /// contrato | aditivo | proposta | procuracao | outro
  tipo       String         @default("contrato")
  projetoId  String?
  projeto    Projeto?       @relation(fields: [projetoId], references: [id])
  clienteId  String?
  cliente    Cliente?       @relation(fields: [clienteId], references: [id])
  pastaId    String?
  pasta      PastaJuridica? @relation(fields: [pastaId], references: [id], onDelete: SetNull)
  observacao String?
  createdAt  DateTime       @default(now())

  versoes DocJuridicoVersao[]

  @@index([projetoId])
  @@index([pastaId])
  @@map("documento_juridico")
}

/// Pasta (árvore) para organizar documentos jurídicos.
model PastaJuridica {
  id         String              @id @default(cuid())
  nome       String
  parentId   String?
  parent     PastaJuridica?      @relation("PastaArvore", fields: [parentId], references: [id], onDelete: SetNull)
  filhas     PastaJuridica[]     @relation("PastaArvore")
  documentos DocumentoJuridico[]
  ordem      Int                 @default(0)
  createdAt  DateTime            @default(now())

  @@index([parentId])
  @@map("pasta_juridica")
}

/// Documento (com versões) de um projeto — repositório geral, separado dos pacotes A/B de Upload.
// Repositório "Geral" do projeto (antigo ArquivoProjeto/ArquivoProjetoVersao) foi
// absorvido pelo model Documento (origem=interno) na Fase 5a — ver migração
// 20260705_documentos_geral e o plano 2026-07-05-documentos-fase5a-geral.md.

// ─────────────────────────────────────────────────────────────
// Documentos do cliente (Cliente → Proposta → Projeto)
// Material recebido de externos + docs que seguem o cliente. Ancora na Proposta
// (comercial) e/ou no Projeto; o Cliente é o dono. O Projeto gerado no aceite
// herda os docs da sua Proposta por consulta (join Proposta.projetoId) — sem cópia,
// sem mistura entre projetos irmãos. Absorve o antigo PropostaAnexo.
// Spec: docs/superpowers/plans/2026-07-05-recebidos-documentos-cliente.md
// ─────────────────────────────────────────────────────────────

enum OrigemDocumento {
  recebido_cliente // externo enviou (proposta/portal/link)
  interno // equipe subiu p/ compartilhar
  contrato
  comercial
  /// Referência fixa por projeto (ex.: base do arquiteto), visível a todas as
  /// disciplinas como "Recebidos do cliente", mas em pasta própria — ver
  /// `baseArquitetonicaDoProjeto` em modules/documentos-cliente/queries.ts.
  base_arquitetonica
}

enum CanalDocumento {
  interno
  portal
  link
}

model Documento {
  id                String            @id @default(cuid())
  clienteId         String // dono (denormalizado p/ ficha do cliente + escopo do portal)
  cliente           Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  propostaId        String? // âncora comercial
  proposta          Proposta?         @relation(fields: [propostaId], references: [id], onDelete: SetNull)
  projetoId         String? // âncora de projeto (docs criados já na fase de projeto)
  projeto           Projeto?          @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  origem            OrigemDocumento   @default(recebido_cliente)
  canal             CanalDocumento    @default(interno)
  nome              String
  categoria         String?
  descricao         String?
  /// Documento do "Geral" (origem=interno) marcado p/ também aparecer em "Recebidos
  /// do cliente" — assim projetistas sem `arquivos_gerais:ver` conseguem visualizar,
  /// sem copiar o arquivo em disco. Só faz efeito quando origem=interno.
  exibirEmRecebidos Boolean           @default(false)
  autorId           String? // null quando veio de link público sem user interno
  autor             User?             @relation("DocumentoAutor", fields: [autorId], references: [id])
  enviadoPor        String? // nome digitado no link/portal (proveniência externa)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  versoes           DocumentoVersao[]

  @@index([clienteId])
  @@index([propostaId])
  @@index([projetoId])
  @@map("documento")
}

model DocumentoVersao {
  id          String    @id @default(cuid())
  documentoId String
  documento   Documento @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  numero      Int
  caminho     String
  nomeArquivo String
  mime        String
  tamanho     Int
  hashSha256  String
  autorId     String?
  createdAt   DateTime  @default(now())

  /// Coordenação BIM: quando esta versão é um IFC (recebido do cliente), guarda o
  /// estado da conversão para Fragments (.frag) — mesma tabela dos IFCs de disciplina.
  conversao        ConversaoModelo?
  /// Visualizador DWG: quando esta versão é um DWG (recebido do cliente), guarda o
  /// estado da conversão para DXF — mesma tabela dos DWGs de disciplina.
  conversaoDesenho ConversaoDesenho?

  @@unique([documentoId, numero])
  @@index([documentoId])
  @@map("documento_versao")
}

/// Documento de RH de um colaborador (contrato, RG, ASO, diploma…).
model FuncionarioDocumento {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("FuncDocumentos", fields: [userId], references: [id], onDelete: Cascade)
  /// contrato | rg | cpf | aso | diploma | comprovante | outro
  tipo        String   @default("outro")
  nome        String
  caminho     String
  nomeArquivo String
  mime        String
  tamanho     Int
  hashSha256  String
  autorId     String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("funcionario_documento")
}

model DocJuridicoVersao {
  id          String            @id @default(cuid())
  documentoId String
  documento   DocumentoJuridico @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  numero      Int
  arquivoPath String
  arquivoNome String
  autorId     String
  autor       User              @relation(fields: [autorId], references: [id])
  createdAt   DateTime          @default(now())

  aceites AceiteDocumento[]

  @@unique([documentoId, numero])
  @@map("doc_juridico_versao")
}

/// Registro de aceite/assinatura interna (on-prem) de uma versão de documento jurídico:
/// snapshot de quem assinou, quando, e o hash SHA-256 do arquivo no momento do aceite.
model AceiteDocumento {
  id          String            @id @default(cuid())
  versaoId    String
  versao      DocJuridicoVersao @relation(fields: [versaoId], references: [id], onDelete: Cascade)
  userId      String
  userNome    String
  hashArquivo String
  assinadoEm  DateTime          @default(now())

  @@index([versaoId])
  @@map("aceite_documento")
}

model CertidaoTipo {
  id          String     @id @default(cuid())
  nome        String     @unique
  /// Tipo obrigatório p/ o checklist de compliance (módulo certidões) — não afeta dado existente.
  obrigatoria Boolean    @default(false)

  certidoes Certidao[]

  @@map("certidao_tipo")
}

model Certidao {
  id               String                     @id @default(cuid())
  tipoId           String
  tipo             CertidaoTipo               @relation(fields: [tipoId], references: [id])
  descricao        String?
  validade         DateTime                   @db.Date
  arquivoPath      String?
  arquivoNome      String?
  responsavelId    String?
  responsavel      User?                      @relation("CertidaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  createdAt        DateTime                   @default(now())
  versoes          CertidaoVersao[]
  habilitacaoItens LicitacaoHabilitacaoItem[]

  @@index([validade])
  @@index([responsavelId])
  @@map("certidao")
}

/// Versão histórica de uma certidão (E3). Cada upload (anexo inicial ou renovação) cria a sua.
model CertidaoVersao {
  id          String   @id @default(cuid())
  certidaoId  String
  certidao    Certidao @relation(fields: [certidaoId], references: [id], onDelete: Cascade)
  numero      Int
  validade    DateTime @db.Date
  arquivoPath String?
  arquivoNome String?
  mimeType    String?
  autorId     String
  createdAt   DateTime @default(now())

  @@unique([certidaoId, numero])
  @@map("certidao_versao")
}

/// Link público (sem login) somente-leitura de certidões, p/ terceiros (contador, advogado).
/// Mesma convenção de LinkPublicoArquivos: `ativo`/`expiraEm` revogam na hora, whitelist
/// `certidaoIds` escopa o que é visível — vazio = nada exposto. Standalone (não é 1:1 de nada).
model LinkPublicoCertidoes {
  id          String    @id @default(cuid())
  token       String    @unique
  ativo       Boolean   @default(true)
  expiraEm    DateTime?
  certidaoIds String[]  @default([])
  criadoPorId String?
  createdAt   DateTime  @default(now())

  @@map("link_publico_certidoes")
}

// ─────────────────────────────────────────────────────────────
// Licitações (Onda 5c)
// ─────────────────────────────────────────────────────────────

enum StatusLicitacao {
  em_andamento
  ganha
  perdida
  em_execucao
  concluida
}

enum TipoEventoLicitacao {
  abertura
  sessao
  resultado
  assinatura
  vigencia_inicio
  vigencia_fim
  // P1-B — recursos/impugnações reusam a mesma tabela
  pedido_esclarecimento
  impugnacao
  recurso
  contrarrazao
}

model Licitacao {
  id                   String          @id @default(cuid())
  titulo               String
  orgao                String?
  modalidade           String?
  numeroEdital         String?
  prazoProposta        DateTime?       @db.Date
  valorEstimado        Decimal?        @db.Decimal(14, 2)
  /// % máximo de subcontratação permitido pelo edital (por certame).
  subcontratacaoMaxPct Decimal?        @db.Decimal(5, 2)
  status               StatusLicitacao @default(em_andamento)
  observacoes          String?
  /// Projeto criado ao importar (status vira em_execucao).
  projetoId            String?         @unique
  projeto              Projeto?        @relation(fields: [projetoId], references: [id])

  /// PNCP — número de controle do edital/contrato.
  numeroControlePNCP String?
  pncpUrl            String?
  origemPNCP         Boolean   @default(false)
  publicadoPNCPEm    DateTime?

  docs                 DocumentoLicitacao[]
  medicoes             MedicaoLicitacao[]
  historico            LicitacaoHistorico[]
  valoresDisciplina    DisciplinaValorLicitacao[]
  eventos              LicitacaoEvento[]
  composicao           LicitacaoComposicaoPreco?
  contrato             ContratoLicitacao?
  habilitacao          LicitacaoHabilitacaoItem[]
  responsaveisTecnicos LicitacaoResponsavelTecnico[]
  subcontratacoes      SubcontratacaoLicitacao[]
  resultado            ResultadoLicitacao?
  viabilidade          ViabilidadeLicitacao?
  pncpLogs             IntegracaoPNCPLog[]
  /// Ponte reservada com Engenharia de Custos (D4) — sem uso funcional na Onda C0.
  orcamentosCusto      CustoOrcamento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("licitacao")
}

/// Evento na timeline de uma licitação (E4).
model LicitacaoHistorico {
  id          String    @id @default(cuid())
  licitacaoId String
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  descricao   String
  autorId     String?
  createdAt   DateTime  @default(now())

  @@index([licitacaoId])
  @@map("licitacao_historico")
}

/// Evento datado de uma licitação: datas-chave por fase (Item 1-B) e peças de recurso/impugnação (P1-B).
model LicitacaoEvento {
  id          String              @id @default(cuid())
  licitacaoId String
  licitacao   Licitacao           @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  tipo        TipoEventoLicitacao
  data        DateTime            @db.Date
  /// Antecedências (em dias) para alerta; vazio = usa o padrão da config.
  alertaDias  Int[]               @default([])
  /// Para peças de recurso (P1): "propria" | "concorrente"; null para datas-chave.
  autoria     String?
  protocolo   String?
  observacao  String?
  /// Quando o evento já ocorreu/foi cumprido (some dos alertas).
  concluidoEm DateTime?
  createdAt   DateTime            @default(now())

  @@index([licitacaoId])
  @@index([data])
  @@map("licitacao_evento")
}

/// Dedup persistente dos alertas automáticos de licitação por destinatário.
model AlertaLicitacaoEnviado {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chave         String
  notificacaoId String?      @unique
  notificacao   Notificacao? @relation(fields: [notificacaoId], references: [id], onDelete: SetNull)
  enviadoEm     DateTime     @default(now())

  @@unique([userId, chave])
  @@index([enviadoEm])
  @@map("alerta_licitacao_enviado")
}

/// Valor por disciplina dentro de uma licitação/edital (E5).
model DisciplinaValorLicitacao {
  id          String    @id @default(cuid())
  licitacaoId String
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  disciplina  String
  valor       Decimal   @db.Decimal(14, 2)

  @@index([licitacaoId])
  @@map("disciplina_valor_licitacao")
}

/// Composição de preço da proposta da licitação (Item 2-A). Espelha ProjetoComposicaoPreco; copiada ao projeto no import.
model LicitacaoComposicaoPreco {
  id          String                    @id @default(cuid())
  licitacaoId String                    @unique
  licitacao   Licitacao                 @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  observacao  String?
  updatedAt   DateTime                  @updatedAt
  itens       ItemComposicaoLicitacao[]

  @@map("licitacao_composicao_preco")
}

model ItemComposicaoLicitacao {
  id            String                   @id @default(cuid())
  composicaoId  String
  composicao    LicitacaoComposicaoPreco @relation(fields: [composicaoId], references: [id], onDelete: Cascade)
  descricao     String
  quantidade    Decimal                  @default(1) @db.Decimal(12, 2)
  valorUnitario Decimal                  @default(0) @db.Decimal(14, 2)
  ordem         Int                      @default(0)

  @@index([composicaoId])
  @@map("item_composicao_licitacao")
}

model DocumentoLicitacao {
  id          String    @id @default(cuid())
  licitacaoId String
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  titulo      String

  versoes DocLicitacaoVersao[]

  @@index([licitacaoId])
  @@map("documento_licitacao")
}

model DocLicitacaoVersao {
  id          String             @id @default(cuid())
  documentoId String
  documento   DocumentoLicitacao @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  numero      Int
  arquivoPath String
  arquivoNome String
  autorId     String
  autor       User               @relation(fields: [autorId], references: [id])
  createdAt   DateTime           @default(now())

  @@unique([documentoId, numero])
  @@map("doc_licitacao_versao")
}

/// Medição → vira Lançamento de receita (1.02) previsto.
model MedicaoLicitacao {
  id           String    @id @default(cuid())
  licitacaoId  String
  licitacao    Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  numero       Int
  descricao    String?
  valor        Decimal   @db.Decimal(14, 2)
  data         DateTime  @db.Date
  lancamentoId String?   @unique

  @@unique([licitacaoId, numero])
  @@map("medicao_licitacao")
}

/// Modalidade de licitação — lista configurável (config-driven, editável em Configurações).
model Modalidade {
  id        String   @id @default(cuid())
  nome      String   @unique
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("modalidade")
}

/// Log de integração com o PNCP (import de editais / publicação de contrato).
model IntegracaoPNCPLog {
  id          String     @id @default(cuid())
  /// "import" | "publicacao"
  direcao     String
  referencia  String?
  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id], onDelete: SetNull)
  /// "ok" | "erro"
  status      String
  mensagem    String?
  payload     Json?
  createdAt   DateTime   @default(now())

  @@index([licitacaoId])
  @@map("integracao_pncp_log")
}

/// Modelo reutilizável de checklist de habilitação (global, editável em Configurações).
model ChecklistHabilitacaoModelo {
  id        String                           @id @default(cuid())
  nome      String                           @unique
  ativo     Boolean                          @default(true)
  ordem     Int                              @default(0)
  itens     ChecklistHabilitacaoModeloItem[]
  createdAt DateTime                         @default(now())

  @@map("checklist_habilitacao_modelo")
}

model ChecklistHabilitacaoModeloItem {
  id          String                     @id @default(cuid())
  modeloId    String
  modelo      ChecklistHabilitacaoModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  exigencia   String
  obrigatorio Boolean                    @default(true)
  ordem       Int                        @default(0)

  @@index([modeloId])
  @@map("checklist_habilitacao_modelo_item")
}

/// Item do checklist de habilitação de uma licitação (instância). Pode apontar p/ uma Certidao da empresa.
model LicitacaoHabilitacaoItem {
  id          String    @id @default(cuid())
  licitacaoId String
  licitacao   Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  exigencia   String
  certidaoId  String?
  certidao    Certidao? @relation(fields: [certidaoId], references: [id])
  atendido    Boolean   @default(false)
  obrigatorio Boolean   @default(true)
  observacao  String?
  ordem       Int       @default(0)

  @@index([licitacaoId])
  @@index([certidaoId])
  @@map("licitacao_habilitacao_item")
}

/// Responsável técnico (CREA/CAU) — global; pode ser colaborador interno (userId).
model ResponsavelTecnico {
  id         String                        @id @default(cuid())
  nome       String
  registro   String
  /// "CREA" | "CAU" | outro
  conselho   String?
  userId     String?                       @unique
  user       User?                         @relation(fields: [userId], references: [id])
  ativo      Boolean                       @default(true)
  createdAt  DateTime                      @default(now())
  licitacoes LicitacaoResponsavelTecnico[]

  @@map("responsavel_tecnico")
}

/// Vínculo RT ↔ licitação com o documento comprobatório (ART/RRT/CAT).
model LicitacaoResponsavelTecnico {
  id              String             @id @default(cuid())
  licitacaoId     String
  licitacao       Licitacao          @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  responsavelId   String
  responsavel     ResponsavelTecnico @relation(fields: [responsavelId], references: [id], onDelete: Cascade)
  /// "ART" | "RRT" | "CAT"
  documentoTipo   String
  numeroDocumento String?
  arquivoPath     String?
  arquivoNome     String?
  createdAt       DateTime           @default(now())

  @@unique([licitacaoId, responsavelId, documentoTipo])
  @@index([responsavelId])
  @@map("licitacao_responsavel_tecnico")
}

/// Subcontratado de uma licitação (P6). Percentual validado contra subcontratacaoMaxPct do edital.
model SubcontratacaoLicitacao {
  id           String      @id @default(cuid())
  licitacaoId  String
  licitacao    Licitacao   @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])
  nomeLivre    String?
  objeto       String
  percentual   Decimal     @db.Decimal(5, 2)

  @@index([licitacaoId])
  @@map("subcontratacao_licitacao")
}

/// Contrato/empenho pós-ganha (Item 3-B). valorHomologado pode diferir do estimado; aditivos ajustam.
model ContratoLicitacao {
  id                  String             @id @default(cuid())
  licitacaoId         String             @unique
  licitacao           Licitacao          @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  numeroContrato      String?
  numeroEmpenho       String?
  valorHomologado     Decimal            @db.Decimal(14, 2)
  /// Valor homologado INICIAL (pré-reajustes). Denominador do % de acréscimo de aditivo (Lei 14.133 art.125). Null = usar valorHomologado.
  valorHomologadoBase Decimal?           @db.Decimal(14, 2)
  vigenciaInicio      DateTime?          @db.Date
  vigenciaFim         DateTime?          @db.Date
  /// Regra/índice de reajuste em texto (estruturado vem na Fase 4).
  reajuste            String?
  garantiaTipo        String?
  garantiaValor       Decimal?           @db.Decimal(14, 2)
  garantiaValidade    DateTime?          @db.Date
  /// % limite de acréscimo (P2). Null = usa padrão da config licitacoes.config.
  limiteAcrescimoPct  Decimal?           @db.Decimal(5, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  aditivos            AditivoContrato[]
  riscos              MatrizRiscoItem[]
  reajustes           ReajusteContrato[]

  @@map("contrato_licitacao")
}

/// Termo aditivo de contrato (valor/prazo/objeto). valorDelta +/- ajusta o valor vigente.
model AditivoContrato {
  id            String            @id @default(cuid())
  contratoId    String
  contrato      ContratoLicitacao @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  /// "valor" | "prazo" | "valor_prazo" | "objeto"
  tipo          String
  valorDelta    Decimal?          @db.Decimal(14, 2)
  novaVigencia  DateTime?         @db.Date
  justificativa String?
  data          DateTime          @db.Date
  createdAt     DateTime          @default(now())

  @@index([contratoId])
  @@map("aditivo_contrato")
}

/// Item da matriz de risco do contrato (P4-B). Obras/serviços de engenharia (Lei 14.133).
model MatrizRiscoItem {
  id            String            @id @default(cuid())
  contratoId    String
  contrato      ContratoLicitacao @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  evento        String
  /// "baixa" | "media" | "alta"
  probabilidade String
  /// "baixo" | "medio" | "alto"
  impacto       String
  /// "contratante" | "contratado"
  alocacao      String
  mitigacao     String?
  ordem         Int               @default(0)

  @@index([contratoId])
  @@map("matriz_risco_item")
}

/// Reajuste/repactuação do contrato por índice (P8). aplicadoEm null = pendente/sugerido.
model ReajusteContrato {
  id              String            @id @default(cuid())
  contratoId      String
  contrato        ContratoLicitacao @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  indice          String
  percentual      Decimal           @db.Decimal(6, 3)
  dataBase        DateTime?         @db.Date
  aniversario     DateTime          @db.Date
  valorAnterior   Decimal           @db.Decimal(14, 2)
  valorReajustado Decimal           @db.Decimal(14, 2)
  /// null = pendente (sugerido pelo modo automático); preenchido = aplicado.
  aplicadoEm      DateTime?
  createdAt       DateTime          @default(now())

  @@index([contratoId])
  @@index([aniversario])
  @@map("reajuste_contrato")
}

enum TipoSancao {
  advertencia
  multa
  suspensao
  impedimento
  inidoneidade
}

/// Sanção contra a própria empresa (compliance).
model SancaoPropria {
  id         String     @id @default(cuid())
  tipo       TipoSancao
  valor      Decimal?   @db.Decimal(14, 2)
  inicio     DateTime?  @db.Date
  fim        DateTime?  @db.Date
  orgao      String?
  processo   String?
  observacao String?
  createdAt  DateTime   @default(now())

  @@index([fim])
  @@map("sancao_propria")
}

/// Sanção contra concorrente (inteligência comercial).
model SancaoConcorrente {
  id           String      @id @default(cuid())
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])
  nomeLivre    String?
  tipo         TipoSancao
  valor        Decimal?    @db.Decimal(14, 2)
  inicio       DateTime?   @db.Date
  fim          DateTime?   @db.Date
  orgao        String?
  processo     String?
  observacao   String?
  createdAt    DateTime    @default(now())

  @@index([fim])
  @@map("sancao_concorrente")
}

/// Resultado/concorrência de uma licitação (quem ganhou, valor, nossa classificação).
model ResultadoLicitacao {
  id                 String    @id @default(cuid())
  licitacaoId        String    @unique
  licitacao          Licitacao @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  vencedor           String?
  valorVencedor      Decimal?  @db.Decimal(14, 2)
  nossaClassificacao Int?
  observacao         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("resultado_licitacao")
}

/// Viabilidade (go/no-go) de uma licitação. modo "fixo" usa os campos fixos; "configuravel" usa `criterios`.
model ViabilidadeLicitacao {
  id                   String                @id @default(cuid())
  licitacaoId          String                @unique
  licitacao            Licitacao             @relation(fields: [licitacaoId], references: [id], onDelete: Cascade)
  /// "fixo" | "configuravel"
  modo                 String                @default("fixo")
  margemEsperadaPct    Decimal?              @db.Decimal(5, 2)
  equipeDisponivel     Boolean?
  concorrenciaPrevista String?
  /// "pendente" | "go" | "no_go"
  decisao              String                @default("pendente")
  decididoPorId        String?
  decididoPor          User?                 @relation("ViabilidadeDecisor", fields: [decididoPorId], references: [id])
  decididoEm           DateTime?
  justificativa        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  criterios            ViabilidadeCriterio[]

  @@map("viabilidade_licitacao")
}

/// Critério livre de viabilidade (modo configurável).
model ViabilidadeCriterio {
  id            String               @id @default(cuid())
  viabilidadeId String
  viabilidade   ViabilidadeLicitacao @relation(fields: [viabilidadeId], references: [id], onDelete: Cascade)
  criterio      String
  atendido      Boolean              @default(false)
  observacao    String?
  ordem         Int                  @default(0)

  @@index([viabilidadeId])
  @@map("viabilidade_criterio")
}

// ─────────────────────────────────────────────────────────────
// Agenda (Onda 5d)
// ─────────────────────────────────────────────────────────────

model Compromisso {
  id        String    @id @default(cuid())
  titulo    String
  descricao String?
  local     String?
  inicio    DateTime
  fim       DateTime?
  criadorId String
  criador   User      @relation("CompromissoCriador", fields: [criadorId], references: [id])
  createdAt DateTime  @default(now())

  // ── Próxima Ação comercial (CRM F2.1b, ADR-17) ──────────────────────────
  /// Âncora polimórfica, SEM FK — mesmo padrão de ApontamentoCoordenacao/Pendencia (a entidade
  /// referenciada pode ser Lead, Negociacao ou Cliente, e nenhuma FK única cobriria as três).
  /// Os dois null = compromisso de agenda comum, exatamente como hoje. TUDO nesta seção é
  /// nullable de propósito: é 100% aditivo, nenhum Compromisso existente muda de significado.
  entidadeTipo TipoAncoraCompromisso?
  entidadeId   String?

  /// null = compromisso de agenda (comportamento atual, sem mudança). Preenchido = ação
  /// comercial. É o campo que `modules/agenda` passa a filtrar (F2.1a) ANTES de qualquer
  /// escrita real chegar aqui (F2.10) — a UI e a query já sabem separar antes do volume entrar.
  tipo TipoProximaAcao?

  concluidoEm  DateTime?
  concluidoPor String?

  participantes CompromissoParticipante[]

  @@index([inicio])
  @@index([entidadeTipo, entidadeId])
  @@index([tipo, concluidoEm])
  @@map("compromisso")
}

/// Tipo de entidade que uma Próxima Ação comercial referencia (CRM F2.1b, ADR-17).
enum TipoAncoraCompromisso {
  LEAD
  NEGOCIACAO
  CLIENTE
}

/// Tipo de Próxima Ação comercial (CRM F2.1b, ADR-17, lista do P11 item 3).
enum TipoProximaAcao {
  LIGACAO
  WHATSAPP
  EMAIL
  LINKEDIN
  REUNIAO
  FOLLOW_UP
  COBRAR_DOCUMENTACAO
  COBRAR_ARQUITETURA
  ENVIAR_PROPOSTA
  REVISAR_PROPOSTA
  RETORNO_AO_CLIENTE
  OUTRO
}

model CompromissoParticipante {
  id            String      @id @default(cuid())
  compromissoId String
  compromisso   Compromisso @relation(fields: [compromissoId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  /// null = pendente, true = confirmado, false = recusou
  confirmado    Boolean?

  @@unique([compromissoId, userId])
  @@map("compromisso_participante")
}

// ─────────────────────────────────────────────────────────────
// Qualidade (Onda 5e)
// ─────────────────────────────────────────────────────────────

/// Foto mensal do índice de retrabalho (revisões por disciplina).
model QualidadeSnapshot {
  id               String  @id @default(cuid())
  ano              Int
  mes              Int
  /// % de disciplinas com ao menos 1 revisão (RV>0).
  indice           Decimal @db.Decimal(5, 2)
  totalDisciplinas Int
  comRevisao       Int

  createdAt DateTime @default(now())

  @@unique([ano, mes])
  @@map("qualidade_snapshot")
}

/// Foto diária dos KPIs do dashboard (série histórica). Idempotente por dia.
model DashboardSnapshot {
  id                String   @id @default(cuid())
  dia               DateTime @unique @db.Date
  projetosAtivos    Int
  receitaPrevista   Decimal  @db.Decimal(14, 2)
  entregasPendentes Int
  recebidoNoMes     Decimal  @db.Decimal(14, 2)
  createdAt         DateTime @default(now())

  @@map("dashboard_snapshot")
}

// ─────────────────────────────────────────────────────────────
// Suporte (Onda 5f)
// ─────────────────────────────────────────────────────────────

enum StatusTicket {
  aberto
  em_atendimento
  resolvido
}

model TicketSuporte {
  id         String       @id @default(cuid())
  titulo     String
  descricao  String
  status     StatusTicket @default(aberto)
  /// Prioridade do ticket (ex.: baixa | media | alta | urgente). Livre p/ não exigir enum.
  prioridade String?
  /// Categoria do ticket (ex.: bug | duvida | melhoria | acesso).
  categoria  String?
  autorId    String
  autor      User         @relation("TicketAutor", fields: [autorId], references: [id])
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  mensagens TicketMensagem[]

  @@index([status])
  @@map("ticket_suporte")
}

model TicketMensagem {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    TicketSuporte @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User          @relation("TicketMensagemAutor", fields: [autorId], references: [id])
  texto     String        @default("")
  anexoPath String?
  anexoNome String?
  anexoMime String?
  createdAt DateTime      @default(now())

  @@index([ticketId])
  @@map("ticket_mensagem")
}

// ─────────────────────────────────────────────────────────────
// Planejamento & Recursos (Onda 5)
// ─────────────────────────────────────────────────────────────

/// Tarefa da EAP (WBS) de um projeto — hierárquica, com datas previstas
/// (plano atual) e de linha de base (snapshot p/ o gantt de linha dupla).
model EapTarefa {
  id             String      @id @default(cuid())
  projetoId      String
  projeto        Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         EapTarefa?  @relation("EapFilhas", fields: [parentId], references: [id], onDelete: Cascade)
  filhas         EapTarefa[] @relation("EapFilhas")
  disciplinaId   String?
  disciplina     Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  nome           String
  ordem          Int         @default(0)
  inicioPrevisto DateTime    @db.Date
  fimPrevisto    DateTime    @db.Date
  inicioBaseline DateTime?   @db.Date
  fimBaseline    DateTime?   @db.Date
  progresso      Int         @default(0)
  marco          Boolean     @default(false)

  predecessoras EapDependencia[] @relation("EapDependente")
  sucessoras    EapDependencia[] @relation("EapPredecessora")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projetoId])
  @@index([parentId])
  @@map("eap_tarefa")
}

/// Dependência FS entre tarefas da EAP (predecessora termina antes da sucessora iniciar).
model EapDependencia {
  id             String    @id @default(cuid())
  tarefaId       String
  tarefa         EapTarefa @relation("EapDependente", fields: [tarefaId], references: [id], onDelete: Cascade)
  predecessoraId String
  predecessora   EapTarefa @relation("EapPredecessora", fields: [predecessoraId], references: [id], onDelete: Cascade)

  @@unique([tarefaId, predecessoraId])
  @@index([predecessoraId])
  @@map("eap_dependencia")
}

/// Pessoa como recurso de planejamento (multiplicador de capacidade, custo/hora, cor).
model Recurso {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capacidade Decimal  @default(1.0) @db.Decimal(4, 2)
  custoHora  Decimal? @db.Decimal(10, 2)
  cor        String   @default("#576980")
  ativo      Boolean  @default(true)

  alocacoes Alocacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recurso")
}

/// Alocação de um recurso a um projeto (percentual + período opcional). Base da matriz de recursos.
model Alocacao {
  id         String    @id @default(cuid())
  recursoId  String
  recurso    Recurso   @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  projetoId  String
  projeto    Projeto   @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  percentual Int       @default(100)
  inicio     DateTime? @db.Date
  fim        DateTime? @db.Date
  observacao String?

  createdAt DateTime @default(now())

  @@unique([recursoId, projetoId])
  @@index([projetoId])
  @@map("alocacao")
}

// ─────────────────────────────────────────────────────────────
// Comercial / CRM (Onda 4)
// ─────────────────────────────────────────────────────────────

/// Etapa do funil de vendas (Kanban configurável).
model FunilEtapa {
  id    String  @id @default(cuid())
  nome  String  @unique
  ordem Int     @default(0)
  cor   String?
  ativo Boolean @default(true)

  leads Lead[]

  @@map("funil_etapa")
}

model Lead {
  id            String     @id @default(cuid())
  nome          String
  contato       String?
  email         String?
  telefone      String?
  origem        String?
  valorEstimado Decimal?   @db.Decimal(14, 2)

  // ── F2.3: funil de prospecção vira enum fixo (ADR-01/16, 02-schema §2.3 e §8.3) ──────
  /// Estágio da prospecção. Substitui `etapaId`/`FunilEtapa` (abaixo, DEPRECADOS): enum fixo
  /// elimina de vez o `etapaEhPerdido()` por substring, que era dívida flagada na auditoria.
  /// `@default(IDENTIFICADO)` é o que preenche os leads existentes na migration — sem ele a
  /// coluna NOT NULL não poderia nascer numa tabela populada.
  status        StatusProspeccao @default(IDENTIFICADO)
  /// Marcado quando a classificação automática ficou ambígua e um humano precisa conferir
  /// (ADR-16). A F2.18 migra os 8 leads reais todos com `needsReview = true`.
  needsReview   Boolean          @default(false)

  // ── DEPRECADOS pela F2.3, mantidos por decisão (02-schema §8.3): não são apagados ──────
  /// DEPRECADO — use `status`. Mantido só para leitura do histórico pré-migração; a tabela
  /// `FunilEtapa` continua existindo e órfã até o CONTRACT. Continua NOT NULL porque toda
  /// linha atual tem valor e removê-lo agora seria mudança destrutiva sem ganho.
  etapaId       String
  etapa         FunilEtapa @relation(fields: [etapaId], references: [id])
  /// DEPRECADO — `arquivado` e `motivoPerda` (texto livre) são substituídos por `status`
  /// (SEM_OPORTUNIDADE/DESCARTADO) e pelo catálogo `MotivoPerda`. Ver §8.3.
  observacoes   String?
  motivoPerda   String?
  arquivado     Boolean    @default(false)

  /// ⚠️ ADR-01 diz "obrigatório", e AQUI ELE CONTINUA NULLABLE — desvio deliberado, mesmo
  /// padrão já decidido para `Proposta.negociacaoId` no P5: a obrigatoriedade mora na camada
  /// de aplicação, não numa constraint que quebraria o deploy.
  /// Motivo concreto: `criarLead` NUNCA preencheu este campo (não está nem no
  /// `criarLeadSchema`) — ele só é setado na conversão para cliente. Medido em 2026-08-20:
  /// **8 de 8 leads com `clienteId = NULL`**, em dev e, pela mesma razão, em produção.
  /// `ALTER COLUMN ... SET NOT NULL` falharia com "column contains null values".
  /// Sequência correta: F2.18 preenche os 8 à mão → depois disso, e só depois, uma migration
  /// de CONTRACT pode fechar a coluna. Fechar antes seria trocar um deploy que funciona por um
  /// que aborta.
  clienteId     String?
  cliente       Cliente?   @relation(fields: [clienteId], references: [id])
  /// Soft delete (ADR-11). Distinto de `arquivado`: arquivar tira do funil mas mantem o lead
  /// como registro vivo; excluir e remocao logica. Leituras top-level sao auto-filtradas pela
  /// extensao em `lib/prisma.ts`; as ANINHADAS (funil le leads via FunilEtapa) precisam do
  /// filtro explicito -- ver `funilCompleto`.
  excluidoEm    DateTime?

  // ── F1.23: atribuicao/origem estruturada, nao gate de permissao (ADR-15 revisado, Q4) ──
  /// So exibicao/atribuicao ("Meus x Todos", Fase 2) -- NUNCA usar para checagem de acesso.
  /// Backfill inicial em `scripts/backfill-lead-f123.ts` (nao ha `autorId` no lead nem
  /// `entidadeId` no AuditLog de `criarLead` para derivar isso automaticamente na migration).
  responsavelId String?
  responsavel   User?           @relation("LeadResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  canalId       String?
  canal         CanalAquisicao? @relation(fields: [canalId], references: [id])
  /// Complemento em texto livre ao canal (ex.: nome do empreendimento). Backfill: `origem` vira
  /// canal "Outro" + o texto original preservado aqui (docs/crm/03-migracao.md §3).
  origemDetalhada String?
  campaignId      String?
  campanha        Campanha? @relation(fields: [campaignId], references: [id])

  // ── F1.23a (ADR-19): indicacao mensuravel, escolhida de lista -- nunca texto livre ──
  parceiroId String?
  parceiro   Parceiro? @relation(fields: [parceiroId], references: [id])

  atividades AtividadeLead[]
  propostas  Proposta[]
  anexos     AnexoLead[]
  /// F2.3 (ADR-01): N contatos por prospecção. `Lead.contato` (texto livre) fica DEPRECADO,
  /// mantido como fallback de exibição para leads antigos sem contato estruturado.
  contatos   LeadContato[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([etapaId, arquivado])
  @@index([excluidoEm])
  @@index([responsavelId])
  @@index([canalId])
  @@index([campaignId])
  @@index([parceiroId])
  @@index([clienteId])
  @@index([status])
  @@index([createdAt])
  /// F2.4: a negociação nascida desta prospecção (1:1 opcional).
  negociacao Negociacao?
  @@map("lead")
}

/// NEGOCIAÇÃO (F2.4, ADR-04/06/13) — o estágio que hoje acontece inteiramente FORA do sistema.
/// Assume o papel que o model `Oportunidade` pretendia e nunca cumpriu (era órfão, sem FK para
/// Lead nem Proposta, 0 linhas em produção); nome novo justamente para não colidir com ele.
///
/// A separação prospecção (`Lead`) × negociação (`Negociacao`) é o ponto da Fase 2: qualificar
/// uma prospecção CRIA uma negociação e o Lead sobrevive apontando para ela (`leadId @unique`),
/// em vez de o registro mudar de natureza e perder o histórico de como chegou.
model Negociacao {
  id        String  @id @default(cuid())
  titulo    String
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])
  /// Origem, quando veio de uma prospecção qualificada. `@unique` garante que qualificar o
  /// mesmo lead duas vezes é recusado pelo banco, não só pela action (F2.8).
  leadId    String? @unique
  lead      Lead?   @relation(fields: [leadId], references: [id])

  /// Só exibição/atribuição, NUNCA gate de permissão (ADR-15 revisado) — igual ao `Lead`.
  /// Com `@relation` de verdade: o `Oportunidade` órfão guardava isto como string solta, e a
  /// auditoria (§10) apontou que isso quebra a integridade referencial que o resto do schema tem.
  responsavelId String?
  responsavel   User?   @relation("NegociacaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  tipoEmpreendimentoId String?
  tipoEmpreendimento   TipoEmpreendimento? @relation(fields: [tipoEmpreendimentoId], references: [id])
  areaM2               Decimal?            @db.Decimal(12, 2)

  valorEstimado  Decimal? @db.Decimal(14, 2)
  valorProposto  Decimal? @db.Decimal(14, 2)
  valorNegociado Decimal? @db.Decimal(14, 2)
  /// Percentual (0-100). A UI aceita valor OU percentual e converte antes de gravar.
  desconto       Decimal? @db.Decimal(14, 2)

  /// 0-100, populado a partir de `ProbabilidadeEstagio` no create e em cada transição.
  probabilidade         Int     @default(0)
  /// true = usuário sobrescreveu à mão; a partir daí a transição NÃO recalcula (ADR-12).
  probabilidadeOverride Boolean @default(false)

  temperatura Temperatura?
  estagio     EstagioNegociacao @default(LEVANTAMENTO)

  motivoPerdaId String?
  motivoPerdaRef MotivoPerda? @relation(fields: [motivoPerdaId], references: [id])
  /// Preenchido só quando `MotivoPerda.exigeConcorrente = true`.
  concorrente   String?

  previsaoFechamento DateTime?
  /// Preenchido quando `estagio` vira CONTRATADO ou PERDIDO.
  dataFechamento     DateTime?

  canalId    String?
  canal      CanalAquisicao? @relation(fields: [canalId], references: [id])
  campaignId String?
  campanha   Campanha?       @relation(fields: [campaignId], references: [id])
  /// F1.23a (ADR-19): a metade que faltou daquela tarefa — quando ela rodou, `Negociacao` ainda
  /// não existia. Indicação sempre escolhida de lista, nunca texto livre.
  parceiroId String?
  parceiro   Parceiro?       @relation(fields: [parceiroId], references: [id])

  /// ADR-16, mesma lógica do `Lead`: classificação ambígua espera conferência humana.
  needsReview Boolean @default(false)

  /// Soft delete (ADR-11). Registrado na extensão de `lib/prisma.ts`.
  excluidoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contatos    NegociacaoContato[]
  disciplinas NegociacaoDisciplina[]
  /// 1:N (ADR-06) — a FK mora no lado `Projeto` (ver §2.13). `Proposta[]` e `Atividade[]` NÃO
  /// entram aqui: `Proposta.negociacaoId` é da F5.2 e o model `Atividade` é da F3.1.
  projetos    Projeto[]

  @@index([clienteId])
  @@index([responsavelId])
  @@index([estagio])
  @@index([dataFechamento])
  @@index([canalId])
  @@index([campaignId])
  @@index([parceiroId])
  @@index([createdAt])
  @@index([excluidoEm])
  @@map("negociacao")
}

/// Junção Negociacao ↔ ContatoCliente (F2.4). O P9 item 2 pede a negociação vinculada a Empresa
/// **e contatos** — sem esta tabela o requisito não fecha.
model NegociacaoContato {
  id           String         @id @default(cuid())
  negociacaoId String
  negociacao   Negociacao     @relation(fields: [negociacaoId], references: [id], onDelete: Cascade)
  contatoId    String
  contato      ContatoCliente @relation(fields: [contatoId], references: [id])
  principal    Boolean        @default(false)

  @@unique([negociacaoId, contatoId])
  @@index([contatoId])
  @@map("negociacao_contato")
}

/// Junção Negociacao ↔ DisciplinaCatalogo (F2.4, ADR-13). Reaproveita o catálogo que já existe —
/// é a mesma fonte de verdade que `PropostaItem`/`ItemTabelaPreco` passaram a usar na F1.19/F1.20
/// e que `Disciplina` passou a usar na F1.19c. Nenhum catálogo novo.
model NegociacaoDisciplina {
  id           String             @id @default(cuid())
  negociacaoId String
  negociacao   Negociacao         @relation(fields: [negociacaoId], references: [id], onDelete: Cascade)
  disciplinaId String
  disciplina   DisciplinaCatalogo @relation(fields: [disciplinaId], references: [id])
  /// Opcional (ADR-13) — mesmo padrão de `PropostaItem.valor`.
  valor        Decimal?           @db.Decimal(14, 2)

  @@unique([negociacaoId, disciplinaId])
  @@index([disciplinaId])
  @@map("negociacao_disciplina")
}

/// Junção Lead ↔ ContatoCliente (F2.3, ADR-01). A prospecção pertence à Empresa e pode ter N
/// contatos; `principal` é o contato principal DESTA prospecção, que pode diferir do principal
/// da empresa. Sem esta tabela, "tudo que já rolou com essa empresa" (Empresa 360, Fase 3) não
/// tem como amarrar quem falou com quem.
model LeadContato {
  id        String         @id @default(cuid())
  leadId    String
  lead      Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contatoId String
  contato   ContatoCliente @relation(fields: [contatoId], references: [id])
  principal Boolean        @default(false)

  @@unique([leadId, contatoId])
  @@index([contatoId])
  @@map("lead_contato")
}

/// Campanha de marketing/prospeccao (F1.23). Nasce vazia -- sem dado historico pra migrar
/// (docs/crm/03-migracao.md §3). UI de gestao (CRUD, selecao no formulario, relatorio por
/// campanha) so entra na Fase 4; aqui so o vinculo com `Lead` ja existe, pra nao remodelar o FK
/// quando a tela chegar.
model Campanha {
  id            String          @id @default(cuid())
  nome          String
  canalId       String?
  canal         CanalAquisicao? @relation(fields: [canalId], references: [id])
  periodoInicio DateTime?       @db.Date
  periodoFim    DateTime?       @db.Date
  responsavelId String?
  /// Mesmo padrao de `Lead.responsavelId`: so exibicao, nao gate.
  responsavel   User?           @relation("CampanhaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  meta          Decimal?        @db.Decimal(14, 2)
  observacao    String?
  ativo         Boolean         @default(true)
  createdAt     DateTime        @default(now())

  leads Lead[]

  @@index([canalId])
  @@index([responsavelId])
  negociacoes Negociacao[]
  @@map("campanha")
}

/// Parceiro/indicador (ADR-19, fecha a pendencia #13). Escolhido de LISTA, nunca digitado --
/// e a razao da entidade existir: hoje a indicacao vira a palavra "Indicacao" num campo de
/// texto livre, e "Joao"/"Joao Silva"/"j. silva" viram 3 pessoas distintas pro sistema, o que
/// impede somar. SEM campo de comissao de proposito: a regra (percentual? base proposto ou
/// contratado? vence no aceite ou no recebimento? ha faixas?) nao foi decidida -- nenhum calculo
/// sera implementado sem essa regra definida (fabricar politica financeira nao e opcao). CRUD +
/// selecao por lista e a F1.23b; relatorio "negocios por parceiro" e a F1.23c.
model Parceiro {
  id         String    @id @default(cuid())
  nome       String
  tipo       TipoPessoa @default(PF)
  documento  String?
  email      String?
  telefone   String?
  observacao String?
  ativo      Boolean   @default(true)
  /// Soft delete: campo explicito no backlog (F1.23a), mesmo padrao de Cliente/Lead/ContatoCliente
  /// (ADR-11) apesar de Parceiro nao estar entre os 4 models originais da ADR -- registrado na
  /// extensao de `lib/prisma.ts` do mesmo jeito.
  excluidoEm DateTime?
  createdAt  DateTime  @default(now())

  leads Lead[]

  @@index([excluidoEm])
  negociacoes Negociacao[]
  @@map("parceiro")
}

/// Arquivo anexado a um lead do funil (proposta enviada, e-mail de solicitação
/// da arquitetura, referências iniciais do orçamento). Mesmo padrão de
/// FuncionarioDocumento: metadados + caminho relativo em STORAGE_BASE_PATH.
model AnexoLead {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  nome        String
  caminho     String
  nomeArquivo String
  mime        String
  tamanho     Int
  hashSha256  String
  autorId     String?
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@map("anexo_lead")
}

model AtividadeLead {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation(fields: [autorId], references: [id])
  nota      String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("atividade_lead")
}

model MetaComercial {
  id    String  @id @default(cuid())
  ano   Int
  mes   Int
  valor Decimal @db.Decimal(14, 2)

  @@unique([ano, mes])
  @@map("meta_comercial")
}

// ─────────────────────────────────────────────────────────────
// CRM — catálogos e vocabulário (Fase 1b, docs/crm/04-plano-fases.md F1.5)
//
// Só o VOCABULÁRIO: tabelas de catálogo e enums. Os models que os consomem
// (`Negociacao`, `Lead` v2, `Campanha`, `Cliente` v2) chegam nas tarefas seguintes, e é lá
// que as relações inversas são declaradas. Migration puramente aditiva — nada existente
// é alterado, renomeado ou removido.
//
// ⚠️ Disciplina NÃO entra aqui: `DisciplinaCatalogo` (acima) já é o catálogo do sistema,
// seedado com 20 entradas. Ver docs/crm/02-schema.md §8.1 — criar um segundo seria
// fabricar duas fontes de verdade concorrentes.
// ─────────────────────────────────────────────────────────────

/// Tipo de empreendimento da negociação (residencial, galpão, hospital…).
model TipoEmpreendimento {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)
  negociacoes Negociacao[]

  @@map("tipo_empreendimento")
}

/// Motivo padronizado de perda — substitui o `Lead.motivoPerda` de texto livre.
model MotivoPerda {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)
  /// Quando true, a UI exige preencher o concorrente ao selecionar este motivo.
  exigeConcorrente Boolean @default(false)
  negociacoes Negociacao[]

  @@map("motivo_perda")
}

/// Canal de aquisição (como o negócio chegou). Nasce VAZIO: o `Lead.origem` de hoje foi
/// preenchido com nome de empreendimento, não com canal — ver docs/crm/03-migracao.md §3.
model CanalAquisicao {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)

  leads     Lead[]
  campanhas Campanha[]
  negociacoes Negociacao[]

  @@map("canal_aquisicao")
}

/// Segmento de mercado do cliente.
model Segmento {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)
  ordem Int     @default(0)

  clientes Cliente[]

  @@map("segmento")
}

/// Probabilidade padrão por estágio da negociação — configurável, NUNCA hardcoded na UI
/// (ADR-12). Estágios terminais (PERDIDO/EM_ESPERA/CANCELADO) não entram: a probabilidade
/// deles é resolvida no serviço, não no banco.
model ProbabilidadeEstagio {
  estagio       EstagioNegociacao @id
  probabilidade Int

  @@map("probabilidade_estagio")
}

/// Funil de PROSPECÇÃO. Os 4 primeiros são os estados "ativos" que travam a empresa para uma
/// nova prospecção; os 4 últimos liberam (ADR-18).
enum StatusProspeccao {
  IDENTIFICADO
  CONTATO_INICIADO
  EM_CONTATO
  QUALIFICADO
  OPORTUNIDADE_CRIADA
  SEM_OPORTUNIDADE
  EM_ESPERA
  DESCARTADO
}

/// Funil de NEGOCIAÇÃO (o que hoje é feito fora do sistema).
enum EstagioNegociacao {
  LEVANTAMENTO
  ORCAMENTO
  PROPOSTA_ENVIADA
  NEGOCIACAO
  CONTRATADO
  PERDIDO
  EM_ESPERA
  CANCELADO
}

/// Temperatura manual — sem IA, sem scoring automático (veredito do dono no roadmap).
enum Temperatura {
  FRIO
  MORNO
  QUENTE
}

/// Tipo de evento na timeline. `SISTEMA` = registrado automaticamente pelo próprio fluxo.
enum TipoAtividade {
  LIGACAO
  WHATSAPP
  EMAIL
  LINKEDIN
  REUNIAO
  NOTA
  ANEXO
  SISTEMA
}

/// Status comercial da Empresa. Derivado de ter proposta aceita, com override manual (ADR-08).
/// EX_CLIENTE e PARCEIRO nunca são calculados — só entram por override.
enum StatusComercialCliente {
  PROSPECT
  CLIENTE
  EX_CLIENTE
  PARCEIRO
}

/// LGPD: base legal da coleta do contato. Prospecção B2B fria = legítimo interesse.
enum BaseLegalLgpd {
  LEGITIMO_INTERESSE
}

/// Situação do contato dentro da empresa dele.
enum StatusRelacionamentoContato {
  ATIVO
  AFASTADO
  SAIU_DA_EMPRESA
}

/// Tabela de preço por m² por disciplina (preços automáticos da proposta).
model TabelaPreco {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  itens ItemTabelaPreco[]

  @@map("tabela_preco")
}

model ItemTabelaPreco {
  id       String      @id @default(cuid())
  tabelaId String
  tabela   TabelaPreco @relation(fields: [tabelaId], references: [id], onDelete: Cascade)

  // ── Disciplina: texto livre → catálogo (CRM F1.20, mesmo padrão da F1.19) ──
  /// `@map` mantém a COLUNA FÍSICA `disciplina` — só o código passa a chamá-la assim.
  /// A unique constraint abaixo continua sobre esta coluna, sem mudança de comportamento.
  disciplinaTextoLegado String              @map("disciplina")
  /// NULLABLE: item "extra" (fora do catálogo, digitado à mão) fica sem FK. A tela de tabelas
  /// já preenche a maioria a partir do catálogo (`catalogoDisciplinas()`), então o backfill
  /// resolve quase tudo — mas alguém pode ter digitado uma disciplina custom.
  disciplinaId          String?
  disciplina            DisciplinaCatalogo? @relation(fields: [disciplinaId], references: [id])

  valorM2 Decimal @db.Decimal(12, 2)

  @@unique([tabelaId, disciplinaTextoLegado])
  @@index([disciplinaId])
  @@map("item_tabela_preco")
}

enum StatusProposta {
  rascunho
  enviada
  aceita
  recusada
}

model PropostaSequencia {
  ano    Int @id
  ultimo Int @default(0)

  @@map("proposta_sequencia")
}

model Proposta {
  id          String         @id @default(cuid())
  ano         Int
  sequencial  Int
  /// Número de exibição: PR-260001
  numero      String         @unique
  titulo      String
  clienteId   String
  cliente     Cliente        @relation(fields: [clienteId], references: [id])
  leadId      String?
  lead        Lead?          @relation(fields: [leadId], references: [id])
  status      StatusProposta @default(rascunho)
  areaM2      Decimal?       @db.Decimal(12, 2)
  validade    DateTime?      @db.Date
  observacoes String?
  /// Token do link público (/a/proposta/[token]).
  token       String         @unique
  autorId     String
  autor       User           @relation("PropostaAutor", fields: [autorId], references: [id])
  /// Projeto gerado no aceite.
  projetoId   String?        @unique
  projeto     Projeto?       @relation(fields: [projetoId], references: [id])

  enviadaEm DateTime?
  aceitaEm  DateTime?

  itens         PropostaItem[]
  condicoes     PropostaCondicao[]
  versoes       PropostaVersao[]
  visualizacoes PropostaVisualizacao[]
  documentos    Documento[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ano, sequencial])
  @@index([status])
  @@index([clienteId])
  @@map("proposta")
}

model PropostaItem {
  id         String   @id @default(cuid())
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  // ── Disciplina: texto livre → catálogo (CRM F1.19) ──────────
  /// Texto original digitado antes da migração. O `@map` mantém a COLUNA FÍSICA com o nome
  /// antigo (`disciplina`): o banco não sofre rename, só o código passa a usar o nome alvo.
  /// Fica como fallback enquanto houver item sem FK — a consolidação das grafias de produção
  /// é a F1.21. Deprecado para escrita nova; ainda lido.
  disciplinaTextoLegado String              @map("disciplina")
  /// NULLABLE de propósito: em produção há 24 grafias, 18 batendo exato com o catálogo e 6
  /// precisando de tratamento manual. Item que não resolve fica sem FK — é estado esperado,
  /// não falha.
  disciplinaId          String?
  disciplina            DisciplinaCatalogo? @relation(fields: [disciplinaId], references: [id])

  descricao  String?
  valor      Decimal  @db.Decimal(14, 2)
  ordem      Int      @default(0)

  @@index([propostaId])
  @@index([disciplinaId])
  @@map("proposta_item")
}

enum TipoCondicao {
  percentual
  valor
}

model PropostaCondicao {
  id         String       @id @default(cuid())
  propostaId String
  proposta   Proposta     @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  descricao  String
  tipo       TipoCondicao @default(percentual)
  valor      Decimal      @db.Decimal(14, 2)
  ordem      Int          @default(0)

  @@index([propostaId])
  @@map("proposta_condicao")
}

/// Snapshot da proposta a cada salvar (itens+condições serializados).
model PropostaVersao {
  id         String   @id @default(cuid())
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  numero     Int
  snapshot   Json
  autorId    String
  autor      User     @relation("PropostaVersaoAutor", fields: [autorId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([propostaId, numero])
  @@map("proposta_versao")
}

/// Abertura registrada pelo pixel do link público.
model PropostaVisualizacao {
  id         String   @id @default(cuid())
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([propostaId])
  @@map("proposta_visualizacao")
}

// ─────────────────────────────────────────────────────────────
// Estúdio de Documentos (Onda D) — modelos de relatório em bandas
// ─────────────────────────────────────────────────────────────

enum TipoDocumento {
  relatorio
  proposta
  contrato
  recibo
  holerite
  outro
}

/// Modelo (template) de documento. Layout em bandas no schemaJson.
model DocumentoModelo {
  id           String        @id @default(cuid())
  nome         String
  descricao    String?
  tipo         TipoDocumento @default(relatorio)
  /// Fonte de dados padrão (id do registry em modules/documentos/fontes.ts).
  fonte        String?
  schemaJson   Json
  ativo        Boolean       @default(true)
  /// Dono do modelo (autor). Null = modelo de sistema/legado.
  donoId       String?
  /// Visibilidade do modelo: "pessoal" (só o dono) | "perfis" (perfis em `perfis`) | "global" (todos).
  visibilidade String        @default("global")
  /// Perfis que enxergam o modelo quando visibilidade = "perfis".
  perfis       Role[]        @default([])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  versoes DocumentoModeloVersao[]

  @@index([tipo, ativo])
  @@map("documento_modelo")
}

/// Histórico de versões (criada a cada salvar).
model DocumentoModeloVersao {
  id         String          @id @default(cuid())
  modeloId   String
  modelo     DocumentoModelo @relation(fields: [modeloId], references: [id], onDelete: Cascade)
  numero     Int
  schemaJson Json
  autorId    String
  autor      User            @relation(fields: [autorId], references: [id])
  createdAt  DateTime        @default(now())

  @@unique([modeloId, numero])
  @@map("documento_modelo_versao")
}

/// Documento gerado e persistido (histórico imutável do que foi produzido/enviado).
/// Snapshot do schema + dados resolvidos no momento da geração; nomes guardados p/ sobreviver à exclusão.
model DocumentoGerado {
  id             String   @id @default(cuid())
  modeloId       String?
  modeloNome     String
  fonte          String?
  params         Json
  schemaSnapshot Json
  dadosSnapshot  Json
  geradoPorId    String
  geradoPorNome  String
  /// Numeração automática (sequência por série). Ex.: série "REL", número 142.
  serie          String?
  numero         Int?
  /// Caminho do PDF salvo em storage (opcional; setado quando PDF é gerado e salvo automaticamente).
  arquivoPath    String?
  createdAt      DateTime @default(now())

  @@index([modeloId])
  @@index([createdAt])
  @@map("documento_gerado")
}

/// Dataset reutilizável importado de CSV — vira uma coleção (linhas) p/ o Estúdio (D3).
model DatasetDocumento {
  id        String   @id @default(cuid())
  nome      String
  colunas   Json
  linhas    Json
  donoId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dataset_documento")
}

/// Bloco reutilizável de elementos do Estúdio (cabeçalho, assinatura, carimbo) — biblioteca (D5).
model BlocoDocumento {
  id            String   @id @default(cuid())
  nome          String
  conteudo      Json
  donoId        String?
  compartilhado Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@map("bloco_documento")
}

// ─────────────────────────────────────────────────────────────
// RH — Folha CLT, Onboarding, NF de PJ (Onda 3e/3f/3g)
// ─────────────────────────────────────────────────────────────

enum TipoRubrica {
  provento
  desconto
}

/// Catálogo de rubricas da folha (salário, VT, INSS, IRRF…).
model RubricaFolha {
  id    String      @id @default(cuid())
  nome  String      @unique
  tipo  TipoRubrica
  ordem Int         @default(0)
  ativo Boolean     @default(true)

  itens HoleriteItem[]

  @@map("rubrica_folha")
}

/// Faixa de encargo da folha (INSS/IRRF). Sem valores embutidos — configurável em Configurações.
model EncargoFaixa {
  id       String  @id @default(cuid())
  tipo     String // "inss" | "irrf"
  limite   Decimal @db.Decimal(14, 2) // limite superior da faixa
  aliquota Decimal @db.Decimal(6, 3) // %
  deduzir  Decimal @default(0) @db.Decimal(14, 2) // parcela a deduzir (IRRF)
  ordem    Int     @default(0)

  @@index([tipo, ordem])
  @@map("encargo_faixa")
}

/// Dependente de um colaborador (p/ dedução de IRRF e cadastro de RH).
model Dependente {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome       String
  cpf        String?
  nascimento DateTime? @db.Date
  /// Texto livre (select fixo na UI, sem enum) — evita migrar valores desconhecidos de quem
  /// já tem dependente cadastrado.
  parentesco String?
  /// Entra na dedução de IRRF da folha (`funcionarios/queries.ts` → `dependentesPorUsuario`).
  /// Default `false` para linha NOVA: o RH confirma ativamente, em vez de reter IRRF a menos
  /// por esquecer de desmarcar. As linhas que já existiam antes deste campo foram migradas
  /// para `true` (preserva o número que a folha já usava).
  dependenteIrrf Boolean  @default(false)
  createdAt      DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@index([userId])
  @@map("dependente")
}

/// Prancha (folha técnica) de uma disciplina — código, título, revisão, escala.
/// Lista Mestre de Documentos: uma folha técnica por disciplina.
/// Código composto (não persistido): {projeto}-{sigla disciplina}-{fase}-{numeracao4}-{tipo}[-Rnn].
model Prancha {
  id           String     @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  folha        String
  tipo         String
  fase         String
  numeracao    Int
  revisao      Int        @default(0)
  conteudo     String?    @db.Text
  ordem        Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([disciplinaId])
  @@map("prancha")
}

enum CategoriaPranchaCatalogo {
  folha
  tipo
  fase
}

/// Configuração de nomenclatura da Lista Mestre. Linha global = projetoId null (singleton);
/// linha por projeto sobrescreve. `exigir` liga/desliga o alerta de nome fora do padrão;
/// `padrao` é um regex custom (opcional) — vazio usa o padrão embutido.
model NomenclaturaConfig {
  id        String   @id @default(cuid())
  projetoId String?  @unique
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  exigir    Boolean  @default(true)
  padrao    String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("nomenclatura_config")
}

/// Catálogo de siglas da Lista Mestre (folha/tipo/fase). Global (projetoId null)
/// ou específico de um projeto. A sigla é usada na composição do código da prancha.
model PranchaCatalogo {
  id        String                   @id @default(cuid())
  categoria CategoriaPranchaCatalogo
  sigla     String
  nome      String
  ativo     Boolean                  @default(true)
  ordem     Int                      @default(0)
  projetoId String?
  projeto   Projeto?                 @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  createdAt DateTime                 @default(now())

  documentos DocumentoDisciplina[]

  @@index([categoria, projetoId])
  @@map("prancha_catalogo")
}

/// Feriado (cadastro p/ ponto/escala/banco de horas). Data única (ocorrência de um ano).
model Feriado {
  id        String   @id @default(cuid())
  data      DateTime @unique @db.Date
  nome      String
  tipo      String   @default("nacional") // nacional | estadual | municipal
  createdAt DateTime @default(now())

  @@map("feriado")
}

/// Feriado recorrente de data fixa (repete todo ano por dia/mês). Móveis (Páscoa) NÃO entram aqui.
model FeriadoRecorrente {
  id        String   @id @default(cuid())
  dia       Int // 1..31
  mes       Int // 1..12
  nome      String
  tipo      String   @default("nacional") // nacional | estadual | municipal (esfera)
  createdAt DateTime @default(now())

  @@unique([dia, mes, nome])
  @@map("feriado_recorrente")
}

/// Comentário de tarefa (texto e/ou anexo).
model TarefaComentario {
  id        String   @id @default(cuid())
  tarefaId  String
  tarefa    Tarefa   @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User     @relation("TarefaComentarioAutor", fields: [autorId], references: [id])
  texto     String   @default("")
  anexoPath String?
  anexoNome String?
  anexoMime String?
  createdAt DateTime @default(now())

  @@index([tarefaId])
  @@map("tarefa_comentario")
}

/// Habilidade/competência (catálogo).
model Habilidade {
  id       String           @id @default(cuid())
  nome     String           @unique
  usuarios UserHabilidade[]

  @@map("habilidade")
}

/// Vínculo colaborador × habilidade.
model UserHabilidade {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  habilidadeId String
  habilidade   Habilidade @relation(fields: [habilidadeId], references: [id], onDelete: Cascade)

  @@unique([userId, habilidadeId])
  @@map("user_habilidade")
}

/// Serviço terceirizado contratado para um projeto (fornecedor externo).
model ServicoTerceirizado {
  id           String      @id @default(cuid())
  projetoId    String
  projeto      Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  fornecedorId String?
  fornecedor   Fornecedor? @relation(fields: [fornecedorId], references: [id])
  descricao    String
  valor        Decimal?    @db.Decimal(14, 2)
  status       String      @default("contratado") // contratado | concluido | cancelado
  /// Vínculo com o Financeiro: despesa prevista (contratado) / confirmada (concluido).
  lancamentoId String?     @unique
  createdAt    DateTime    @default(now())

  @@index([projetoId])
  @@map("servico_terceirizado")
}

enum StatusFolha {
  aberta
  fechada
}

model FolhaPagamento {
  id           String      @id @default(cuid())
  ano          Int
  mes          Int // 1-12
  status       StatusFolha @default(aberta)
  fechadaEm    DateTime?
  /// Lançamento de despesa (2.03) criado ao fechar.
  lancamentoId String?     @unique

  holerites Holerite[]
  createdAt DateTime   @default(now())

  @@unique([ano, mes])
  @@map("folha_pagamento")
}

model Holerite {
  id        String         @id @default(cuid())
  folhaId   String
  folha     FolhaPagamento @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  enviadoEm DateTime?

  itens HoleriteItem[]

  @@unique([folhaId, userId])
  @@map("holerite")
}

model HoleriteItem {
  id         String        @id @default(cuid())
  holeriteId String
  holerite   Holerite      @relation(fields: [holeriteId], references: [id], onDelete: Cascade)
  rubricaId  String?
  rubrica    RubricaFolha? @relation(fields: [rubricaId], references: [id])
  descricao  String
  tipo       TipoRubrica
  valor      Decimal       @db.Decimal(12, 2)

  @@index([holeriteId])
  @@map("holerite_item")
}

model OnboardingTemplate {
  id    String  @id @default(cuid())
  nome  String  @unique
  ativo Boolean @default(true)

  itens     OnboardingTemplateItem[]
  processos OnboardingProcesso[]

  @@map("onboarding_template")
}

model OnboardingTemplateItem {
  id         String             @id @default(cuid())
  templateId String
  template   OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  descricao  String
  ordem      Int                @default(0)

  @@index([templateId])
  @@map("onboarding_template_item")
}

/// Checklist de admissão de um colaborador (1 por usuário).
model OnboardingProcesso {
  id         String              @id @default(cuid())
  userId     String              @unique
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   OnboardingTemplate? @relation(fields: [templateId], references: [id])
  createdAt  DateTime            @default(now())

  itens OnboardingItem[]

  @@map("onboarding_processo")
}

model OnboardingItem {
  id          String             @id @default(cuid())
  processoId  String
  processo    OnboardingProcesso @relation(fields: [processoId], references: [id], onDelete: Cascade)
  descricao   String
  ordem       Int                @default(0)
  concluido   Boolean            @default(false)
  concluidoEm DateTime?

  @@index([processoId])
  @@map("onboarding_item")
}

enum StatusNF {
  enviada
  aprovada
  rejeitada
}

/// Nota fiscal enviada por PJ/freelancer para faturar pagamentos.
model NotaFiscalPJ {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("NfUser", fields: [userId], references: [id])
  numero      String?
  valor       Decimal  @db.Decimal(12, 2)
  /// Caminho relativo a STORAGE_BASE_PATH.
  arquivoPath String
  arquivoNome String
  status      StatusNF @default(enviada)
  observacao  String?

  validadoPorId String?
  validadoPor   User?     @relation("NfValidador", fields: [validadoPorId], references: [id])
  validadoEm    DateTime?

  createdAt DateTime                @default(now())
  historico NotaFiscalPJHistorico[]

  @@index([userId, status])
  @@map("nota_fiscal_pj")
}

/// Trilha de status da NF de PJ (D6).
model NotaFiscalPJHistorico {
  id        String       @id @default(cuid())
  notaId    String
  nota      NotaFiscalPJ @relation(fields: [notaId], references: [id], onDelete: Cascade)
  de        String?
  para      String
  autorId   String?
  createdAt DateTime     @default(now())

  @@index([notaId])
  @@map("nota_fiscal_pj_historico")
}

/// Feedback / 1:1 de RH sobre um colaborador (D5).
model FeedbackRH {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("FeedbackAlvo", fields: [userId], references: [id], onDelete: Cascade)
  autorId   String
  /// feedback | reuniao_1a1 | reconhecimento | alerta
  tipo      String   @default("feedback")
  conteudo  String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("feedback_rh")
}

enum OrigemUpload {
  manual
  ferramenta
}

enum PacoteUpload {
  A // plantas / memoriais
  B // backup do software
  OUTROS // formatos não suportados
  RECEBIDOS // Item 17 (beta): arquivos recebidos do cliente
}

model Upload {
  id           String        @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina    @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  /// Localização legada (particular/licitacao): pacote A/B/OUTROS/RECEBIDOS + subpasta por
  /// extensão. Nulo quando o arquivo vive numa PastaProjeto (pastaId setado) — tipos
  /// aprovação/laudo e pastas personalizadas. Sempre um dos dois (pacote XOR pastaId).
  pacote       PacoteUpload?
  /// Pasta da árvore PastaProjeto onde o arquivo vive (template ou custom). Nulo = legado (pacote).
  pastaId      String?
  pasta        PastaProjeto? @relation(fields: [pastaId], references: [id], onDelete: Cascade)
  nomeArquivo  String
  /// Caminho relativo a STORAGE_BASE_PATH (nunca absoluto).
  caminho      String
  hashSha256   String
  tamanho      Int
  mimeType     String?
  versao       Int           @default(1)
  origem       OrigemUpload  @default(manual)

  validado      Boolean   @default(false)
  validadoPorId String?
  validadoPor   User?     @relation("UploadValidador", fields: [validadoPorId], references: [id])
  validadoEm    DateTime?

  /// Ajuste solicitado pelo validador (validação parcial): motivo + quem/quando.
  revisaoObs   String?
  revisaoEm    DateTime?
  revisaoPorId String?
  revisaoPor   User?     @relation("UploadRevisor", fields: [revisaoPorId], references: [id])

  autorId   String
  autor     User     @relation("UploadAutor", fields: [autorId], references: [id])
  createdAt DateTime @default(now())

  /// Lixeira (soft delete): quando != null, o arquivo está na lixeira do projeto e
  /// some das listagens/downloads (filtro global em lib/prisma.ts + filtros explícitos
  /// nas leituras aninhadas). Purga automática após 30 dias (job purgar-lixeira).
  excluidoEm    DateTime?
  excluidoPorId String?

  /// Documento lógico (pai) que agrupa as VERSÕES deste mesmo arquivo. Nulo só em
  /// linhas legadas anteriores ao backfill — a criação normal (persistir, em
  /// api/uploads/route.ts) sempre resolve/cria o pai antes de gravar.
  documentoId String?
  documento   DocumentoDisciplina? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  /// Revisão a que este arquivo pertence (Fase 2). Nula em linha antiga até o backfill
  /// rodar, e nula de propósito em upload sem documento lógico (ex.: gerado por ferramenta
  /// antes da reconciliação). Nunca é lida pelo código da Fase 1.
  revisaoId   String?
  revisao     DocumentoRevisao?    @relation(fields: [revisaoId], references: [id], onDelete: SetNull)

  aceite                AceiteCliente?
  solicitacoesExclusao  SolicitacaoExclusaoUpload[]
  pendencias            Pendencia[]       @relation("UploadPendencias")
  pendenciasVerificadas Pendencia[]       @relation("PendenciaVerificacao")
  calibracoes           CalibracaoPrancha[] @relation("UploadCalibracoes")
  conversao             ConversaoModelo?
  conversaoDesenho      ConversaoDesenho?

  @@index([disciplinaId, pacote])
  @@index([pastaId])
  @@index([autorId])
  @@index([excluidoEm])
  @@index([documentoId])
  @@index([revisaoId])
  @@map("upload")
}

/// Situação de um pedido de exclusão de arquivo feito por quem NÃO pode excluir.
enum StatusSolicitacaoExclusao {
  pendente
  aprovada
  recusada
}

/// Pedido de exclusão de um arquivo de disciplina (Upload) feito por um usuário sem
/// permissão de excluir. Nada sai do lugar enquanto está `pendente` — o arquivo só vai
/// para a lixeira quando um admin aprova. Histórico completo (uma linha por pedido, os
/// decididos ficam): é o registro de "quem pediu, por quê, quem decidiu".
/// Só um pedido `pendente` por arquivo (índice parcial único, criado na migração — o
/// Prisma não expressa `WHERE status = 'pendente'`).
model SolicitacaoExclusaoUpload {
  id       String @id @default(cuid())
  uploadId String
  upload   Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  /// Denormalizado (sem FK) para filtrar/agrupar por projeto sem join triplo. A limpeza
  /// vem pela cascata do Upload (disciplina → projeto).
  projetoId     String
  justificativa String
  status        StatusSolicitacaoExclusao @default(pendente)

  solicitanteId String
  solicitante   User   @relation("ExclusaoSolicitante", fields: [solicitanteId], references: [id])

  decididoPorId String?
  decididoPor   User?     @relation("ExclusaoDecisor", fields: [decididoPorId], references: [id])
  decididoEm    DateTime?
  /// Resposta do decisor (obrigatória na recusa, para o solicitante saber o motivo).
  motivoDecisao String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([uploadId])
  @@index([projetoId, status])
  @@index([solicitanteId])
  @@index([decididoPorId])
  @@map("solicitacao_exclusao_upload")
}

/// Documento LÓGICO de disciplina: agrupa as versões (Upload) do mesmo arquivo sob um id
/// estável. Antes disto a cadeia de versões era derivada em runtime por
/// (disciplinaId, pacote|pastaId, nomeArquivo) — o que quebrava ao renomear e não dava
/// âncora estável para apontamentos. Segue o padrão pai/versão já usado por
/// Documento/DocumentoVersao, DocumentoJuridico/DocJuridicoVersao, Art/ArtVersao etc.
model DocumentoDisciplina {
  id           String     @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  /// Chave de AGRUPAMENTO (dedupe/lookup) — NÃO é a identidade. A identidade é `id`, e é
  /// ela que Pendencia referencia; por isso renomear só reescreve esta chave e não
  /// desancora nada. Normalizada como "A/planta.pdf" ou "pasta:<pastaId>/planta.pdf"
  /// porque UNIQUE no Postgres trata NULL como distinto — com `pacote` XOR `pastaId` crus,
  /// a constraint deixaria passar duplicata. Não "simplificar" de volta para colunas soltas.
  chave        String
  /// Nome exibido; espelho de Upload.nomeArquivo das suas versões (renomear atualiza os dois).
  nomeArquivo  String
  /// Título legível ("Planta de forma do pavimento tipo"). Nulo enquanto ninguém preencher —
  /// a tela cai no `nomeArquivo`, que é o comportamento de hoje.
  titulo       String?
  descricao    String?
  /// Fase do documento (Anteprojeto/Projeto Básico/Executivo...). Aponta para o catálogo que
  /// a Lista Mestre já usa; a categoria correta (`fase`) é garantida pela UI, não por
  /// constraint — `PranchaCatalogo` guarda as três categorias na mesma tabela.
  faseId       String?
  fase         PranchaCatalogo? @relation(fields: [faseId], references: [id], onDelete: SetNull)
  statusId     String?
  status       DocumentoStatus? @relation(fields: [statusId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  /// Documento que absorveu este (merge por nome-base, M4). Quando preenchido, esta linha
  /// é um APELIDO histórico: nada novo se pendura nela, mas ela continua existindo para
  /// que `AuditLog.entidadeId` e links antigos ainda resolvam — via `resolverDocumentoCanonico`.
  /// Soft-retire em vez de DELETE justamente por isso.
  substituidoPorId String?
  substituidoPor   DocumentoDisciplina?  @relation("MergeDocumento", fields: [substituidoPorId], references: [id], onDelete: SetNull)
  substituidos     DocumentoDisciplina[] @relation("MergeDocumento")

  uploads    Upload[]
  revisoes   DocumentoRevisao[]
  pendencias Pendencia[]
  calibracoes CalibracaoPrancha[]
  leituras   LeituraDocumento[]

  @@unique([disciplinaId, chave])
  @@index([disciplinaId])
  @@index([substituidoPorId])
  @@index([faseId])
  @@index([statusId])
  @@map("documento_disciplina")
}

/// Revisão de um documento: o nível que faltava entre o documento lógico e o arquivo.
///
/// Existe para que PDF e DWG da MESMA revisão (R03) pertençam a um único ponto no tempo,
/// em vez de serem duas linhas independentes cada uma com seu contador — ver
/// docs/auditoria/03-plano-refatoracao.md §2. `Upload` continua sendo o arquivo físico
/// (o `DocumentFile` da spec) e ganha `revisaoId` apontando para cá.
///
/// `Upload.versao` NÃO foi removido: durante a Fase 2 as duas coisas convivem, porque
/// `entregaveisAtuais()` e a validação por-arquivo ainda leem `versao`. A remoção dele é
/// decisão de uma onda posterior, quando nada mais depender do contador por linha.
/// Status documental configurável (item 26 da spec). Tabela, não enum, pelo mesmo motivo de
/// `TarefaStatus`: o escritório muda o vocabulário sem migration. É DIFERENTE de revisão —
/// "R03" diz qual versão é, "Em análise" diz em que ponto do fluxo ela está.
///
/// `StatusDisciplina` (enum) continua existindo e não se confunde com este: aquele é o estado
/// da DISCIPLINA inteira; este é de um documento.
model DocumentoStatus {
  id     String  @id @default(cuid())
  nome   String  @unique
  ordem  Int     @default(0)
  cor    String?
  /// Estado terminal: o documento não deve mais receber revisão (obsoleto/arquivado).
  final  Boolean @default(false)
  ativo  Boolean @default(true)

  documentos DocumentoDisciplina[]

  @@map("documento_status")
}

model DocumentoRevisao {
  id          String              @id @default(cuid())
  documentoId String
  documento   DocumentoDisciplina @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  /// Número da revisão dentro do documento (1, 2, 3...). Exibido como R01, R02...
  numero      Int
  createdAt   DateTime            @default(now())
  /// Quem enviou a revisão. Nulo quando o autor foi removido, ou em linha vinda de backfill
  /// de um upload cujo autor não existe mais.
  createdById String?
  createdBy   User?               @relation("RevisaoAutor", fields: [createdById], references: [id], onDelete: SetNull)

  uploads Upload[]

  @@unique([documentoId, numero])
  @@index([documentoId])
  @@index([createdById])
  @@map("documento_revisao")
}

/// Árvore de pastas por disciplina (auto-referente). Semeada por template conforme o tipo
/// do projeto (aprovação/laudo) e/ou criada livremente por admin (pastas personalizadas).
/// Substitui, nesses casos, a árvore derivada de PacoteUpload + extensão. Um Upload aponta
/// para uma folha desta árvore via Upload.pastaId.
model PastaProjeto {
  id           String         @id @default(cuid())
  disciplinaId String
  disciplina   Disciplina     @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       PastaProjeto?  @relation("PastaFilhos", fields: [parentId], references: [id], onDelete: Cascade)
  filhos       PastaProjeto[] @relation("PastaFilhos")
  /// Rótulo exibido na árvore e no .zip (ex.: "Laudos").
  nome         String
  /// Slug-path relativo à disciplina, para o armazenamento físico (ex.: "aprovacao/laudos").
  caminho      String
  /// "template" (semeada pelo tipo do projeto) | "custom" (criada por admin).
  origem       String         @default("custom")
  ordem        Int            @default(0)
  uploads      Upload[]
  createdAt    DateTime       @default(now())

  @@index([disciplinaId, parentId])
  @@map("pasta_projeto")
}

/// Apontamento posicional (pendência) sobre uma prancha PDF, na tela de visualização.
/// Amarra à VERSÃO do arquivo (uploadId) — congela na revisão em que foi feito.
/// Numeração sequencial por prancha/rodada (escopo uploadId). Vira item de checklist
/// de UMA tarefa por prancha. Refs de disciplina/projeto/usuário são denormalizadas
/// (resolvidas por query), sem FK, para manter a migração enxuta.
model Pendencia {
  id             String    @id @default(cuid())
  uploadId       String
  upload         Upload    @relation("UploadPendencias", fields: [uploadId], references: [id], onDelete: Cascade)
  disciplinaId   String
  projetoId      String
  numero         Int
  pagina         Int
  /// Âncora normalizada (0..1) relativa à página — sobrevive a zoom/DPI.
  x              Float
  y              Float
  texto          String
  /// aberta | em_correcao | resolvida | fechada | descartada | adiado
  /// A máquina de estados aprovada (item 22) vive em `pendencias/helpers.ts#podeTransicionar`.
  /// `descartada` é o valor GRAVADO do estado que a UI chama de "Não procede": manter o nome
  /// antigo no banco preserva a verdade do `AuditLog` já escrito e mantém a migração aditiva —
  /// é o MESMO estado, não um novo (a ficha do item 22 diz isso).
  status         String    @default("aberta")
  autorId        String
  tarefaId       String?
  tarefaItemId   String?
  resolvidoPorId String?
  resolvidoEm    DateTime?
  fechadoPorId   String?
  fechadoEm      DateTime?
  createdAt      DateTime  @default(now())

  /// Âncora ESTÁVEL do apontamento: o documento lógico, não a versão. `uploadId` acima
  /// continua sendo a versão de ORIGEM (onde o apontamento nasceu) e `uploadVerificacaoId`
  /// a versão em que foi verificado/encerrado. O `numero` é mantido através das revisões.
  documentoId         String?
  documento           DocumentoDisciplina? @relation(fields: [documentoId], references: [id], onDelete: SetNull)
  uploadVerificacaoId String?
  uploadVerificacao   Upload?              @relation("PendenciaVerificacao", fields: [uploadVerificacaoId], references: [id], onDelete: SetNull)

  /// Âncora TEXTUAL do apontamento (ver `modules/projetos/pendencias/ancora.ts`). Guarda um
  /// trecho do texto da página perto do clique, para reposicionar o pino quando ele é herdado
  /// por uma revisão de layout diferente. Nulo = prancha sem texto ali (CAD que exportou texto
  /// como curva, escaneada) ou linha anterior a esta feature: o pino cai de volta em (x,y).
  /// NÃO existe coluna "posição incerta": a incerteza é POR VERSÃO (o mesmo pino é exato na
  /// revisão em que nasceu e pode ser incerto na seguinte), então é derivada na leitura.
  ancoraTexto   String?
  /// Offset (chars) do item-âncora dentro de `ancoraTexto` — o trecho é maior que o item.
  ancoraOffset  Int?
  /// Deslocamento normalizado do item-âncora até o ponto clicado.
  ancoraDx      Float?
  ancoraDy      Float?

  /// Classificação estruturada (item 11). Catálogo em `pendencias/helpers.ts` (código, não
  /// tabela — é vocabulário fixo do escritório, não dado editável pelo usuário).
  /// `impeditivo` é o TOPO da escala de severidade, não um flag à parte (decidido 2026-08-06):
  /// o item 19 bloqueia a aprovação enquanto houver aberto com `severidade = "impeditivo"`.
  /// Nulos = linha anterior à feature ou apontamento não classificado — a UI mostra "—".
  /// severidade: impeditivo | alta | media | baixa
  severidade    String?
  /// tipo: incompatibilidade | falta_informacao | erro_tecnico | norma | representacao | outro
  tipo          String?

  /// Marcação vetorial (item 9) — ver `modules/projetos/pendencias/marcacao.ts`.
  /// `x`/`y` acima seguem sendo a ÂNCORA canônica (onde o arrasto começou); a forma vem por
  /// cima. Nulo (ou "ponto") = pino simples, o comportamento de sempre.
  /// marcacaoTipo: ponto | retangulo | seta | nuvem | medida
  marcacaoTipo  String?
  /// `{ pontos: [{ dx, dy }] }` — **offsets normalizados relativos a (x,y)**, nunca coordenada
  /// absoluta de página. É o que faz a forma acompanhar de graça a relocalização da âncora
  /// textual (item 3): reposicionar o pino numa revisão de layout deslocado move o desenho
  /// junto. Com coordenada absoluta o pino iria pro lugar certo e a forma ficaria pra trás.
  marcacaoGeo   Json?

  /// Prazo do apontamento (item 18) — data FIXA definida na criação (R8), não calculada por
  /// severidade. O relógio só corre a partir de `publicadoEm`: rascunho não queima prazo,
  /// porque o projetista não pode agir sobre o que ainda não enxerga. Adiar e reativar NÃO
  /// mexem no prazo (decisão do solicitante em 2026-08-08: reativar PRESERVA).
  prazo          DateTime?

  /// Rascunho → publicado (item 31). Nulo = RASCUNHO: existe só para quem escreveu, não conta
  /// em badge/KPI/visão gerencial, não bloqueia validação e não sai em export nenhum. A
  /// publicação acontece no envio da rodada (`enviarApontamentos`) — não há um segundo passo
  /// de "publicar", porque o envio já É o lote (cria a tarefa, notifica e abre revisão).
  publicadoEm    DateTime?

  /// Justificativa obrigatória ao marcar "não procede" (item 22). Nullable na coluna porque
  /// linha antiga descartada não tem uma — a obrigatoriedade é validada no schema Zod, não por
  /// NOT NULL numa tabela já populada.
  justificativaDescarte String?
  /// Quantas vezes o apontamento foi reaberto (item 23). Default 0, nunca nulo: a contagem
  /// entra em média/KPI e um nulo obrigaria guarda em todo lugar que soma.
  reaberturas    Int       @default(0)

  /// Medição (item 28) — só em `marcacaoTipo = "medida"`. O valor é CONGELADO na criação,
  /// junto do fator e do modo que o produziram: recalibrar a prancha depois não pode mudar
  /// silenciosamente um número que já virou apontamento, e guardar o fator é o que permite
  /// explicar de onde veio a medida meses depois.
  medidaMm      Float?
  /// mm reais por ponto do PDF usados no cálculo (ver `pendencias/medicao.ts`).
  medidaFator   Float?
  /// escala | dois_pontos
  medidaModo    String?

  /// Miniatura do recorte da prancha (item 14, R6 pediu que PERSISTA) — caminho relativo em
  /// `STORAGE_BASE_PATH`, servido por `/api/pendencias/thumb/[id]`. Só existe para apontamento
  /// com FORMA: o recorte é a área selecionada, e pino simples não tem recorte (além de ser a
  /// interação mais quente do viewer, que não deve pagar um upload a mais).
  thumbPath     String?

  /// Soft delete (item 24). Pendencia NÃO entra na extension de `lib/prisma.ts` de propósito:
  /// a numeração é sequencial por documento (`_max: { numero }`), e esconder linhas excluídas
  /// do aggregate faria o próximo apontamento REUSAR o número de um excluído (dois "#5" no
  /// mesmo documento, sem erro). O filtro `excluidoEm: null` é explícito em cada leitura.
  excluidoEm    DateTime?
  excluidoPorId String?
  excluidoPor   User?     @relation("PendenciaExcluidaPor", fields: [excluidoPorId], references: [id], onDelete: SetNull)

  respostas     PendenciaResposta[]
  anexos        PendenciaAnexo[]
  referenciasFeitas   ReferenciaPendencia[] @relation("ReferenciaOrigem")
  referenciasRecebidas ReferenciaPendencia[] @relation("ReferenciaDestino")

  @@index([uploadId, numero])
  @@index([disciplinaId])
  @@index([projetoId, status])
  @@index([documentoId, numero])
  @@index([uploadVerificacaoId])
  @@index([excluidoPorId])
  @@map("pendencia")
}

/// Thread de resposta do apontamento (item 39) — abre o ciclo pro projetista responder, não
/// só mudar status. Fica ancorada na `Pendencia` (que por sua vez é ancorada no documento,
/// não na versão), então a conversa sobrevive às revisões junto com o apontamento.
/// Sem soft delete: a thread É a trilha; resposta publicada não some.
/// Calibração de escala de UMA página de prancha (item 28). Guarda o resultado dos dois modos
/// que o solicitante pediu — declarar a escala (1:50) ou calibrar por dois pontos conhecidos —
/// normalizados na mesma grandeza: `mmPorPonto`.
///
/// Ancorada no DOCUMENTO, não na versão: revisão nova da mesma prancha mantém a escala, que é
/// o comportamento esperado (recalibrar é um clique se mudar). `uploadId` é o fallback da linha
/// legada sem documento pai, igual ao resto do módulo. Exatamente UM dos dois é preenchido, e
/// cada `@@unique` guarda a sua população — no Postgres o NULL não colide, então a chave com
/// `documentoId` nulo passaria batido se não houvesse a segunda.
model CalibracaoPrancha {
  id                String               @id @default(cuid())
  documentoId       String?
  documento         DocumentoDisciplina? @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  uploadId          String?
  upload            Upload?              @relation("UploadCalibracoes", fields: [uploadId], references: [id], onDelete: Cascade)
  pagina            Int
  /// escala | dois_pontos
  modo              String
  /// Denominador da escala declarada (50 para 1:50). Nulo no modo `dois_pontos`.
  escalaDenominador Int?
  /// mm REAIS por PONTO do PDF — é o que a medição consome, nos dois modos.
  mmPorPonto        Float
  autorId           String
  autor             User                 @relation("CalibracaoAutor", fields: [autorId], references: [id], onDelete: Cascade)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([documentoId, pagina])
  @@unique([uploadId, pagina])
  @@index([autorId])
  @@map("calibracao_prancha")
}

/// Referência cruzada entre apontamentos (item 13): "isto se relaciona com o #7 da prancha
/// de estrutura". Aponta para outra PENDÊNCIA — e como pendência já está ancorada no
/// documento (item 1), a referência sobrevive às revisões dos dois lados.
///
/// Direcional mas exibida nos dois sentidos: quem abre o #7 precisa saber que alguém o
/// referenciou, senão a metade útil da informação fica invisível.
model ReferenciaPendencia {
  id        String    @id @default(cuid())
  origemId  String
  origem    Pendencia @relation("ReferenciaOrigem", fields: [origemId], references: [id], onDelete: Cascade)
  destinoId String
  destino   Pendencia @relation("ReferenciaDestino", fields: [destinoId], references: [id], onDelete: Cascade)
  nota      String?
  autorId   String
  autor     User      @relation("ReferenciaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([origemId, destinoId])
  @@index([destinoId])
  @@index([autorId])
  @@map("referencia_pendencia")
}

/// Apontamento-padrão (item 10): frases recorrentes por disciplina, pra não redigitar
/// "cota ausente na planta baixa" a cada revisão. Catálogo de DADO (o usuário cadastra),
/// ao contrário do vocabulário fixo de severidade/tipo, que vive em código.
model ApontamentoPadrao {
  id           String      @id @default(cuid())
  /// Nulo = vale para qualquer disciplina (geral).
  disciplinaId String?
  disciplina   Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  texto        String
  /// Pré-classificação sugerida ao aplicar (itens 11) — opcional.
  severidade   String?
  tipo         String?
  /// Quantas vezes já foi usado — ordena o autocomplete pelo que a equipe mais usa.
  usos         Int         @default(0)
  ativo        Boolean     @default(true)
  autorId      String
  autor        User        @relation("ApontamentoPadraoAutor", fields: [autorId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([disciplinaId, ativo])
  @@index([autorId])
  @@map("apontamento_padrao")
}

/// Anexo do apontamento (item 12) — print, foto, áudio, PDF ou link externo.
/// Campos de arquivo espelham `AnexoLead` de propósito (é a mesma forma que `salvarArquivo`
/// devolve), pra não existirem dois vocabulários diferentes pro mesmo conceito no schema.
/// **Sem transcrição de áudio** (decidido em R5): áudio entra como arquivo bruto.
model PendenciaAnexo {
  id          String    @id @default(cuid())
  pendenciaId String
  pendencia   Pendencia @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)
  /// arquivo | link
  tipo        String    @default("arquivo")
  /// Rótulo exibido (nome do arquivo, ou o título que a pessoa deu ao link).
  nome        String
  /// Preenchidos só quando `tipo = "arquivo"`.
  caminho     String?
  nomeArquivo String?
  mime        String?
  tamanho     Int?
  hashSha256  String?
  /// Preenchido só quando `tipo = "link"` — validado como http/https na action.
  url         String?
  /// Evidência antes/depois (item 7): `antes` | `depois`. Nulo = anexo comum do item 12.
  ///
  /// É uma COLUNA no anexo, não uma tabela nova, porque a decisão R4 pediu **histórico completo
  /// versionado** e não "o último snapshot de cada lado": com N linhas por momento ordenadas por
  /// `createdAt`, o histórico sai de graça. Uma tabela `PendenciaEvidencia` com dois campos de
  /// arquivo guardaria só o último e duplicaria upload, download, hash e remoção.
  momento     String?
  autorId     String
  autor       User      @relation("PendenciaAnexoAutor", fields: [autorId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([pendenciaId, createdAt])
  @@index([autorId])
  @@map("pendencia_anexo")
}

model PendenciaResposta {
  id          String    @id @default(cuid())
  pendenciaId String
  pendencia   Pendencia @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)
  autorId     String
  autor       User      @relation("PendenciaRespostaAutor", fields: [autorId], references: [id], onDelete: Cascade)
  texto       String
  createdAt   DateTime  @default(now())

  @@index([pendenciaId, createdAt])
  @@index([autorId])
  @@map("pendencia_resposta")
}

/// N-43: Aceite digital do cliente para uma entrega validada.
model AceiteCliente {
  id           String    @id @default(cuid())
  uploadId     String    @unique
  upload       Upload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  token        String    @unique
  /// pendente | aceito | revisao
  situacao     String    @default("pendente")
  respondidoEm DateTime?
  observacao   String?
  geradoPorId  String
  geradoPor    User      @relation("AceiteGerador", fields: [geradoPorId], references: [id])
  createdAt    DateTime  @default(now())

  @@map("aceite_cliente")
}

/// Coordenação BIM: vista salva (câmera + visibilidade de modelos + corte).
/// Compartilhada por projeto; pode ser restaurada por qualquer membro.
model VistaCoordenacao {
  id              String   @id @default(cuid())
  projetoId       String
  nome            String
  /// { position, target } em espaço IFC (Z-up) — mesmo shape de CameraApontamento.
  camera          Json
  /// uploadId[] dos modelos visíveis quando a vista foi salva (prefixo d: p/ recebidos).
  modelosVisiveis Json
  /// CorteConfig (eixo/posicao/invertido) ou null.
  corte           Json?
  autorId         String
  createdAt       DateTime @default(now())

  @@index([projetoId])
  @@map("vista_coordenacao")
}

/// Coordenação BIM: estado da conversão IFC → Fragments (.frag) de um Upload.
/// 1:1 com o Upload (cada versão de IFC tem a sua). O .frag fica em disco
/// (caminho relativo a STORAGE_BASE_PATH), gerado por job pg-boss em child process.
model ConversaoModelo {
  id                String           @id @default(cuid())
  /// Origem do modelo: EXATAMENTE um de `uploadId` (IFC de disciplina) ou
  /// `documentoVersaoId` (IFC recebido do cliente, repositório Documento). A regra
  /// "exatamente um" é garantida em código (enfileirarConversao / …Documento).
  uploadId          String?          @unique
  upload            Upload?          @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  documentoVersaoId String?          @unique
  documentoVersao   DocumentoVersao? @relation(fields: [documentoVersaoId], references: [id], onDelete: Cascade)
  /// fila | processando | concluido | erro
  status            String           @default("fila")
  /// Progresso 0–100 durante `processando` (reportado pelo converter). Barra na UI.
  progresso         Int?
  /// Caminho relativo a STORAGE_BASE_PATH (nunca absoluto).
  caminhoFrag       String?
  tamanhoFrag       Int?
  erro              String?
  duracaoMs         Int?
  tentativas        Int              @default(0)
  iniciadoEm        DateTime?
  concluidoEm       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@map("conversao_modelo")
}

/// Visualizador DWG: estado da conversão DWG → DXF (via ODA File Converter,
/// subprocesso externo — ver modules/dwg/). Mesmo desenho de `ConversaoModelo`,
/// tabela própria (não reaproveita a do IFC: job de limpeza/rota de streaming
/// são específicos de cada fluxo).
model ConversaoDesenho {
  id                String           @id @default(cuid())
  /// Origem do desenho: EXATAMENTE um de `uploadId` (DWG de disciplina) ou
  /// `documentoVersaoId` (DWG recebido do cliente, repositório Documento). A regra
  /// "exatamente um" é garantida em código (enfileirarConversaoDwg).
  uploadId          String?          @unique
  upload            Upload?          @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  documentoVersaoId String?          @unique
  documentoVersao   DocumentoVersao? @relation(fields: [documentoVersaoId], references: [id], onDelete: Cascade)
  /// fila | processando | concluido | erro
  status            String           @default("fila")
  /// Progresso 0–100 durante `processando` (grosseiro — ODA não reporta progresso
  /// fino, ver spike F0.1). Barra na UI.
  progresso         Int?
  /// Caminho relativo a STORAGE_BASE_PATH (nunca absoluto).
  caminhoDxf        String?
  tamanhoDxf        Int?
  erro              String?
  duracaoMs         Int?
  tentativas        Int              @default(0)
  iniciadoEm        DateTime?
  concluidoEm       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
  @@map("conversao_desenho")
}

/// Coordenação BIM: apontamento 3D (nota de compatibilização) ancorado em
/// elementos IFC (GUIDs) + câmera, no viewer federado. Espelha a Pendencia:
/// congela na versão (uploadId) do modelo em que nasceu, numeração sequencial
/// por PROJETO (nota é transversal a disciplinas), workflow
/// aberta|resolvida|fechada|descartada, pode virar item de Tarefa.
/// Câmera persistida já em espaço IFC (Z-up, metros) — viewer converte na borda.
/// `projetoId`/`disciplinaId` têm FK (Cascade/SetNull). O `uploadId` continua
/// DENORMALIZADO de propósito: é uma chave de modelo polimórfica (`modelo-ref.ts`,
/// uploadId cru ou `d:<versaoId>`) e o apontamento precisa SOBREVIVER à exclusão do
/// modelo em que nasceu (âncora de snapshot) — uma FK quebraria isso.
model ApontamentoCoordenacao {
  id             String      @id @default(cuid())
  projetoId      String
  projeto        Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  /// Disciplina do modelo apontado. NULL quando o apontamento é sobre um IFC
  /// recebido do cliente (repositório Documento), que não pertence a disciplina.
  disciplinaId   String?
  disciplina     Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)
  /// Referência ao modelo (polimórfica, SEM FK — ver comentário do model): uploadId
  /// cru (disciplina) ou `d:<documentoVersaoId>` (recebido do cliente).
  uploadId       String
  numero         Int
  titulo         String
  texto          String
  /// IfcGuids dos elementos selecionados (string[]).
  guids          Json
  /// Posição/direção/up da câmera, fov/escala, projeção e planos de corte.
  camera         Json
  snapshotPath   String?
  /// aberta | resolvida | fechada | descartada
  status         String      @default("aberta")
  prioridade     String?
  /// Guid do Topic gerado no export BCF (habilita round-trip futuro).
  bcfGuid        String?
  autorId        String
  tarefaId       String?
  tarefaItemId   String?
  resolvidoPorId String?
  resolvidoEm    DateTime?
  fechadoPorId   String?
  fechadoEm      DateTime?
  createdAt      DateTime    @default(now())

  @@index([projetoId, status])
  @@index([projetoId, numero])
  @@index([disciplinaId])
  @@map("apontamento_coordenacao")
}

enum StatusPagamento {
  pendente
  pago
  cancelado
}

/// Pagamento ao projetista por entrega validada. Na Onda 2 será
/// vinculado a um Lançamento financeiro (campo lancamentoId).
model PagamentoProjetista {
  id               String           @id @default(cuid())
  disciplinaId     String
  disciplina       Disciplina       @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  projetistaId     String
  projetista       User             @relation("PagamentoProjetista", fields: [projetistaId], references: [id])
  valor            Decimal          @db.Decimal(12, 2)
  tipoProfissional String // role do projetista no momento da liberação
  status           StatusPagamento  @default(pendente)
  liberadoEm       DateTime         @default(now())
  pagoEm           DateTime?
  observacao       String?
  lancamentoId     String? // vínculo futuro com o Financeiro (Onda 2)
  /// Lote de folha de projetistas (A8).
  folhaId          String?
  folha            FolhaProjetista? @relation(fields: [folhaId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projetistaId, status])
  @@index([disciplinaId])
  @@index([folhaId])
  @@map("pagamento_projetista")
}

enum StatusFolhaProjetista {
  aberta
  fechada
  paga
}

/// Lote mensal de pagamentos de projetistas (A8): agrupa PagamentoProjetista do período.
model FolhaProjetista {
  id        String                @id @default(cuid())
  ano       Int
  mes       Int
  status    StatusFolhaProjetista @default(aberta)
  total     Decimal               @default(0) @db.Decimal(14, 2)
  fechadaEm DateTime?
  pagaEm    DateTime?
  createdAt DateTime              @default(now())

  pagamentos PagamentoProjetista[]

  @@unique([ano, mes])
  @@map("folha_projetista")
}

/// Anexo (comprovante) de um lançamento financeiro (A6).
model LancamentoAnexo {
  id           String     @id @default(cuid())
  lancamentoId String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  caminho      String
  nome         String
  mime         String
  tamanho      Int
  autorId      String
  createdAt    DateTime   @default(now())

  @@index([lancamentoId])
  @@map("lancamento_anexo")
}

/// Trilha de mudanças de status de um lançamento (A6).
model LancamentoStatusHistorico {
  id           String     @id @default(cuid())
  lancamentoId String
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  de           String?
  para         String
  autorId      String?
  createdAt    DateTime   @default(now())

  @@index([lancamentoId])
  @@map("lancamento_status_historico")
}

// ─────────────────────────────────────────────────────────────
// Financeiro — Planejamento de Pagamentos (mesa de planejamento)
// ─────────────────────────────────────────────────────────────

enum StatusPlanejamento {
  rascunho
  analise
  aprovado
  executado
  cancelado
}

/// Cenário de planejamento de pagamentos: simula o uso do caixa disponível sobre
/// as contas em aberto, com ordem de prioridade e saldo acumulado recalculado no cliente.
model PlanejamentoPagamento {
  id              String             @id @default(cuid())
  nome            String
  status          StatusPlanejamento @default(rascunho)
  /// Saldo disponível informado para o planejamento.
  saldoDisponivel Decimal            @db.Decimal(14, 2)
  /// Janela de vencimentos considerada ao montar o plano (opcional).
  periodoIni      DateTime?          @db.Date
  periodoFim      DateTime?          @db.Date
  /// Filtros opcionais aplicados ao carregar as contas.
  contaId         String?
  conta           ContaBancaria?     @relation(fields: [contaId], references: [id])
  centroId        String?
  centro          CentroCusto?       @relation(fields: [centroId], references: [id])
  projetoId       String?
  projeto         Projeto?           @relation(fields: [projetoId], references: [id])
  observacoes     String?
  responsavelId   String
  responsavel     User               @relation(fields: [responsavelId], references: [id])
  /// Aprovação/execução (scalars sem relação, como no padrão do Lancamento).
  aprovadoPorId   String?
  aprovadoEm      DateTime?
  executadoEm     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  linhas PlanejamentoLinha[]

  @@index([status])
  @@map("planejamento_pagamento")
}

/// Linha do plano: um lançamento previsto (a pagar/receber) com ordem de prioridade
/// e valor planejado (parcial permitido). O saldo acumulado é calculado, não persistido.
model PlanejamentoLinha {
  id             String                @id @default(cuid())
  planoId        String
  plano          PlanejamentoPagamento @relation(fields: [planoId], references: [id], onDelete: Cascade)
  lancamentoId   String
  lancamento     Lancamento            @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  ordem          Int                   @default(0)
  valorPlanejado Decimal               @db.Decimal(14, 2)
  selecionada    Boolean               @default(true)

  @@unique([planoId, lancamentoId])
  @@index([planoId])
  @@map("planejamento_linha")
}

// ─────────────────────────────────────────────────────────────
// Financeiro — Fechamento Mensal
// ─────────────────────────────────────────────────────────────

enum StatusFechamento {
  aberto
  fechado
}

/// Consolidação financeira do mês: receita/despesa confirmadas + folha de projetistas
/// com retenções/descontos automáticos (alíquotas configuráveis). Snapshot ao gerar.
model FechamentoMensal {
  id                String           @id @default(cuid())
  ano               Int
  mes               Int
  status            StatusFechamento @default(aberto)
  receitaConfirmada Decimal          @default(0) @db.Decimal(14, 2)
  despesaConfirmada Decimal          @default(0) @db.Decimal(14, 2)
  folhaBruta        Decimal          @default(0) @db.Decimal(14, 2)
  retencaoIss       Decimal          @default(0) @db.Decimal(14, 2)
  retencaoInss      Decimal          @default(0) @db.Decimal(14, 2)
  retencaoIr        Decimal          @default(0) @db.Decimal(14, 2)
  descontos         Decimal          @default(0) @db.Decimal(14, 2)
  /// Snapshot das alíquotas (%) aplicadas no momento da geração.
  aliquotas         Json?
  observacoes       String?
  responsavelId     String
  responsavel       User             @relation(fields: [responsavelId], references: [id])
  fechadoEm         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([ano, mes])
  @@index([status])
  @@map("fechamento_mensal")
}

/// Snapshot mensal de métricas de licitação (série histórica do funil).
model LicitacaoMetricaMensal {
  id             String   @id @default(cuid())
  ano            Int
  mes            Int
  totalAbertas   Int      @default(0)
  totalGanhas    Int      @default(0)
  totalPerdidas  Int      @default(0)
  valorGanho     Decimal  @default(0) @db.Decimal(14, 2)
  valorPerdido   Decimal  @default(0) @db.Decimal(14, 2)
  valorEmDisputa Decimal  @default(0) @db.Decimal(14, 2)
  createdAt      DateTime @default(now())

  @@unique([ano, mes])
  @@map("licitacao_metrica_mensal")
}

// ─────────────────────────────────────────────────────────────
// Ferramentas de Engenharia (F0)
// ─────────────────────────────────────────────────────────────

/// Snapshot persistido de um cálculo de ferramenta de engenharia.
/// entradasJson e resultadoJson são o input/output do engine no momento do salvamento.
/// Anotação/Registro de Responsabilidade Técnica de um projeto. Pode haver várias por projeto
/// (uma por disciplina, por etapa, ou complementares). O histórico fica em ArtVersao — este
/// registro "cabeça" carrega sempre os dados da versão vigente.
model Art {
  id           String      @id @default(cuid())
  projetoId    String
  projeto      Projeto     @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  /// Disciplina a que a ART se refere. Nulo = ART do projeto como um todo.
  disciplinaId String?
  disciplina   Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)

  /// "ART" (CREA) | "RRT" (CAU) | "TRT" (CFT).
  tipo      String    @default("ART")
  /// Número do documento no conselho.
  numero    String
  descricao String?
  /// rascunho | registrada | baixada | cancelada | substituida
  situacao  String    @default("registrada")
  emitidaEm DateTime? @db.Date
  /// Valor pago da taxa (controle de custo do projeto).
  valor     Decimal?  @db.Decimal(10, 2)

  /// Responsável técnico: usuário do sistema (preferencial) OU nome/registro avulsos.
  responsavelUserId   String?
  responsavelUser     User?   @relation("ArtResponsavel", fields: [responsavelUserId], references: [id])
  responsavelNome     String?
  responsavelRegistro String?

  /// Caminho relativo a STORAGE_BASE_PATH (nunca absoluto).
  arquivoPath String?
  arquivoNome String?

  versoes  ArtVersao[]
  calculos CalculoFerramenta[]

  autorId   String
  autor     User     @relation("ArtAutor", fields: [autorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projetoId])
  @@index([disciplinaId])
  @@map("art")
}

/// Uma versão da ART (substituição/aditivo/baixa). `numero` é sequencial por ART, começando em 1.
model ArtVersao {
  id          String    @id @default(cuid())
  artId       String
  art         Art       @relation(fields: [artId], references: [id], onDelete: Cascade)
  numero      Int
  numeroArt   String
  situacao    String
  emitidaEm   DateTime? @db.Date
  arquivoPath String?
  arquivoNome String?
  /// Por que esta versão existe (ex.: "substituída por alteração de área").
  observacao  String?
  autorId     String
  autor       User      @relation("ArtVersaoAutor", fields: [autorId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([artId, numero])
  @@map("art_versao")
}

model CalculoFerramenta {
  id            String  @id @default(cuid())
  /// Chave estável da ferramenta (ex.: "U01", "E01") — igual ao registry.ts.
  ferramenta    String
  titulo        String
  /// Norma de referência aplicada (ex.: "NBR 6118:2023"). Nulo para ferramentas sem norma.
  norma         String?
  /// Versão do engine de cálculo (incrementada quando a lógica muda e salva incompatibilidades).
  versaoCalc    Int     @default(1)
  entradasJson  Json
  resultadoJson Json

  autorId      String
  autor        User        @relation(fields: [autorId], references: [id])
  projetoId    String?
  projeto      Projeto?    @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  disciplinaId String?
  disciplina   Disciplina? @relation(fields: [disciplinaId], references: [id], onDelete: SetNull)

  /// ART do projeto associada a este memorial (cabeçalho técnico do PDF).
  artId               String?
  art                 Art?    @relation(fields: [artId], references: [id], onDelete: SetNull)
  /// Snapshot do responsável no momento da emissão — NÃO acompanha alterações posteriores no
  /// cadastro da pessoa: memorial é registro técnico datado.
  responsavelNome     String?
  responsavelRegistro String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([autorId, ferramenta, createdAt])
  @@index([projetoId])
  @@map("calculo_ferramenta")
}

// ─────────────────────────────────────────────────────────────
// Patrimônio / Ativos (Mód 16 do CONSELHO1)
// ─────────────────────────────────────────────────────────────

/// Item do inventário do escritório (equipamentos, mobiliário, veículos…).
model Ativo {
  id            String     @id @default(cuid())
  nome          String
  categoria     String? // ex.: Computador, Mobiliário, Veículo, Periférico…
  localizacao   String?
  responsavelId String?
  responsavel   User?      @relation("AtivoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  dataAquisicao DateTime?  @db.Date
  valor         Decimal?   @db.Decimal(12, 2)
  /// ativo | manutencao | baixado
  status        String     @default("ativo")
  observacao    String?
  /// Se este ativo é uma máquina de TI gerenciada (1:1 opcional).
  maquina       MaquinaTI?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([categoria])
  @@index([status])
  @@map("ativo")
}

/// PC/estação gerenciada pela TI — specs + peças + histórico de manutenção.
model MaquinaTI {
  id            String              @id @default(cuid())
  nome          String
  /// Vínculo opcional ao item de inventário correspondente.
  patrimonioId  String?             @unique
  patrimonio    Ativo?              @relation(fields: [patrimonioId], references: [id], onDelete: SetNull)
  responsavelId String?
  responsavel   User?               @relation("MaquinaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  // Specs livres (texto)
  cpu           String?
  ram           String?
  armazenamento String?
  so            String? // sistema operacional
  observacao    String?
  componentes   ComponenteMaquina[]
  manutencoes   ManutencaoMaquina[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([responsavelId])
  @@map("maquina_ti")
}

/// Peça/componente instalado numa máquina.
model ComponenteMaquina {
  id         String    @id @default(cuid())
  maquinaId  String
  maquina    MaquinaTI @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  tipo       String // ex.: Memória, SSD, GPU, Fonte, Placa-mãe
  descricao  String
  quantidade Int       @default(1)
  createdAt  DateTime  @default(now())

  @@index([maquinaId])
  @@map("componente_maquina")
}

/// Registro de manutenção/troca de uma máquina.
model ManutencaoMaquina {
  id        String    @id @default(cuid())
  maquinaId String
  maquina   MaquinaTI @relation(fields: [maquinaId], references: [id], onDelete: Cascade)
  data      DateTime  @db.Date
  descricao String
  custo     Decimal?  @db.Decimal(12, 2)
  createdAt DateTime  @default(now())

  @@index([maquinaId])
  @@map("manutencao_maquina")
}

// ─────────────────────────────────────────────────────────────
// Engenharia de Custos (trabalho concorrente — reintegrado de stash após a
// migration 20260728120000_custos_fundacao ter sido aplicada por outra sessão)
// ─────────────────────────────────────────────────────────────

enum StatusCustoOrcamento {
  rascunho
  em_elaboracao
  concluido
  aprovado
  cancelado
}

enum CustoRegimeEncargos {
  desonerado
  nao_desonerado
}

enum CustoTipoItem {
  grupo
  servico
}

/// Cabeçalho do orçamento de obra. FK de projeto opcional (D1: estudo avulso via `nomeAvulso`).
model CustoOrcamento {
  id        String               @id @default(cuid())
  titulo    String
  descricao String?
  status    StatusCustoOrcamento @default(rascunho)

  /// Um dos dois é obrigatório (regra aplicada no Zod + service, não no banco): obra real ancora
  /// em `Projeto`; estudo avulso/terceiro usa `nomeAvulso`.
  projetoId  String?
  projeto    Projeto? @relation(fields: [projetoId], references: [id])
  /// Preenchido quando o orçamento NÃO tem `Projeto` (estudo avulso, orçamento para terceiros).
  nomeAvulso String?

  /// Contratante, quando diferente do cliente do projeto (ou em orçamento avulso).
  contratanteId   String?
  contratante     Cliente? @relation(fields: [contratanteId], references: [id])
  contratanteNome String?

  /// Data-base dos preços de todo o orçamento (SINAPI/SICRO/etc. publicam por mês).
  /// É o dado do DOCUMENTO (sai no cabeçalho impresso); de onde o preço vem é `basePrecoId`.
  dataBase DateTime @db.Date

  /// Base de preço usada para resolver o custo dos itens. Trocar esta FK É a "troca de data-base"
  /// (o relatório de impacto compara os dois lados). Nulo = orçamento ainda sem base escolhida.
  basePrecoId String?
  basePreco   CustoBasePreco? @relation("OrcamentoBasePreco", fields: [basePrecoId], references: [id])

  // BDI — Acórdão TCU 2622/2013 (percentuais editáveis; `bdiPercentual` é o resultado materializado).
  bdiAdmCentral          Decimal  @default(0) @db.Decimal(5, 2)
  bdiSeguro              Decimal  @default(0) @db.Decimal(5, 2)
  bdiRisco               Decimal  @default(0) @db.Decimal(5, 2)
  bdiGarantia            Decimal  @default(0) @db.Decimal(5, 2)
  bdiDespesasFinanceiras Decimal  @default(0) @db.Decimal(5, 2)
  bdiLucro               Decimal  @default(0) @db.Decimal(5, 2)
  bdiPis                 Decimal  @default(0) @db.Decimal(5, 2)
  bdiCofins              Decimal  @default(0) @db.Decimal(5, 2)
  bdiIss                 Decimal  @default(0) @db.Decimal(5, 2)
  bdiCprb                Decimal  @default(0) @db.Decimal(5, 2)
  /// Resultado materializado de `bdi.ts#calcularBdi` no momento do cálculo — não recalculado a
  /// cada leitura, para a revisão ficar reproduzível anos depois.
  bdiPercentual          Decimal? @db.Decimal(5, 2)

  // Encargos sociais de obra (Grupos A/B/C/D — ver `encargos-obra.ts`).
  regimeEncargos        CustoRegimeEncargos @default(nao_desonerado)
  /// Preset de rubricas usado como base (ex.: "sinapi"). Hoje só existe `PRESET_ENCARGOS_SINAPI`.
  encargosPreset        String              @default("sinapi")
  /// Override por rubrica: `{ codigo, horista?, mensalista? }[]` — ver `OverrideEncargo`.
  encargosOverridesJson Json?
  /// Resultados materializados de `encargos-obra.ts#calcularEncargos`.
  encargosHoristaPct    Decimal?            @db.Decimal(5, 2)
  encargosMensalistaPct Decimal?            @db.Decimal(5, 2)

  /// Ponte financeira RESERVADA (D4) — sem uso funcional na Onda C0. A geração de `Lancamento`
  /// previsto acontece hoje só pelo caminho licitação/proposta (`MedicaoLicitacao`), não por aqui.
  licitacaoId String?
  licitacao   Licitacao? @relation(fields: [licitacaoId], references: [id])

  criadoPorId String
  criadoPor   User   @relation("CustoOrcamentoCriador", fields: [criadoPorId], references: [id])

  revisoes      CustoOrcamentoRevisao[]
  itens         CustoOrcamentoItem[]
  quantitativos CustoQuantitativo[]
  rfqs          CustoRfq[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projetoId])
  @@index([status])
  @@index([licitacaoId])
  @@index([contratanteId])
  @@index([criadoPorId])
  @@index([basePrecoId])
  @@map("custo_orcamento")
}

/// Snapshot imutável de uma revisão do orçamento. Nunca sofre UPDATE/DELETE — nova revisão é
/// sempre um novo `numero`. Quem escreve aqui é a Onda C6; o model só é declarado agora.
model CustoOrcamentoRevisao {
  id               String         @id @default(cuid())
  orcamentoId      String
  orcamento        CustoOrcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  numero           Int
  /// Snapshot completo do orçamento (cabeçalho + árvore de itens) no momento da revisão.
  snapshotJson     Json
  valorTotal       Decimal        @db.Decimal(14, 2)
  valorTotalComBdi Decimal        @db.Decimal(14, 2)
  dataBase         DateTime       @db.Date

  criadoPorId String
  criadoPor   User   @relation("CustoOrcamentoRevisaoCriador", fields: [criadoPorId], references: [id])

  createdAt DateTime @default(now())

  @@unique([orcamentoId, numero])
  @@index([orcamentoId])
  @@map("custo_orcamento_revisao")
}

/// Nó da árvore do orçamento (grupo ou serviço). CRUD e roll-up persistido são da Onda C2 — o
/// model é declarado agora porque `orcamento-arvore.ts` (motor puro) já opera sobre este formato.
model CustoOrcamentoItem {
  id          String               @id @default(cuid())
  orcamentoId String
  orcamento   CustoOrcamento       @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      CustoOrcamentoItem?  @relation("CustoItemFilhos", fields: [parentId], references: [id], onDelete: Cascade)
  filhos      CustoOrcamentoItem[] @relation("CustoItemFilhos")

  tipo      CustoTipoItem
  /// Código WBS materializado (1.2.3) — recalculado por `orcamento-arvore.ts#calcularCodigosWbs`.
  codigo    String
  ordem     Int           @default(0)
  descricao String
  unidade   String?

  quantidade    Decimal  @default(0) @db.Decimal(12, 2)
  /// Custo unitário materializado (da composição, ou digitado). Ver `bloqueado`.
  custoUnitario Decimal  @default(0) @db.Decimal(14, 2)
  /// null = herda do pai mais próximo com valor, ou do orçamento (`bdiEfetivo`).
  bdiPercentual Decimal? @db.Decimal(5, 2)
  /// Preço travado — não recalcula ao trocar a base de preços (C2).
  bloqueado     Boolean  @default(false)

  /// Totais materializados pelo roll-up (`orcamento-arvore.ts`) — nunca calculados na leitura.
  totalSemBdi Decimal @default(0) @db.Decimal(14, 2)
  totalComBdi Decimal @default(0) @db.Decimal(14, 2)

  /// Composição de origem do custo. Null = insumo direto (ver insumoId) ou custo digitado à mão (item antigo).
  composicaoId     String?
  composicao       CustoComposicao? @relation(fields: [composicaoId], references: [id], onDelete: SetNull)
  /// Insumo direto (sem composição) de origem do custo. Nunca setado junto com composicaoId — cada
  /// vincular*() zera o outro campo explicitamente.
  insumoId         String?
  insumo           CustoInsumo?     @relation(fields: [insumoId], references: [id], onDelete: SetNull)
  /// MATERIALIZAÇÃO (design §7): de qual base o `custoUnitario` gravado veio, e quando. É isto que
  /// torna a revisão reproduzível anos depois — apagar a base NÃO apaga o custo já gravado.
  basePrecoUsadaId String?
  basePrecoUsada   CustoBasePreco?  @relation("ItemBaseUsada", fields: [basePrecoUsadaId], references: [id], onDelete: SetNull)
  custoCalculadoEm DateTime?

  quantitativos CustoQuantitativo[]
  vinculosBim   CustoVinculoBim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orcamentoId, codigo])
  @@index([orcamentoId])
  @@index([parentId])
  @@index([composicaoId])
  @@index([insumoId])
  @@index([basePrecoUsadaId])
  @@map("custo_orcamento_item")
}

// ───────────────────────────── Engenharia de Custos (Onda C1) ─────────────────────────────
// Banco de insumos, composições (com auxiliar recursivo) e bases de preço, importados do SINAPI
// ou cadastrados como composição própria. `CustoBasePreco.uf`/`regime` usam sentinela
// ("NACIONAL"/"padrao") em vez de nulo — nulo não força unicidade no Postgres (NULL ≠ NULL) e
// composição não tem UF (só o preço tem): sem o sentinela, cada UF×regime importado duplicaria a
// estrutura inteira da composição. Base "estrutural" (uf=NACIONAL) ancora CustoComposicao; bases
// de preço (uf=sigla real) ancoram só CustoPreco.

enum CategoriaInsumo {
  servicos
  material
  mao_de_obra
  encargos_complementares
  equipamento
  especiais
}

enum TipoItemComposicao {
  insumo
  composicao
}

model CustoInsumo {
  id                   String                @id @default(cuid())
  /// Código estável na fonte (ex.: SINAPI). Nunca reescrito ao reimportar — só upsert.
  codigo               String
  fonte                String
  descricao            String
  unidade              String
  categoria            CategoriaInsumo
  precos               CustoPreco[]
  itensUsando          CustoComposicaoItem[]
  rfqItens             CustoRfqItem[]
  precoHistorico       CustoPrecoHistorico[]
  /// Itens de orçamento vinculados diretamente (sem composição intermediária) a este insumo.
  itensOrcamentoDireto CustoOrcamentoItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([fonte, codigo])
  @@index([fonte])
  @@map("custo_insumo")
}

/// Base de preço (uf = sigla real) OU base estrutural (uf = "NACIONAL", âncora de CustoComposicao).
model CustoBasePreco {
  id          String               @id @default(cuid())
  nome        String
  fonte       String
  uf          String               @default("NACIONAL")
  /// sem_desoneracao | com_desoneracao | sem_encargos | padrao (padrao = estrutural/própria)
  regime      String               @default("padrao")
  dataBase    DateTime             @db.Date
  ativo       Boolean              @default(true)
  precos      CustoPreco[]
  composicoes CustoComposicao[]
  /// Orçamentos que apontam para esta base como fonte de preço corrente (C2).
  orcamentos  CustoOrcamento[]     @relation("OrcamentoBasePreco")
  /// Itens cujo `custoUnitario` foi materializado a partir desta base (C2).
  itensUsando CustoOrcamentoItem[] @relation("ItemBaseUsada")
  createdAt   DateTime             @default(now())

  @@unique([fonte, uf, regime, dataBase])
  @@index([fonte, uf])
  @@map("custo_base_preco")
}

model CustoPreco {
  id        String         @id @default(cuid())
  baseId    String
  base      CustoBasePreco @relation(fields: [baseId], references: [id], onDelete: Cascade)
  insumoId  String
  insumo    CustoInsumo    @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  valor     Decimal        @db.Decimal(14, 2)
  createdAt DateTime       @default(now())

  @@unique([baseId, insumoId])
  @@index([insumoId])
  @@map("custo_preco")
}

model CustoComposicao {
  id             String                @id @default(cuid())
  baseId         String
  base           CustoBasePreco        @relation(fields: [baseId], references: [id], onDelete: Cascade)
  codigo         String
  descricao      String
  unidade        String
  grupo          String?
  itens          CustoComposicaoItem[]
  /// Onde esta composição é usada como item AUXILIAR de outra (recursivo).
  usadaComoItem  CustoComposicaoItem[] @relation("ComposicaoAuxiliar")
  /// Itens de orçamento vinculados a esta composição (C2).
  itensOrcamento CustoOrcamentoItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([baseId, codigo])
  @@index([baseId])
  @@map("custo_composicao")
}

/// tipo=insumo → insumoId obrigatório/composicaoAuxId nulo; tipo=composicao → o inverso.
/// XOR validado em service.ts (Prisma não expressa isso entre 2 FKs opcionais).
model CustoComposicaoItem {
  id              String             @id @default(cuid())
  composicaoId    String
  composicao      CustoComposicao    @relation(fields: [composicaoId], references: [id], onDelete: Cascade)
  tipo            TipoItemComposicao
  insumoId        String?
  insumo          CustoInsumo?       @relation(fields: [insumoId], references: [id])
  composicaoAuxId String?
  composicaoAux   CustoComposicao?   @relation("ComposicaoAuxiliar", fields: [composicaoAuxId], references: [id])
  coeficiente     Decimal            @db.Decimal(12, 6)
  ordem           Int                @default(0)
  createdAt       DateTime           @default(now())

  @@index([composicaoId])
  @@index([insumoId])
  @@index([composicaoAuxId])
  @@map("custo_composicao_item")
}

/// Rastreio do import assíncrono — espelha ConversaoModelo (fila/processando/concluido/erro + progresso).
model CustoImportacao {
  id                 String    @id @default(cuid())
  fonte              String    @default("sinapi")
  dataBase           DateTime  @db.Date
  ufs                String[]
  regimes            String[]
  /// Caminho relativo a STORAGE_BASE_PATH (nunca absoluto).
  caminhoArquivo     String
  status             String    @default("fila")
  progresso          Int?
  insumosCriados     Int       @default(0)
  precosCriados      Int       @default(0)
  composicoesCriadas Int       @default(0)
  itensCriados       Int       @default(0)
  erro               String?
  autorId            String
  autor              User      @relation(fields: [autorId], references: [id])
  iniciadoEm         DateTime?
  concluidoEm        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@map("custo_importacao")
}

// ───────────────────────────── Engenharia de Custos (Onda C3) ─────────────────────────────
// Quantitativos com rastro até a fonte (IFC/DXF/PDF/manual) e vínculo item↔elemento BIM (5D).

enum CustoOrigemDado {
  manual
  ifc
  dwg
  pdf
  ia
}

enum CustoGrandeza {
  area
  volume
  comprimento
  contagem
  peso
}

/// Levantamento de quantidade com rastro até a fonte. Nunca é sobrescrito nem deletado
/// (regra 10): recontagem gera OUTRA linha; a antiga fica com `substituidoPorId`.
model CustoQuantitativo {
  id          String              @id @default(cuid())
  orcamentoId String
  orcamento   CustoOrcamento      @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  /// Item de orçamento que este levantamento alimenta. Null = levantamento solto (ainda não vinculado).
  itemId      String?
  item        CustoOrcamentoItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  descricao  String
  grandeza   CustoGrandeza
  unidade    String
  quantidade Decimal       @db.Decimal(12, 2)

  origem    CustoOrigemDado
  /// 0–1. Null = valor exato (manual conferido / quantity oficial do IFC). Costura de IA (design §8).
  confianca Decimal?        @db.Decimal(3, 2)

  // ── Rastro até a fonte (mesmo mecanismo de âncora de ApontamentoCoordenacao) ──
  /// uploadId cru (disciplina) ou `d:<documentoVersaoId>`, polimórfico SEM FK — igual ao apontamento.
  uploadId   String?
  /// IfcGuids dos elementos contados (string[]) — origem `ifc`.
  guids      Json?
  /// Página (1-based) — origem `pdf`.
  pagina     Int?
  /// Pontos/retângulo/escala da medição — origem `pdf`/`dwg`.
  ancoraJson Json?
  /// Memória de como se chegou ao número (fórmula digitada, filtro aplicado, régua do PDF).
  memoria    String?

  substituidoPorId String?            @unique
  substituidoPor   CustoQuantitativo? @relation("QuantitativoSubstituicao", fields: [substituidoPorId], references: [id], onDelete: SetNull)
  substitui        CustoQuantitativo? @relation("QuantitativoSubstituicao")

  criadoPorId String
  criadoPor   User     @relation(fields: [criadoPorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orcamentoId])
  @@index([itemId])
  @@index([uploadId])
  @@index([criadoPorId])
  @@map("custo_quantitativo")
}

/// Ligação item de orçamento ↔ elemento IFC — a base do 5D e do destaque no viewer.
model CustoVinculoBim {
  id        String             @id @default(cuid())
  itemId    String
  item      CustoOrcamentoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Polimórfico SEM FK, igual ApontamentoCoordenacao.uploadId.
  uploadId  String
  /// IfcGuid do elemento. Um vínculo por (item, guid).
  ifcGuid   String
  createdAt DateTime           @default(now())

  @@unique([itemId, ifcGuid])
  @@index([itemId])
  @@index([uploadId])
  @@map("custo_vinculo_bim")
}

/// Suprimentos (Onda C4) — contato de um fornecedor. Mesma forma de FornecedorServico.
model CustoFornecedorRepresentante {
  id           String          @id @default(cuid())
  fornecedorId String
  fornecedor   CustoFornecedor @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  nome         String
  cargo        String?
  telefone     String?
  email        String?
  ativo        Boolean         @default(true)
  createdAt    DateTime        @default(now())

  @@index([fornecedorId])
  @@map("custo_fornecedor_representante")
}

enum CustoStatusRfq {
  rascunho
  aberta
  encerrada
  cancelada
}

enum CustoStatusConvite {
  convidado
  respondido
  sem_resposta
}

enum CustoStatusProposta {
  recebida
  vencedora
  nao_escolhida
}

model CustoRfq {
  id            String          @id @default(cuid())
  /// Opcional — RFQ de obra (ligada a um orçamento) ou compra avulsa/recorrente.
  orcamentoId   String?
  orcamento     CustoOrcamento? @relation(fields: [orcamentoId], references: [id])
  titulo        String
  descricao     String?
  status        CustoStatusRfq  @default(rascunho)
  prazoResposta DateTime?       @db.Date
  criadoPorId   String
  criadoPor     User            @relation("RfqCriadoPor", fields: [criadoPorId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  itens     CustoRfqItem[]
  convites  CustoRfqConvite[]
  propostas CustoProposta[]

  @@index([orcamentoId])
  @@index([status])
  @@map("custo_rfq")
}

model CustoRfqItem {
  id         String       @id @default(cuid())
  rfqId      String
  rfq        CustoRfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  /// Link opcional pro banco de insumos — habilita rastro de preço histórico por insumo.
  /// Null = item fora do catálogo (aluguel específico, serviço avulso).
  insumoId   String?
  insumo     CustoInsumo? @relation(fields: [insumoId], references: [id])
  descricao  String
  quantidade Decimal      @db.Decimal(12, 2)
  unidade    String

  propostaItens CustoPropostaItem[]

  @@index([rfqId])
  @@index([insumoId])
  @@map("custo_rfq_item")
}

model CustoRfqConvite {
  id           String             @id @default(cuid())
  rfqId        String
  rfq          CustoRfq           @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  fornecedorId String
  fornecedor   CustoFornecedor    @relation(fields: [fornecedorId], references: [id])
  status       CustoStatusConvite @default(convidado)
  convidadoEm  DateTime           @default(now())
  respondidoEm DateTime?

  @@unique([rfqId, fornecedorId])
  @@index([rfqId])
  @@index([fornecedorId])
  @@map("custo_rfq_convite")
}

model CustoProposta {
  id                   String              @id @default(cuid())
  rfqId                String
  rfq                  CustoRfq            @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  fornecedorId         String
  fornecedor           CustoFornecedor     @relation(fields: [fornecedorId], references: [id])
  status               CustoStatusProposta @default(recebida)
  frete                Decimal?            @db.Decimal(14, 2)
  /// true = preço unitário do item já inclui impostos; comparador NÃO soma `impostosValor` de novo.
  impostosInclusos     Boolean             @default(true)
  /// Informativo — quanto o fornecedor destacou de imposto, só pra leitura humana quando incluso.
  impostosValor        Decimal?            @db.Decimal(14, 2)
  prazoEntregaDias     Int?
  validadeAte          DateTime?           @db.Date
  condicoesPagamento   String?
  observacoes          String?
  /// Obrigatório só quando status vira `vencedora` (validado em service.ts, não no banco).
  justificativaEscolha String?
  escolhidoPorId       String?
  escolhidoPor         User?               @relation("PropostaEscolhidaPor", fields: [escolhidoPorId], references: [id])
  escolhidoEm          DateTime?
  criadoPorId          String
  criadoPor            User                @relation("PropostaCriadaPor", fields: [criadoPorId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  itens       CustoPropostaItem[]
  anexos      CustoPropostaAnexo[]
  precoGerado CustoPrecoHistorico[]

  @@index([rfqId])
  @@index([fornecedorId])
  @@map("custo_proposta")
}

model CustoPropostaItem {
  id            String        @id @default(cuid())
  propostaId    String
  proposta      CustoProposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  rfqItemId     String
  rfqItem       CustoRfqItem  @relation(fields: [rfqItemId], references: [id])
  precoUnitario Decimal       @db.Decimal(14, 2)
  observacao    String?

  @@unique([propostaId, rfqItemId])
  @@index([propostaId])
  @@index([rfqItemId])
  @@map("custo_proposta_item")
}

/// Mesma forma de LancamentoAnexo — sem passar por Upload/disciplina (proposta não pertence a projeto).
model CustoPropostaAnexo {
  id         String        @id @default(cuid())
  propostaId String
  proposta   CustoProposta @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  caminho    String
  nome       String
  mime       String
  tamanho    Int
  autorId    String
  autor      User          @relation(fields: [autorId], references: [id])
  createdAt  DateTime      @default(now())

  @@index([propostaId])
  @@map("custo_proposta_anexo")
}

/// Append-only — nunca deletar/atualizar. 1 linha por item da proposta vencedora, gravada na mesma
/// transação que marca a proposta `vencedora` (service.ts#escolherVencedor).
model CustoPrecoHistorico {
  id           String           @id @default(cuid())
  insumoId     String?
  insumo       CustoInsumo?     @relation(fields: [insumoId], references: [id])
  descricao    String
  fornecedorId String?
  fornecedor   CustoFornecedor? @relation(fields: [fornecedorId], references: [id])
  propostaId   String?
  proposta     CustoProposta?   @relation(fields: [propostaId], references: [id])
  valor        Decimal          @db.Decimal(14, 2)
  unidade      String
  data         DateTime         @db.Date
  createdAt    DateTime         @default(now())

  @@index([insumoId])
  @@index([fornecedorId])
  @@map("custo_preco_historico")
}

/// Item 8 — marca d'água de "até onde eu já analisei este documento".
///
/// Uma linha por (documento, pessoa), atualizada quando ela ABRE a prancha. Nasce vazia: quem
/// nunca abriu não tem linha, e a ausência é lida como "primeira visita" — sem novidades a
/// mostrar, não como "tudo é novo" (uma prancha com 40 apontamentos históricos gritaria "40
/// novidades" pra quem chegou agora, que é ruído, não informação).
///
/// A unidade é o DOCUMENTO, não o upload: revisão nova é justamente uma das coisas que a pessoa
/// precisa ver como novidade, então rastrear por versão perderia o sinal principal.
model LeituraDocumento {
  id          String              @id @default(cuid())
  documentoId String
  documento   DocumentoDisciplina @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation("LeituraDocumentoUsuario", fields: [userId], references: [id], onDelete: Cascade)
  /// Momento da última abertura. É o corte de "desde quando" das novidades.
  lidoEm      DateTime            @default(now())

  @@unique([documentoId, userId])
  @@index([userId])
  @@map("leitura_documento")
}
