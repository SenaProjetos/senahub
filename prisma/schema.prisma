/// Vínculo de trabalho de uma pessoa com a empresa — a fonte de verdade de
/// **como e onde** ela trabalha, com DATA.
///
/// É modelo, e não campo em `User`, porque contratação é um fato com início e fim, e a
/// mesma pessoa acumula vários ao longo do tempo (estagiário → CLT → PJ). Um campo
/// sobrescrevível apagaria qual era a jornada, o setor e a remuneração em qualquer data
/// passada — inviabilizando folha retroativa, rescisão e defesa em fiscalização.
///
/// A pessoa é SEMPRE o mesmo `User`: criar um segundo usuário na mudança de contratação
/// quebraria e-mail, chat, autoria de projeto, ARTs, aceites de termo e a trilha de auditoria.
///
/// Invariante: no máximo um vínculo `ativo` por usuário, apontado por `User.vinculoAtivoId`.
model Vinculo {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("VinculosDoUsuario", fields: [userId], references: [id], onDelete: Cascade)
  contratacao  Contratacao
  setor        Setor
  /// Cargo/função (texto livre, ex.: "Projetista de Estruturas Sênior"). NÃO é perfil de
  /// acesso — o que a pessoa É para o escritório, não o que ela pode clicar no sistema.
  cargo        String?
  /// Carga horária semanal contratada. Estágio tem teto legal de 30h (Lei 11.788, art. 10, II).
  cargaSemanal Decimal?        @db.Decimal(4, 1)
  /// Salário, bolsa, honorário ou pró-labore — conforme a contratação.
  remuneracao  Decimal?        @db.Decimal(12, 2)
  /// PJ que fatura por este vínculo (quando `contratacao` é `pj`).
  pjId         String?
  pj           PessoaJuridica? @relation(fields: [pjId], references: [id])

  dataInicio DateTime  @db.Date
  /// Encerramento: rescisão, fim de contrato, fim do estágio, distrato. Preencher em vez de
  /// desativar o usuário — hoje o sistema não tem rescisão, e desativar remove a pessoa da
  /// folha do próprio mês da saída.
  dataFim    DateTime? @db.Date
  motivoFim  String?
  ativo      Boolean   @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Lado inverso de `User.vinculoAtivoId`.
  usuarioAtivo User? @relation("VinculoAtivo")
  /// Alterações datadas de cargo/departamento/remuneração DENTRO deste vínculo.
  historico    HistoricoContratual[]

  @@index([userId, dataInicio])
  @@index([userId, ativo])
  @@index([pjId])
  @@map("vinculo")
}

/// Catálogo de cargos administrado pelo RH — substitui o texto livre que existia em
/// `User.cargo` e `Vinculo.cargo`.
///
/// Cargo é RÓTULO, não autorização: "Sócio" aqui não concede nada. Quem manda em acesso
/// continua sendo `PerfilAcesso`/`Role`, e a condição de sócio é a relação `Socio`.
///
/// Segue o padrão de `DisciplinaCatalogo`: arquiva-se (`ativo = false`) em vez de excluir,
/// para não quebrar quem já aponta para a linha.
model Cargo {
  id           String   @id @default(cuid())
  nome         String   @unique
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  users     User[]
  historico HistoricoContratual[]

  @@map("cargo")
}

/// Catálogo de departamentos administrado pelo RH — a subdivisão DENTRO de um setor.
///
/// `setor` é o eixo macro (enum, usado por `Vinculo` e perfil de acesso) e continua intocado;
/// departamento é o recorte fino e opcional. Nulo = departamento ainda não vinculado a um setor.
model Departamento {
  id           String   @id @default(cuid())
  nome         String   @unique
  setor        Setor?
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  users     User[]
  historico HistoricoContratual[]

  @@index([setor])
  @@map("departamento")
}

/// Alteração contratual DATADA de uma pessoa: cargo, departamento e remuneração com vigência.
///
/// É tabela-filha do vínculo, não uma nova linha de `Vinculo`. A razão é concreta: o ponto usa
/// `Vinculo.dataInicio` como PISO DE APURAÇÃO (`modules/ponto/apuracao.ts`). Fechar o vínculo a
/// cada reajuste faria um aumento no dia 15 jogar os dias 1–14 para fora da janela apurável.
/// `Vinculo` continua significando "período de vínculo empregatício"; o que muda DENTRO dele
/// vem para cá.
///
/// Cada linha é um SNAPSHOT do estado a partir de `vigenciaEm` — não um par campo/valor. Assim
/// cargo, departamento e remuneração nunca contam histórias incoerentes entre si, e o "valor
/// anterior → novo" sai de comparar linhas consecutivas.
///
/// O valor VIGENTE é a linha mais recente com `vigenciaEm <= hoje`; `User.salarioBase`,
/// `User.cargoId` e `User.departamentoId` são cache disso, escritos só por
/// `modules/rh/contratual/service.ts`.
model HistoricoContratual {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("HistoricoDoColaborador", fields: [userId], references: [id], onDelete: Cascade)

  /// Vínculo que cobria a data. Nulo para quem ainda não tem vínculo (backfill não rodou).
  vinculoId String?
  vinculo   Vinculo? @relation(fields: [vinculoId], references: [id], onDelete: SetNull)

  vigenciaEm DateTime @db.Date

  cargoId        String?
  cargo          Cargo?        @relation(fields: [cargoId], references: [id])
  departamentoId String?
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])
  /// Rótulos CONGELADOS na data. Renomear um item de catálogo corrige a grafia do presente —
  /// não pode reescrever o que estava escrito num registro contratual passado.
  cargoNome        String?
  departamentoNome String?

  remuneracao Decimal? @db.Decimal(12, 2)

  /// carga_inicial | admissao | reajuste | promocao | transferencia | correcao
  motivo     String?
  observacao String?

  /// Quem registrou. FK de verdade, ao contrário dos `autorId` soltos herdados de outros models.
  autorId String
  autor   User   @relation("HistoricoAutor", fields: [autorId], references: [id])

  criadoEm DateTime @default(now())

  @@index([userId, vigenciaEm])
  @@index([vinculoId])
  @@index([cargoId])
  @@index([departamentoId])
  @@index([autorId])
  @@map("historico_contratual")
}

/// Tipo da chave PIX. Determina a validação — ver `modules/rh/contas/pix.ts` (puro, testado).
enum TipoPix {
  cpf
  cnpj
  email
  telefone
  aleatoria
}

/// Conta bancária DE UM COLABORADOR (1:N). Nome longo de propósito: `ContaBancaria` já existe
/// e é a conta **da empresa**, do financeiro — os dois não têm relação.
///
/// Substitui os 4 escalares que viviam em `User` (banco/agencia/conta/tipoContaBancaria).
/// A conta principal não é um booleano aqui: é o ponteiro `User.contaBancariaPrincipalId`,
/// que por ser `@unique` garante no schema, e não em código, no máximo uma principal por
/// pessoa — mesmo padrão de `User.vinculoAtivoId`.
model ContaBancariaColaborador {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ContasDoColaborador", fields: [userId], references: [id], onDelete: Cascade)

  banco     String?
  agencia   String?
  conta     String?
  /// corrente | poupanca | salario | pagamento
  tipoConta String?
  /// Preencher quando a conta não é do próprio colaborador (ex.: conta conjunta).
  titular   String?

  pixTipo  TipoPix?
  /// Guardada NORMALIZADA (só dígitos / +55DDD… / minúscula), como `validarChavePix` devolve.
  pixChave String?

  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  /// Lado inverso de `User.contaBancariaPrincipalId`.
  usuarioPrincipal User? @relation("ContaPrincipal")

  @@index([userId])
  @@map("conta_bancaria_colaborador")
}

enum TipoTermo {
  colaborador
  cliente
}

/// Registro append-only do aceite do Termo de Uso por usuário/tipo/versão.
/// Prova legal da manifestação: versão aceita, data/hora, IP, user-agent e
/// hash SHA-256 do conteúdo exibido (não-repúdio mesmo que o texto mude depois).
/// O texto e a versão vigente vivem em src/modules/legal/termos.ts.
model AceiteTermo {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo         TipoTermo
  versao       String
  conteudoHash String
  ip           String?
  userAgent    String?
  aceitoEm     DateTime  @default(now())

  @@unique([userId, tipo, versao])
  @@index([userId, tipo])
  @@map("aceite_termo")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Pedido de reset de senha (admin reinicia pela tela de usuários).
model SolicitacaoResetSenha {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resolvida Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([resolvida])
  @@map("solicitacao_reset_senha")
}

// ─────────────────────────────────────────────────────────────
// Permissões finas (recurso:ação), configuráveis em runtime
// ─────────────────────────────────────────────────────────────

/// LEGADO — matriz por `role`. Continua sendo a fonte de autorização REAL até a Onda D.
/// Não é migrado in-place: fica congelado como leitura legada durante a coexistência e é
/// dropado na Onda F, quando `PermissaoPerfil` já tiver assumido o papel.
model Permissao {
  id        String  @id @default(cuid())
  role      Role
  recurso   String
  acao      String
  permitido Boolean @default(true)

  @@unique([role, recurso, acao])
  @@index([role])
  @@map("permissao")
}

/// Perfil de acesso nomeado e cadastrável — o "o que a pessoa pode fazer", independente de
/// Setor/Contratação (que não concedem permissão nenhuma). Plano: Onda A do documento em
/// docs/superpowers/plans/2026-07-27-setor-contratacao-perfil-acesso.md.
model PerfilAcesso {
  id        String  @id @default(cuid())
  /// Slug ESTÁVEL — nunca renomear depois de publicado (mesma regra de `ferramentas/registry.ts`):
  /// é a chave usada por código e por dado histórico (auditoria), não só de exibição.
  chave     String  @unique
  /// Rótulo pt-BR, esse sim editável livremente pela tela.
  nome      String
  descricao String?
  /// Perfis semente (Onda B) nascem `sistema: true` — não excluíveis, para sempre existir um
  /// destino de backfill determinístico. Perfis criados depois pela tela nascem `false`.
  sistema   Boolean @default(false)
  ativo     Boolean @default(true)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  permissoes PermissaoPerfil[]
  usuarios   User[]

  @@map("perfil_acesso")
}

/// Matriz do perfil: mesmo par recurso:ação de `Permissao`/`PERMISSOES_CATALOGO`, só que por
/// `perfilId` em vez de por `role`.
model PermissaoPerfil {
  id        String       @id @default(cuid())
  perfilId  String
  perfil    PerfilAcesso @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  recurso   String
  acao      String
  permitido Boolean      @default(true)

  @@unique([perfilId, recurso, acao])
  @@index([perfilId])
  @@map("permissao_perfil")
}

/// Override individual — 3 estados possíveis para um par (userId, recurso, acao): ausente (usa
/// o perfil), concede (`permitido: true`) ou revoga (`permitido: false`, vence mesmo se o
/// perfil concede). `motivo` é OBRIGATÓRIO: sem isso, em 12 meses ninguém sabe por que fulano
/// tem uma permissão a mais — o mesmo pântano que este motor veio resolver, só que distribuído
/// por usuário em vez de concentrado num enum. Não é cacheado (ver `lib/permissao-efetiva.ts`).
model PermissaoUsuario {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation("PermissaoUsuarioAlvo", fields: [userId], references: [id], onDelete: Cascade)
  recurso        String
  acao           String
  permitido      Boolean
  motivo         String
  /// Passada a data, o override para de valer — a permissão volta a ser só a do perfil.
  expiraEm       DateTime?
  concedidoPorId String?
  concedidoPor   User?     @relation("PermissaoUsuarioConcedidoPor", fields: [concedidoPorId], references: [id])

  criadoEm DateTime @default(now())

  @@unique([userId, recurso, acao])
  @@index([userId])
  @@index([concedidoPorId])
  @@map("permissao_usuario")
}

// ─────────────────────────────────────────────────────────────
// Auditoria (registro imutável de toda mutação)
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  modulo     String
  acao       String
  tipo       String   @default("acao") // acao | login | erro
  resultado  String   @default("sucesso") // sucesso | falha | bloqueado
  entidade   String?
  entidadeId String?
  detalhe    Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([modulo])
  @@index([createdAt])
  @@map("audit_log")
}

/// Registro de acesso (page-view) a uma seção, para a análise de uso (admin).
/// Dado interno de colaboradores; `userId` escalar (sem relação). Alimentado
/// pelo beacon de navegação do dashboard. Complementa o AuditLog (que mede ações).
model AcessoPagina {
  id        String   @id @default(cuid())
  userId    String
  secao     String
  path      String
  createdAt DateTime @default(now())

  @@index([secao, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("acesso_pagina")
}

// ─────────────────────────────────────────────────────────────
// Notificações (sininho interno) + Web Push
// ─────────────────────────────────────────────────────────────

model Notificacao {
  id        String   @id @default(cuid())
  userId    String
  titulo    String
  corpo     String?
  href      String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now())

  alertaLicitacaoEnviado AlertaLicitacaoEnviado?

  @@index([userId, lida])
